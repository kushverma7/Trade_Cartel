// ============================================================
// SKILL: Safe Array Patterns
// Extracted 2026-07-22 from two real bug fixes (BUG-001, which
// recurred in hima_reddy_gann_engine.pine and
// spaceman_yotov_quarters_engine.pine).
// Status: survived live use in 5+ engines. NOT a standalone
// indicator -- copy these patterns into an engine.
// ============================================================

// §1 — THE core trap (BUG-001): Pine's `for i = 0 to n` runs
// start-to-end INCLUSIVE. When the array is empty, size()-1 = -1,
// and the loop still executes once with i=0 -> index out of bounds.
// ALWAYS guard:
//
// if array.size(arr) > 0
//     for i = 0 to array.size(arr) - 1
//         v = array.get(arr, i)

// §2 — Reverse iteration when REMOVING during the loop (forward
// iteration skips elements after a removal):
//
// if array.size(arr) > 0
//     for i = array.size(arr) - 1 to 0
//         if shouldRemove(array.get(arr, i))
//             array.remove(arr, i)

// §3 — Bounded parallel arrays (levels + metadata kept in sync):
// push/shift ALL parallel arrays together, cap length together --
// desync between parallel arrays is a silent-corruption bug:
//
// array.push(lvls, x), array.push(flags, true), array.push(bars, bar_index)
// if array.size(lvls) > maxN
//     array.shift(lvls), array.shift(flags), array.shift(bars)

// §4 — Safe single access:
// int sz = array.size(arr)
// float v = sz > 0 and idx < sz ? array.get(arr, idx) : na
