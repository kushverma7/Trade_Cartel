//@version=6
// ============================================================================
// AU200 EMA 5/20 CROSS — long-only, rising-slow-MA gate, 3 x ATR stop
// ----------------------------------------------------------------------------
// VERSION      au200_ema_cross v1  (2026-08-05)
// INSTRUMENT   AUS200 CFD. Signals on the 15-MINUTE chart.
// TIMEZONE     Not timezone-dependent: there is NO session or hour filter.
//              This is deliberate — session filtering was tested and HURT
//              (09:50-10:30 dropped PF 1.282 -> 0.911).
// KEY VALUES   fast EMA 5, slow EMA 20, long only, slow EMA must be RISING,
//              stop = 3.0 x ATR(14), exit on the opposite cross.
//              No profit target. No time exit. No breakeven. No sub-point trail.
// CLOSED BAR   Every condition is evaluated on the CLOSED 15m bar
//              (process_orders_on_close=true, calc_on_every_tick=false).
//
// MEASURED, 2020-08-05 to 2026-08-04, exit path walked on 5-MINUTE bars,
// 1.0 pt/side slippage + 1.0 AUD/contract/side commission:
//   n 2,120 | WR 40.7% | PF 1.889 | net +11,564 pts | max DD 489 pts
//   7/7 years profitable | IS 1.761 -> OOS 1.988 (improves out of sample)
//   top 10 trades = 18.6% of net | buy & hold over the same span = +3,013 pts
//   survives 2.0 pt slippage (PF 1.469) and 3.0 pt (PF 1.167)
//
// KNOWN LIMITATIONS
//   1. One instrument, one feed, 6 years. No second-instrument transfer test.
//   2. The parameter plateau rises toward FASTER pairs (4/16 scored 1.998 at
//      the edge of the tested range). 5/20 sits inside a broad, smooth plateau
//      and was NOT chosen as the peak; the true optimum was not searched for.
//   3. Slippage is the binding constraint. Verify your broker's real AU200
//      spread before trading this.
// ============================================================================
strategy("AU200 EMA Cross", shorttitle="AU200-EMAX", overlay=true,
         default_qty_type=strategy.fixed, default_qty_value=1,
         commission_type=strategy.commission.cash_per_contract, commission_value=1,
         currency=currency.AUD, initial_capital=50000,
         process_orders_on_close=true, calc_on_every_tick=false,
         pyramiding=0)

g1 = "Moving averages"
int   fastLen = input.int(5,  "Fast EMA length", minval=2, group=g1)
int   slowLen = input.int(20, "Slow EMA length", minval=3, group=g1)
bool  reqRise = input.bool(true, "Require the slow EMA to be rising", group=g1,
     tooltip="Blocks longs while the slow EMA is flat or falling. Measured worth +0.20 PF.")

g2 = "Risk"
float stopAtr = input.float(3.0, "Initial stop (x ATR)", minval=0.5, step=0.5, group=g2)
int   atrLen  = input.int(14, "ATR length", minval=2, group=g2)
bool  longOnly= input.bool(true, "Long only", group=g2,
     tooltip="Both sides also works (PF 1.786, net +20,385) but with a larger drawdown.")

float fastMa = ta.ema(close, fastLen)
float slowMa = ta.ema(close, slowLen)
float atr    = ta.atr(atrLen)

// The slow-MA slope is read from the PREVIOUS bar's value, so the current bar
// can never both create and confirm its own slope.
bool rising  = slowMa > slowMa[1]
bool falling = slowMa < slowMa[1]

bool wantLong  = fastMa > slowMa and (not reqRise or rising)
bool wantShort = not longOnly and fastMa < slowMa and (not reqRise or falling)

if wantLong and strategy.position_size <= 0
    strategy.entry("L", strategy.long)
if wantShort and strategy.position_size >= 0
    strategy.entry("S", strategy.short)
// Flat when the state is neither: the rising gate turns off without an
// opposite cross, and sitting in a position through that is not the system.
if not wantLong and not wantShort and strategy.position_size != 0
    strategy.close_all(comment="state flat")

// Initial stop only. The opposite cross (above) is the primary exit; this is
// the disaster brake. No trailing stop is used -- a sub-point trail was the
// defect that made the earlier AU200-BASE result an artifact of bar resolution.
float stopDist = atr * stopAtr
if strategy.position_size > 0
    strategy.exit("L stop", "L", stop=strategy.position_avg_price - stopDist)
if strategy.position_size < 0
    strategy.exit("S stop", "S", stop=strategy.position_avg_price + stopDist)

plot(fastMa, "Fast EMA", color=color.new(color.aqua, 0), linewidth=1)
plot(slowMa, "Slow EMA", color=color.new(color.orange, 0), linewidth=2)
bgcolor(wantLong ? color.new(color.green, 92) : wantShort ? color.new(color.red, 92) : na)
