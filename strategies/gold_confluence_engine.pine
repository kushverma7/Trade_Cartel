// ============================================================
// GOLD CONFLUENCE ENGINE [Non-Repainting]
// XAU/USD 5m/15m — multi-layer confluence strategy
//
// LAYER 1  HTF KEY LEVELS (from SpacemanBTC logic, verified
//          non-repainting idiom: [1] + lookahead_on = confirmed
//          previous-period values; daily/weekly open fixed at
//          period start, never repaints)
//            - Daily open (gold's #1 intraday magnet)
//            - Previous day high/low
//            - Weekly open, previous week high/low
//
// LAYER 2  ROUND NUMBERS (Dave's Quarter Theory, gold-scaled:
//          $2.5 minor / $5 major / $10 grid — NOT the FX .25 grid)
//
// LAYER 3  SUPPLY/DEMAND ZONES (pivot-confirmed order blocks,
//          from BigBeluga/Victor POI concept, simplified so it
//          cannot repaint: zone exists only after pivot confirms)
//
// LAYER 4  TRIGGERS (selectable)
//          a) candidate OLS trendline breakout (untested at scale) core (lookback 22,
//             PF 3.656 backtested baseline)
//          b) LIQUIDITY SWEEP (from BigBeluga SFP concept):
//             wick pierces a key level (prev day/week H/L, Asia
//             range, major round) then closes back inside ->
//             stop-hunt reversal, gold's signature move
//
// EXTRA    Asia session range: London sweep of the Asia high/low
//          is one of gold's highest-probability daily setups
//
// ENTRY  = trigger + confluence score >= minScore
// STOP   = behind the support/resistance that justified entry
// TARGET = into the next opposing level (TP1 = 1R partial)
// R:R    veto — skip trades where the nearest wall is < minRR
// FLAT   optional close-all at NY window end (true intraday)
// ============================================================
//@version=6
strategy("Gold Confluence Engine [Non-Repainting]",
     overlay            = true,
     max_lines_count    = 500,
     max_boxes_count    = 100,
     initial_capital    = 1000,
     default_qty_type   = strategy.fixed,
     default_qty_value  = 2,
     commission_type    = strategy.commission.cash_per_contract,
     commission_value   = 0.07,
     slippage           = 5)

// ══ INPUTS ════════════════════════════════════════════════════
// Trigger
string trigMode   = input.string("Both (either)", "Trigger Mode",
     options=["Trendline Breakout", "Liquidity Sweep", "Both (either)"],          group="Trigger")
int   lookback    = input.int(22,    "Trendline Lookback",  minval=5, maxval=100, group="Trigger")
bool  useSession  = input.bool(true, "London + NY Open Only",                     group="Trigger")
int   atrLen      = input.int(14,    "ATR Length",                                group="Trigger")
bool  eodFlat     = input.bool(true, "Close All at NY Window End (11:00 ET)",     group="Trigger")
string asiaSess   = input.session("1800-0300", "Asia Range Session (ET)",         group="Trigger")

// Confluence
int   minScore    = input.int(2, "Min Confluence Score (of 4)", minval=0, maxval=4, group="Confluence")
float levelTolAtr = input.float(0.75, "Level Proximity (x ATR)", step=0.05,         group="Confluence")
bool  useHtfBias  = input.bool(true,  "Score: HTF Bias (daily+weekly open)",        group="Confluence")
bool  useLvlSup   = input.bool(true,  "Score: Entry From Support/Resistance",       group="Confluence")
bool  useRoundBrk = input.bool(true,  "Score: Round-Number Break/Bounce",           group="Confluence")
bool  useRoom     = input.bool(true,  "Score: Room To Next Wall",                   group="Confluence")

// Round numbers (gold-scaled)
float rnMinor = input.float(2.5,  "Minor Round ($)", step=0.5, group="Round Numbers")
float rnMajor = input.float(5.0,  "Major Round ($)", step=0.5, group="Round Numbers")
bool  showRn  = input.bool(false, "Show Round Levels",         group="Round Numbers")

// Supply / Demand zones
int   pivLen     = input.int(8,     "Zone Pivot Length", minval=3, maxval=25, group="Supply/Demand")
float zoneAtr    = input.float(0.5, "Zone Depth (x ATR)", step=0.1,           group="Supply/Demand")
int   maxZones   = input.int(6,     "Max Zones Per Side", minval=2, maxval=15, group="Supply/Demand")
bool  showZones  = input.bool(true, "Show Zones",                              group="Supply/Demand")

// Exits
float minRR       = input.float(1.0, "Min R:R To Nearest Wall (veto)", step=0.1, group="Exits")
float stopBufAtr  = input.float(0.25,"Stop Buffer Behind Level (x ATR)", step=0.05, group="Exits")
float maxStopAtr  = input.float(1.8, "Max Stop Distance (x ATR cap)",  step=0.1, group="Exits")
float fallbackTp  = input.float(2.0, "Fallback TP (x ATR)",            step=0.1, group="Exits")
bool  useSplitTp  = input.bool(true, "Split Exit: 50% at 1R, rest at level",     group="Exits")

// Display
bool showLevels  = input.bool(true, "Show HTF Levels",   group="Display")
bool showScore   = input.bool(true, "Show Score Table",  group="Display")
bool showSignals = input.bool(true, "Show Signals",      group="Display")

// ══ BASICS ════════════════════════════════════════════════════
float atrVal   = ta.atr(atrLen)
bool  inSession = not useSession or not na(time(timeframe.period, "0300-0500,0830-1100", "America/New_York"))
float lvlTol   = atrVal * levelTolAtr

// Asia range (completed range only — no repaint: values used for
// signals only once the Asia session has ended)
bool inAsia = not na(time(timeframe.period, asiaSess, "America/New_York"))
var float asiaHi = na
var float asiaLo = na
if inAsia and not inAsia[1]
    asiaHi := high
    asiaLo := low
else if inAsia
    asiaHi := math.max(asiaHi, high)
    asiaLo := math.min(asiaLo, low)
bool asiaDone = not inAsia and not na(asiaHi)

// ══ LAYER 1: HTF KEY LEVELS (non-repainting) ══════════════════
// Current-period OPEN is fixed at period start -> safe with lookahead_on.
// PREVIOUS-period H/L via [1] + lookahead_on -> confirmed, never changes.
float dayOpen     = request.security(syminfo.tickerid, "D", open,    lookahead=barmerge.lookahead_on)
float prevDayHigh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
float prevDayLow  = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_on)
float weekOpen    = request.security(syminfo.tickerid, "W", open,    lookahead=barmerge.lookahead_on)
float prevWkHigh  = request.security(syminfo.tickerid, "W", high[1], lookahead=barmerge.lookahead_on)
float prevWkLow   = request.security(syminfo.tickerid, "W", low[1],  lookahead=barmerge.lookahead_on)

// ══ LAYER 2: ROUND NUMBERS (gold grid) ════════════════════════
float rnBelow      = math.floor(close / rnMinor) * rnMinor
float rnAbove      = math.ceil(close  / rnMinor) * rnMinor
float rnMajorBelow = math.floor(close / rnMajor) * rnMajor
float rnMajorAbove = math.ceil(close  / rnMajor) * rnMajor

// ══ LAYER 3: SUPPLY / DEMAND ZONES (pivot-confirmed) ══════════
// A zone is born only AFTER the pivot confirms (pivLen bars later),
// so it never repaints. Zone dies when price closes through it.
float ph = ta.pivothigh(high, pivLen, pivLen)
float pl = ta.pivotlow(low,  pivLen, pivLen)

var array<float> supTop = array.new_float()
var array<float> supBtm = array.new_float()
var array<float> demTop = array.new_float()
var array<float> demBtm = array.new_float()
var array<box>   supBox = array.new<box>()
var array<box>   demBox = array.new<box>()

// birth
if not na(ph)
    array.unshift(supTop, ph)
    array.unshift(supBtm, ph - atrVal * zoneAtr)
    if showZones
        array.unshift(supBox, box.new(bar_index - pivLen, ph, bar_index, ph - atrVal * zoneAtr,
             border_color=na, bgcolor=color.new(color.red, 82), extend=extend.right))
    if array.size(supTop) > maxZones
        array.pop(supTop)
        array.pop(supBtm)
        if showZones and array.size(supBox) > maxZones
            box.delete(array.pop(supBox))
if not na(pl)
    array.unshift(demBtm, pl)
    array.unshift(demTop, pl + atrVal * zoneAtr)
    if showZones
        array.unshift(demBox, box.new(bar_index - pivLen, pl + atrVal * zoneAtr, bar_index, pl,
             border_color=na, bgcolor=color.new(color.green, 82), extend=extend.right))
    if array.size(demBtm) > maxZones
        array.pop(demBtm)
        array.pop(demTop)
        if showZones and array.size(demBox) > maxZones
            box.delete(array.pop(demBox))

// death (invalidation on close-through)
if array.size(supTop) > 0
    for i = array.size(supTop) - 1 to 0
        if close > array.get(supTop, i)
            array.remove(supTop, i)
            array.remove(supBtm, i)
            if showZones and array.size(supBox) > i
                box.delete(array.get(supBox, i))
                array.remove(supBox, i)
if array.size(demBtm) > 0
    for i = array.size(demBtm) - 1 to 0
        if close < array.get(demBtm, i)
            array.remove(demBtm, i)
            array.remove(demTop, i)
            if showZones and array.size(demBox) > i
                box.delete(array.get(demBox, i))
                array.remove(demBox, i)

// nearest active zone edges relative to price
float nearestDemandTop = na
if array.size(demTop) > 0
    for i = 0 to array.size(demTop) - 1
        float t = array.get(demTop, i)
        if t < close and (na(nearestDemandTop) or t > nearestDemandTop)
            nearestDemandTop := t
float nearestSupplyBtm = na
if array.size(supBtm) > 0
    for i = 0 to array.size(supBtm) - 1
        float b = array.get(supBtm, i)
        if b > close and (na(nearestSupplyBtm) or b < nearestSupplyBtm)
            nearestSupplyBtm := b

// ══ SUPPORT / RESISTANCE CLUSTERS (all layers combined) ═══════
// nearest support below close among: demand zone, prev day low,
// prev week low, minor round level
f_below(float cand, float best) =>
    not na(cand) and cand < close and (na(best) or cand > best) ? cand : best
f_above(float cand, float best) =>
    not na(cand) and cand > close and (na(best) or cand < best) ? cand : best

float supportLvl = na
supportLvl := f_below(nearestDemandTop, supportLvl)
supportLvl := f_below(prevDayLow,  supportLvl)
supportLvl := f_below(prevWkLow,   supportLvl)
supportLvl := f_below(rnMajorBelow, supportLvl)
supportLvl := f_below(asiaDone ? asiaLo : na, supportLvl)

float resistLvl = na
resistLvl := f_above(nearestSupplyBtm, resistLvl)
resistLvl := f_above(prevDayHigh, resistLvl)
resistLvl := f_above(prevWkHigh,  resistLvl)
resistLvl := f_above(rnMajorAbove, resistLvl)
resistLvl := f_above(asiaDone ? asiaHi : na, resistLvl)

// ══ LAYER 4: TRIGGER — candidate OLS trendline breakout (untested at scale) ═════════
linreg_coefs(src, len) =>
    float sumX  = 0.0
    float sumY  = 0.0
    float sumXY = 0.0
    float sumX2 = 0.0
    for j = 0 to len - 1
        float x = j
        float y = src[len - 1 - j]
        sumX  += x
        sumY  += y
        sumXY += x * y
        sumX2 += x * x
    float n = len
    float denom = n * sumX2 - sumX * sumX
    float slope = denom != 0 ? (n * sumXY - sumX * sumY) / denom : 0.0
    float intercept = denom != 0 ? (sumY - slope * sumX) / n : src[math.floor(len / 2)]
    [slope, intercept]

find_pivot(src, len, slope, intercept, direction) =>
    int best_j = 0
    float best_val = -1e10
    for j = 0 to len - 1
        float diff = (src[len - 1 - j] - (slope * j + intercept)) * direction
        if diff > best_val
            best_val := diff
            best_j := j
    best_j

project_line(src, len, pivot_j, slope) =>
    float pivot_y = src[len - 1 - pivot_j]
    slope * len + (pivot_y - slope * pivot_j)

optimize_slope(src, len, pivot_j, init_slope, is_support) =>
    float pivot_y = src[len - 1 - pivot_j]
    float best = init_slope
    float step = math.abs(init_slope) * 0.5 + 1e-6
    for _i = 0 to 29
        float s_up = best + step
        float s_dn = best - step
        bool ok_up = true
        bool ok_dn = true
        float err_up = 0.0
        float err_dn = 0.0
        for j = 0 to len - 1
            float d_up = (s_up * j + (pivot_y - s_up * pivot_j)) - src[len - 1 - j]
            float d_dn = (s_dn * j + (pivot_y - s_dn * pivot_j)) - src[len - 1 - j]
            if is_support
                if d_up > 1e-5
                    ok_up := false
                if d_dn > 1e-5
                    ok_dn := false
            else
                if d_up < -1e-5
                    ok_up := false
                if d_dn < -1e-5
                    ok_dn := false
            err_up += d_up * d_up
            err_dn += d_dn * d_dn
        if ok_up and ok_dn
            best := err_up < err_dn ? s_up : s_dn
        else if ok_up
            best := s_up
        else if ok_dn
            best := s_dn
        step *= 0.5
    best

var float s_val = na
var float r_val = na
var int   sig   = 0
if bar_index >= lookback + 1
    [ols_slope, ols_intercept] = linreg_coefs(close[1], lookback)
    int upper_j = find_pivot(high[1], lookback, ols_slope, ols_intercept,  1)
    int lower_j = find_pivot(low[1],  lookback, ols_slope, ols_intercept, -1)
    r_val := project_line(high[1], lookback, upper_j, optimize_slope(high[1], lookback, upper_j, ols_slope, false))
    s_val := project_line(low[1],  lookback, lower_j, optimize_slope(low[1],  lookback, lower_j, ols_slope, true))
    if close > r_val
        sig := 1
    else if close < s_val
        sig := -1

bool tlUp = sig ==  1 and sig[1] !=  1
bool tlDn = sig == -1 and sig[1] != -1

// ── Trigger b: LIQUIDITY SWEEP (SFP) ──────────────────────────
// Wick takes out a resting-liquidity level, body closes back on
// the right side -> stop hunt. Evaluated on closed bars only.
sweepUp(float lvl) =>
    not na(lvl) and low < lvl and close > lvl and close > open

sweepDn(float lvl) =>
    not na(lvl) and high > lvl and close < lvl and close < open

bool swUp = sweepUp(prevDayLow) or sweepUp(prevWkLow) or sweepUp(rnMajorBelow > low ? rnMajorBelow : na) or
     (asiaDone ? sweepUp(asiaLo) : false)
bool swDn = sweepDn(prevDayHigh) or sweepDn(prevWkHigh) or sweepDn(rnMajorAbove < high ? rnMajorAbove : na) or
     (asiaDone ? sweepDn(asiaHi) : false)

// ── Combined trigger ──────────────────────────────────────────
bool trigUp = trigMode == "Trendline Breakout" ? tlUp :
     trigMode == "Liquidity Sweep" ? swUp : (tlUp or swUp)
bool trigDn = trigMode == "Trendline Breakout" ? tlDn :
     trigMode == "Liquidity Sweep" ? swDn : (tlDn or swDn)

// ══ CONFLUENCE SCORING ════════════════════════════════════════
// [1] HTF bias — gold respects daily & weekly opens
bool htfBiasUp = close > dayOpen and close > weekOpen
bool htfBiasDn = close < dayOpen and close < weekOpen

// [2] Launching from a level — support (long) / resistance (short)
//     within tolerance below/above entry price
bool fromSupport = not na(supportLvl) and (close - supportLvl) < lvlTol and (close - supportLvl) > 0
bool fromResist  = not na(resistLvl)  and (resistLvl - close) < lvlTol and (resistLvl - close) > 0

// [3] Round-number interaction — breakout candle cleared a minor
//     round level (quarter theory rule: break with momentum), or
//     bounced off one
bool rnBreakUp = close > rnBelow and close[1] <= rnBelow
bool rnBounceUp = low  <= rnBelow + lvlTol * 0.3 and close > rnBelow
bool rnBreakDn = close < rnAbove and close[1] >= rnAbove
bool rnBounceDn = high >= rnAbove - lvlTol * 0.3 and close < rnAbove

// [4] Room to run — nearest opposing wall far enough for R:R
//     (risk approximated with ATR at signal time; final check uses
//     the true stop below)
bool roomUp = na(resistLvl)  or (resistLvl - close) >= atrVal * minRR
bool roomDn = na(supportLvl) or (close - supportLvl) >= atrVal * minRR

int scoreLong  = (useHtfBias and htfBiasUp ? 1 : 0) + (useLvlSup and fromSupport ? 1 : 0) +
                 (useRoundBrk and (rnBreakUp or rnBounceUp) ? 1 : 0) + (useRoom and roomUp ? 1 : 0)
int scoreShort = (useHtfBias and htfBiasDn ? 1 : 0) + (useLvlSup and fromResist ? 1 : 0) +
                 (useRoundBrk and (rnBreakDn or rnBounceDn) ? 1 : 0) + (useRoom and roomDn ? 1 : 0)

bool buy  = trigUp and inSession and scoreLong  >= minScore
bool sell = trigDn and inSession and scoreShort >= minScore

// ══ LEVEL-AWARE EXITS ═════════════════════════════════════════
// Stop: behind the justifying level (with buffer), capped so one
// bad level can't blow risk out. Target: into the opposing wall.
float longStopLvl  = not na(supportLvl) ? supportLvl - atrVal * stopBufAtr : close - atrVal * 1.2
longStopLvl := math.max(longStopLvl, close - atrVal * maxStopAtr)   // risk cap
float longRisk = close - longStopLvl
float longTgt  = not na(resistLvl) and (resistLvl - close) >= longRisk * minRR ?
     resistLvl - atrVal * 0.1 : close + atrVal * fallbackTp
float longTp1  = close + longRisk                                    // 1R partial

float shortStopLvl = not na(resistLvl) ? resistLvl + atrVal * stopBufAtr : close + atrVal * 1.2
shortStopLvl := math.min(shortStopLvl, close + atrVal * maxStopAtr)
float shortRisk = shortStopLvl - close
float shortTgt  = not na(supportLvl) and (close - supportLvl) >= shortRisk * minRR ?
     supportLvl + atrVal * 0.1 : close - atrVal * fallbackTp
float shortTp1  = close - shortRisk

// final R:R veto — the true stop must clear minRR to the target
bool longRrOk  = (longTgt  - close) / math.max(longRisk,  syminfo.mintick) >= minRR
bool shortRrOk = (close - shortTgt) / math.max(shortRisk, syminfo.mintick) >= minRR

if buy and longRrOk and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    if useSplitTp
        strategy.exit("L-TP1", "Long", stop=longStopLvl, limit=longTp1, qty_percent=50)
        strategy.exit("L-TP2", "Long", stop=longStopLvl, limit=longTgt)
    else
        strategy.exit("L-X",   "Long", stop=longStopLvl, limit=longTgt)

if sell and shortRrOk and strategy.position_size == 0
    strategy.entry("Short", strategy.short)
    if useSplitTp
        strategy.exit("S-TP1", "Short", stop=shortStopLvl, limit=shortTp1, qty_percent=50)
        strategy.exit("S-TP2", "Short", stop=shortStopLvl, limit=shortTgt)
    else
        strategy.exit("S-X",   "Short", stop=shortStopLvl, limit=shortTgt)

// intraday hygiene: flat at NY window end, never hold overnight
bool tradeWindow = not na(time(timeframe.period, "0300-1100", "America/New_York"))
if eodFlat and not tradeWindow and tradeWindow[1]
    strategy.close_all(comment="Session end")

// ══ VISUALS ═══════════════════════════════════════════════════
plot(showLevels ? dayOpen     : na, "Daily Open",     color=color.new(color.yellow, 20), style=plot.style_linebr, linewidth=2)
plot(showLevels ? prevDayHigh : na, "Prev Day High",  color=color.new(color.red,    40), style=plot.style_linebr)
plot(showLevels ? prevDayLow  : na, "Prev Day Low",   color=color.new(color.lime,   40), style=plot.style_linebr)
plot(showLevels ? weekOpen    : na, "Weekly Open",    color=color.new(color.orange, 30), style=plot.style_linebr, linewidth=2)
plot(showLevels ? prevWkHigh  : na, "Prev Week High", color=color.new(color.maroon, 40), style=plot.style_linebr)
plot(showLevels ? prevWkLow   : na, "Prev Week Low",  color=color.new(color.teal,   40), style=plot.style_linebr)
plot(showRn ? rnMajorBelow : na, "Round Below", color=color.new(color.gray, 60), style=plot.style_circles)
plot(showRn ? rnMajorAbove : na, "Round Above", color=color.new(color.gray, 60), style=plot.style_circles)
plot(r_val, "Trendline R", color=color.new(color.red,  50))
plot(s_val, "Trendline S", color=color.new(color.lime, 50))

plotshape(showSignals and buy,  title="BUY",  style=shape.triangleup,   location=location.belowbar, color=color.aqua,   size=size.small, text="BUY")
plotshape(showSignals and sell, title="SELL", style=shape.triangledown, location=location.abovebar, color=color.yellow, size=size.small, text="SELL")
plotshape(showSignals and swUp and not buy,  title="Sweep Up (no entry)",   style=shape.diamond, location=location.belowbar, color=color.new(color.aqua,   60), size=size.tiny)
plotshape(showSignals and swDn and not sell, title="Sweep Down (no entry)", style=shape.diamond, location=location.abovebar, color=color.new(color.yellow, 60), size=size.tiny)

// score table — live confluence check (discretionary aid)
var table tb = na
if showScore and barstate.islast
    if na(tb)
        tb := table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 30), border_width=1, border_color=color.new(color.gray, 60))
    table.cell(tb, 0, 0, "CONFLUENCE",       text_color=color.white,  text_size=size.small)
    table.cell(tb, 1, 0, "L / S",            text_color=color.white,  text_size=size.small)
    table.cell(tb, 0, 1, "HTF bias",         text_color=color.silver, text_size=size.tiny)
    table.cell(tb, 1, 1, (htfBiasUp ? "✓" : "·") + " / " + (htfBiasDn ? "✓" : "·"), text_color=color.yellow, text_size=size.tiny)
    table.cell(tb, 0, 2, "From level",       text_color=color.silver, text_size=size.tiny)
    table.cell(tb, 1, 2, (fromSupport ? "✓" : "·") + " / " + (fromResist ? "✓" : "·"), text_color=color.yellow, text_size=size.tiny)
    table.cell(tb, 0, 3, "Round number",     text_color=color.silver, text_size=size.tiny)
    table.cell(tb, 1, 3, ((rnBreakUp or rnBounceUp) ? "✓" : "·") + " / " + ((rnBreakDn or rnBounceDn) ? "✓" : "·"), text_color=color.yellow, text_size=size.tiny)
    table.cell(tb, 0, 4, "Room to wall",     text_color=color.silver, text_size=size.tiny)
    table.cell(tb, 1, 4, (roomUp ? "✓" : "·") + " / " + (roomDn ? "✓" : "·"), text_color=color.yellow, text_size=size.tiny)
    table.cell(tb, 0, 5, "SCORE",            text_color=color.white,  text_size=size.small)
    table.cell(tb, 1, 5, str.tostring(scoreLong) + " / " + str.tostring(scoreShort), text_color=color.aqua, text_size=size.small)

alertcondition(buy,  title="BUY Signal",  message="Gold Confluence Engine — BUY XAUUSD")
alertcondition(sell, title="SELL Signal", message="Gold Confluence Engine — SELL XAUUSD")
