//@version=6
// AU200 Base Strategy - trailing-stop version, units corrected.
// BUG-036: trail_points / trail_offset are ALWAYS in TICKS. Divide points by
//          syminfo.mintick. trail_points = ACTIVATION, trail_offset = DISTANCE.
// BUG-037: hour() and minute() must BOTH take "Australia/Sydney".
strategy("AU200 Base Strategy - Fixed", shorttitle = "AU200-BASE-FIXED", overlay = true,
         default_qty_type = strategy.fixed, default_qty_value = 1,
         commission_type = strategy.commission.cash_per_contract, commission_value = 1,
         currency = currency.AUD, initial_capital = 50000,
         process_orders_on_close = true, calc_on_every_tick = false,
         pyramiding = 0)

grp1 = "Entry Window (Melbourne time)"
use_950  = input.bool(true, "9:50 AM",  group = grp1)
use_955  = input.bool(true, "9:55 AM",  group = grp1)
use_1000 = input.bool(true, "10:00 AM", group = grp1)

grp2 = "Exit Levels (POINTS)"
sl_pts    = input.float(15.0, "Hard SL (pts)",              minval = 1,   group = grp2)
trail_pts = input.float(30.0, "Trail distance (pts)",       minval = 1,   group = grp2)
trail_act = input.float(5.0,  "Trail activates after (pts)", minval = 0.5, group = grp2)

grp3 = "Signal Filters"
use_ema   = input.bool(true, "EMA 200",    group = grp3)
use_rsi   = input.bool(true, "RSI 14",     group = grp3)
use_st    = input.bool(true, "SuperTrend", group = grp3)
st_factor = input.float(3.1, "ST Factor",     minval = 1.0, step = 0.1, group = grp3)
st_period = input.int(97,    "ST ATR Period", minval = 5,              group = grp3)

ema200 = ta.ema(close, 200)
rsi14  = ta.rsi(close, 14)
[st_val, st_dir] = ta.supertrend(st_factor, st_period)
st_bull = st_dir < 0
st_bear = st_dir > 0

ema_ok_long  = not use_ema or close > ema200
ema_ok_short = not use_ema or close < ema200
rsi_ok_long  = not use_rsi or rsi14 > 50
rsi_ok_short = not use_rsi or rsi14 < 50
st_ok_long   = not use_st  or st_bull
st_ok_short  = not use_st  or st_bear

bull_signal = ema_ok_long  and rsi_ok_long  and st_ok_long
bear_signal = ema_ok_short and rsi_ok_short and st_ok_short

// both from the SAME named zone
bar_hour = hour(time,   "Australia/Sydney")
bar_min  = minute(time, "Australia/Sydney")

is_950  = bar_hour == 9  and bar_min == 50
is_955  = bar_hour == 9  and bar_min == 55
is_1000 = bar_hour == 10 and bar_min == 0
in_window = (use_950 and is_950) or (use_955 and is_955) or (use_1000 and is_1000)

// POINTS -> TICKS
act_ticks  = trail_act / syminfo.mintick   // activation profit
dist_ticks = trail_pts / syminfo.mintick   // trailing distance

long_entry  = in_window and bull_signal and strategy.position_size == 0
short_entry = in_window and bear_signal and strategy.position_size == 0

if long_entry
    strategy.entry("Long", strategy.long, comment = "BUY")
    strategy.exit("Long Exit", "Long",
         stop         = close - sl_pts,
         trail_points = act_ticks,
         trail_offset = dist_ticks)

if short_entry
    strategy.entry("Short", strategy.short, comment = "SELL")
    strategy.exit("Short Exit", "Short",
         stop         = close + sl_pts,
         trail_points = act_ticks,
         trail_offset = dist_ticks)

plot(ema200, "EMA 200", color = color.new(color.orange, 50), linewidth = 1)
plotshape(long_entry,  title = "Long",  style = shape.triangleup,
     location = location.belowbar, color = #00FFBB, size = size.small, text = "B")
plotshape(short_entry, title = "Short", style = shape.triangledown,
     location = location.abovebar, color = #FF3D57, size = size.small, text = "S")
bgcolor(in_window ? color.new(color.yellow, 90) : na)
