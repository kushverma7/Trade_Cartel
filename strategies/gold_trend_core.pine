// ════════════════════════════════════════════════════════════════════
// GOLD TREND — TRAILING STOP SYSTEM
// ════════════════════════════════════════════════════════════════════
// Built 2026-07-31 from the first properly validated research this repo
// has produced: 157,366 bars of XAUUSD 15m (Dec 2019 - Jul 2026), split
// 60/40, parameters chosen on the training half ONLY and the held-out
// block evaluated once.
//
// OUT-OF-SAMPLE RESULT (2023-11-28 -> 2026-07-30, entry 50 / trail 8.0)
//     275 trades | WR 41.45% | PF 1.588 | +60.9% | max DD 5.5%
//     buy & hold over the same window: +100.4%, max DD 29.2%
//     return/drawdown: 11.07 vs 3.44  <- this is the actual edge
//
// ── READ THIS BEFORE YOU TRADE IT ───────────────────────────────────
// THE ENTRY IS NOT AN EDGE. Random long entries pushed through this
// exact trailing exit scored a median PF of 1.621 on the same data;
// the Donchian breakout scored 1.588. The entry contributed -0.033.
// What makes money here is the WIDE TRAILING STOP holding a long
// position through a market that rose 179%, plus the stop capping the
// damage when it does not.
//
// So this is risk management on long gold exposure, not prediction. It
// is stated plainly because four months of this project was spent
// tuning entry logic that measurement says contributes nothing.
//
// WHY EVERY EARLIER ENGINE HERE LOST: they used fixed 1R/2R targets and
// 36-bar time stops. That caps winners at twice the stop while losers
// run to it, in a market whose entire return came from a handful of
// multi-month moves. Tested over the same 6.7 years that family scored
// PF 0.86 -- and PF 0.912 on the LONG side of a market that tripled.
// Stop width is the dominant variable, monotonically:
//     trail 2 ATR -> PF 1.05     trail 8 ATR -> PF 1.59
//     trail 4 ATR -> PF 1.40     trail 14 ATR -> PF 1.75
// and drawdown FALLS as the stop widens, because wide stops stop
// getting whipsawed.
//
//@version=6
strategy("Gold Trend — Trailing Stop",
     overlay                 = true,
     max_lines_count         = 500,
     max_labels_count        = 500,
     initial_capital         = 10000,
     currency                = currency.USD,
     default_qty_type        = strategy.cash,
     default_qty_value       = 1000,
     commission_type         = strategy.commission.cash_per_contract,
     commission_value        = 0.07,
     slippage                = 5,
     process_orders_on_close = true,
     margin_long             = 5,
     margin_short            = 5,
     calc_on_every_tick      = false,
     // EMA 2000 plus a 200-bar slope lookback means this script reaches
     // ~2,200 bars back. Pine's default historical buffer is 300, which
     // throws "requested historical offset beyond the buffer" or silently
     // yields na. This is the single most likely cause of a Pine result
     // not matching the research.
     max_bars_back           = 5000)

// ── ⓪ Auto-scale ────────────────────────────────────────────────
// Every lookback below is in BARS, so changing timeframe silently doubles
// or halves it in real time. That has now caused two failed reproductions,
// so the script derives its own settings from the chart instead. The
// formulas were checked against the two hand-tuned columns and land on
// them almost exactly:
//    15m -> entry 48, SMA 768, EMA 2016, slope 192, trail 6.00, grid 2.50
//    30m -> entry 24, SMA 384, EMA 1008, slope  96, trail 4.24, grid 3.54
//    (hand-tuned were 50/750/2000/200/6.0/2.50 and 25/375/1000/100/4.0/3.75)
// Turn it off only to reproduce a specific historical run.
bool  autoScale = input.bool(true, "Auto-scale all settings to the chart timeframe", group="⓪ Auto-scale",
     tooltip="ON is strongly recommended. With it on, the inputs below are IGNORED and derived from the timeframe, so moving between 15m and 30m cannot silently change the strategy. The dashboard shows the values actually in use.")

// ── ① Core (these three are the whole system) ────────────────────
int   entryLen  = input.int(50, "Breakout lookback (bars)", minval=5, group="① Core",
     tooltip="Long when close exceeds the highest high of the prior N bars. Validated at 50 and 100; both work. This is a timing trigger, not an edge.")
float trailMult = input.float(6.0, "Trailing stop (x ATR)", minval=1.0, step=0.5, group="① Core",
     tooltip="THE key parameter. Validated: 4.0 -> PF 1.40, 6.0 -> 1.60, 8.0 -> 1.59, 14.0 -> 1.75 out of sample. Below 4 the system loses. Wider = fewer trades, higher PF, but a less reliable estimate.")
bool  longOnly  = input.bool(false, "Long only (leave OFF — both directions is the shipped config)", group="① Core",
     tooltip="THIS IS A REGIME BET, NOT A SETTING. Long-only wins every rising year and loses in falling ones. Long+short is the reverse. See the year table in the header. Gold is down over the last six months, so shorts ON is currently the better side. Reassess if that changes.")
int   atrLen    = input.int(14, "ATR length", minval=2, group="① Core")

// ── ② Risk ───────────────────────────────────────────────────────
float riskPct   = input.float(1.0, "Risk per trade (%)", step=0.25, group="② Risk")
float maxLev    = input.float(20, "Max leverage (notional cap)", minval=1, group="② Risk",
     tooltip="BUG-012 guard. Without a notional cap, risk-based sizing silently requests more than buying power and TradingView skips the order with no error.")
bool  useSma    = input.bool(true, "Trend filter: only long above the SMA, short below", group="② Risk",
     tooltip="Improves every window measured, but does NOT pass a significance test - see the header. Harmless to run, unwise to believe in.")
int   smaLen    = input.int(750, "Trend SMA length (bars)", minval=50, group="② Risk",
     tooltip="750 bars on 15m is about 8 days. Selected on the TRAINING half only. 2000 (~3 weeks) looks better on recent data but WORSE on the training half - that is a regime artifact, not a better setting.")
bool  smaExit   = input.bool(false, "Also exit when price crosses back through the SMA", group="② Risk",
     tooltip="Tested and rejected: it cuts winners early. Train PF 1.030 vs 1.048 with the gate alone.")
bool  useSlope  = input.bool(true, "Shorts only when the EMA is FALLING (not merely below it)", group="② Risk",
     tooltip="This is what makes the system profitable in a falling market without giving up the trend returns. Price sits below a FLAT EMA constantly during uptrend pullbacks; the EMA actually declining is a much rarer state and is what a bear regime looks like. Gating shorts on slope keeps them nearly silent in bull markets, where counter-trend shorts are what bleed away the long-only edge.")
int   slopeLen  = input.int(200, "Slope lookback (bars)", minval=20, group="② Risk",
     tooltip="EMA must be below its own value this many bars ago. 200 bars = ~2 days on 15m. Tested 50/100/200/300; 200 gave the best full-period return.")
float shortRisk = input.float(0.75, "Short risk multiplier", minval=0.1, maxval=3.0, step=0.05, group="② Risk",
     tooltip="Counter-trend trades sized smaller. 0.75 gave the best full-period result (+160.1%); raise toward 1.5 for more downside protection at the cost of total return (+145.9% but +10.5% in the falling window).")
bool  useRegime = input.bool(true, "EMA gate: only long above it, short below", group="② Risk",
     tooltip="EMA 2000 (~3 weeks on 15m). Combined with the SMA750 filter it lifts full-period PF to 1.202 and cuts drawdown.")
int   regimeLen = input.int(2000, "Regime EMA length", minval=20, group="② Risk")

// ── ④ JEAFX key-level profit taking (PRICE grid) ────────────────
bool  useKL     = input.bool(true, "Bank profit at quarter-round key levels", group="④ Key-Level Profit Taking",
     tooltip="JEAFX: plot only .00/.25/.50/.75 and treat them as reversal areas. Best single improvement measured: full-period net +87.0% -> +110.6%, drawdown 23.2% -> 19.0%.")
float klGrid    = input.float(2.50, "Key-level grid (points)", minval=0.25, step=0.25, group="④ Key-Level Profit Taking",
     tooltip="JEAFX quarters of gold's 10-unit handles: 4000.00 / 4002.50 / 4005.00 / 4007.50. Median ATR(14) here is 2.58, so the grid sits at ~1x ATR - the same ratio as the source's EURUSD example. 2.50-10.00 all work; 25+ degrades.")
float klTol     = input.float(0.25, "Reached-level tolerance (points)", minval=0.05, step=0.05, group="④ Key-Level Profit Taking",
     tooltip="A level counts as reached within this distance, mirroring the source's own completion tolerance.")
float klTake    = input.float(50, "% banked at the level", minval=10, maxval=100, step=5, group="④ Key-Level Profit Taking")
bool  klShorts  = input.bool(true, "SHORTS ONLY — let longs run (this is what makes it work)", group="④ Key-Level Profit Taking",
     tooltip="CRITICAL. Banking BOTH sides on this same grid drops full-period net from +87% to +29-41%. Banking only the counter-trend side lifts it to +110.6%. A take removes exactly the size that captures a large move, so only take it where there is no large move to catch.")

// ── ⑤ Daye Q4 time-based take (alternative, OFF by default) ─────
bool  useQ4     = input.bool(false, "Bank in Daye's Q4 instead (time-based)", group="⑤ Daye Q4 (alternative)",
     tooltip="Daye's daily quarters in ET: Q1 Asia 18-00 range build, Q2 London 00-06 expansion, Q3 NY AM 06-12 continuation, Q4 NY PM 12-18 REVERSAL / PROFIT-TAKING. Q4 is where the source says to bank.")
float q4Take    = input.float(50, "% banked at the Q4 open", minval=10, maxval=100, step=5, group="⑤ Daye Q4 (alternative)")
bool  q4Shorts  = input.bool(true, "SHORTS ONLY", group="⑤ Daye Q4 (alternative)",
     tooltip="CRITICAL. Banking symmetrically DESTROYS the system: taking 50% off both sides drops full-period net from +61.5% to +21.4%. Banking only the counter-trend side improves every window tested. A take removes exactly the size that captures the big move -- so only take it where there is no big move to catch.")
int   q4StartUtc= input.int(17, "Q4 start hour (UTC)", minval=0, maxval=23, group="⑤ Daye Q4 (alternative)",
     tooltip="12:00 ET = 17:00 UTC. Adjust for DST if you want to be exact.")

// ── ③ Display ────────────────────────────────────────────────────
bool  showStop  = input.bool(true, "Plot the trailing stop", group="③ Display")
bool  showBand  = input.bool(true, "Plot the breakout level", group="③ Display")
bool  showDash  = input.bool(true, "Show dashboard", group="③ Display")

// ═════════════════════════════════════════════════════════════
// EFFECTIVE SETTINGS — derived from the timeframe when auto-scale is on.
// Targets: breakout ~12h, SMA ~8 days, EMA ~21 days, slope ~2 days.
// Trail and grid scale with the square root of the timeframe because ATR
// grows roughly as sqrt(time).
// ═════════════════════════════════════════════════════════════
float tfMin      = timeframe.in_seconds() / 60.0
int   entryLenE  = autoScale ? math.max(5,  int(12.0 * 60.0 / tfMin))       : entryLen
int   smaLenE    = autoScale ? math.max(50, int(8.0 * 24.0 * 60.0 / tfMin)) : smaLen
int   regimeLenE = autoScale ? math.max(20, int(21.0 * 24.0 * 60.0 / tfMin)): regimeLen
int   slopeLenE  = autoScale ? math.max(20, int(2.0 * 24.0 * 60.0 / tfMin)) : slopeLen
float trailMultE = autoScale ? 6.0 * math.sqrt(15.0 / tfMin)               : trailMult
float klGridE    = autoScale ? 2.50 * math.sqrt(tfMin / 15.0)              : klGrid
float klTolE     = autoScale ? klGridE * 0.10                              : klTol

// ═════════════════════════════════════════════════════════════
// SIGNALS — all ta.* unconditional at top level (BUG-004)
// ═════════════════════════════════════════════════════════════
float atr      = ta.atr(atrLen)
float donHi    = ta.highest(high, entryLenE)[1]
float donLo    = ta.lowest(low, entryLenE)[1]
float regimeMa = ta.ema(close, regimeLenE)
float trendSma = ta.sma(close, smaLenE)

bool emaFalling = regimeMa < regimeMa[slopeLenE]
bool regimeOkL = not useRegime or close > regimeMa
bool regimeOkS = (not useRegime or close < regimeMa) and (not useSlope or emaFalling)
bool smaOkL    = not useSma or (not na(trendSma) and close > trendSma)
bool smaOkS    = not useSma or (not na(trendSma) and close < trendSma)

bool longSig  = not na(donHi) and close > donHi and regimeOkL and smaOkL
bool shortSig = not longOnly and not na(donLo) and close < donLo and regimeOkS and smaOkS

// optional exit on an SMA cross against the position (default OFF)
// JEAFX key-level target for the open position, fixed at entry and
// banked once. Shorts target the next grid level BELOW entry; longs the
// next above (only relevant if klShorts is turned off).
var float klTarget = na
var bool  klDone   = false

bool klHit = useKL and not na(klTarget) and not klDone and
     strategy.position_size != 0 and
     (not klShorts or strategy.position_size < 0) and
     (strategy.position_size > 0 ? high >= klTarget - klTolE
                                 : low  <= klTarget + klTolE)

// Daye Q4 window and its opening bar
int   etHour   = hour(time, "UTC")
bool  inQ4     = etHour >= q4StartUtc and etHour < q4StartUtc + 6
bool  q4Open   = inQ4 and not inQ4[1]
bool  q4Bank   = useQ4 and q4Open and strategy.position_size != 0 and
     (not q4Shorts or strategy.position_size < 0)

bool smaCrossOut = useSma and smaExit and not na(trendSma) and
     ((strategy.position_size > 0 and close < trendSma) or
      (strategy.position_size < 0 and close > trendSma))

// ═════════════════════════════════════════════════════════════
// TRAILING STOP
// Ratchets in the trade's favour only, and is anchored to the PREVIOUS
// bar's extreme so the current bar can never move its own stop.
// ═════════════════════════════════════════════════════════════
var float trailStop = na

if strategy.position_size > 0
    float cand = high[1] - atr * trailMultEE
    trailStop := na(trailStop) ? cand : math.max(trailStop, cand)
else if strategy.position_size < 0
    float cand = low[1] + atr * trailMultEE
    trailStop := na(trailStop) ? cand : math.min(trailStop, cand)
else
    trailStop := na

// ═════════════════════════════════════════════════════════════
// EXECUTION
// ═════════════════════════════════════════════════════════════
// counter-trend side is sized smaller; direction is known before entry
bool  wantShort = shortSig and not longSig
float effRisk  = wantShort ? riskPct * shortRisk : riskPct
float stopDist = atr * trailMultE
float qtyRaw   = stopDist > 0 ? strategy.equity * effRisk / 100.0 / stopDist : 0
float qtyCap   = strategy.equity * maxLev / close
float qty      = math.floor(math.min(qtyRaw, qtyCap))

if longSig and strategy.position_size == 0 and qty >= 1
    strategy.entry("L", strategy.long, qty=qty)
    trailStop := close - stopDist
    klTarget := (math.floor(close / klGridE) + 1) * klGridE
    klDone := false

if shortSig and strategy.position_size == 0 and qty >= 1
    strategy.entry("S", strategy.short, qty=qty)
    trailStop := close + stopDist
    klTarget := (math.ceil(close / klGridE) - 1) * klGridE
    klDone := false

// no take-profit and no time stop, deliberately: capping the winners is
// exactly what broke every previous engine in this repo
if klHit
    strategy.close(strategy.position_size > 0 ? "L" : "S", qty_percent=klTake, comment="Key level")
    klDone := true
if q4Bank
    strategy.close(strategy.position_size > 0 ? "L" : "S", qty_percent=q4Take, comment="Q4 bank")
if smaCrossOut
    strategy.close_all(comment="SMA cross")
if strategy.position_size > 0 and not na(trailStop)
    strategy.exit("L-exit", "L", stop=trailStop)
if strategy.position_size < 0 and not na(trailStop)
    strategy.exit("S-exit", "S", stop=trailStop)

// ═════════════════════════════════════════════════════════════
// VISUALS
// ═════════════════════════════════════════════════════════════
plot(showBand and not na(donHi) ? donHi : na, "Breakout level", color.new(color.orange, 40), 1, plot.style_stepline)
plot(showStop and strategy.position_size != 0 ? trailStop : na, "Trailing stop", color.new(#D50000, 0), 2, plot.style_stepline)
plot(useRegime ? regimeMa : na, "Regime EMA", color.new(color.fuchsia, 50), 1)
plot(useSma ? trendSma : na, "Trend SMA", color.new(color.aqua, 25), 2)
bgcolor(useQ4 and inQ4 ? color.new(color.purple, 92) : na, title="Daye Q4 (profit-taking quarter)")
plot(useKL and strategy.position_size != 0 and not klDone ? klTarget : na,
     "Key-level target", color.new(color.yellow, 0), 2, plot.style_circles)

plotshape(longSig and strategy.position_size == 0, "Long entry", shape.triangleup, location.belowbar, color.new(#00C853, 0), size=size.small, text="LONG")
plotshape(shortSig and strategy.position_size == 0, "Short entry", shape.triangledown, location.abovebar, color.new(#D50000, 0), size=size.small, text="SHORT")

bool exitedLong  = strategy.position_size[1] > 0 and strategy.position_size == 0
bool exitedShort = strategy.position_size[1] < 0 and strategy.position_size == 0
plotshape(exitedLong or exitedShort, "Stop hit", shape.xcross, location.absolute, color.new(color.gray, 0), size=size.tiny)

// ═════════════════════════════════════════════════════════════
// ALERTS
// ═════════════════════════════════════════════════════════════
alertcondition(longSig,  "Gold Trend — LONG entry",  "LONG {{ticker}} {{interval}} at {{close}}")
alertcondition(shortSig, "Gold Trend — SHORT entry", "SHORT {{ticker}} {{interval}} at {{close}}")
alertcondition(exitedLong or exitedShort, "Gold Trend — trailing stop hit", "STOP HIT {{ticker}} {{interval}} at {{close}}")

// ═════════════════════════════════════════════════════════════
// DASHBOARD
// ═════════════════════════════════════════════════════════════
var table dash = table.new(position.top_right, 2, 10, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.new(color.gray, 60))
if showDash and barstate.islast
    int nT = strategy.closedtrades
    int wT = 0
    float gw = 0.0
    float gl = 0.0
    if nT > 0
        for i = 0 to nT - 1
            float p = strategy.closedtrades.profit(i)
            wT += p > 0 ? 1 : 0
            gw += p > 0 ? p : 0.0
            gl += p < 0 ? -p : 0.0
    float wr = nT > 0 ? wT * 100.0 / nT : na
    float pf = gl > 0 ? gw / gl : na
    float netPct = (strategy.equity - strategy.initial_capital) / strategy.initial_capital * 100

    table.cell(dash, 0, 0, "GOLD TREND", text_color=color.orange, text_size=size.small)
    table.cell(dash, 1, 0, str.tostring(entryLenE) + " / " + str.tostring(trailMultE, "#.#") + "x", text_color=color.orange, text_size=size.small)
    table.cell(dash, 0, 1, "Trades", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 1, str.tostring(nT), text_color=nT < 250 ? color.yellow : color.white, text_size=size.tiny)
    table.cell(dash, 0, 2, "Win rate", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 2, na(wr) ? "-" : str.tostring(wr, "#.#") + "%", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 0, 3, "Profit factor", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 3, na(pf) ? "-" : str.tostring(pf, "#.##"), text_color=na(pf) ? color.gray : pf >= 1.3 ? color.lime : pf >= 1.0 ? color.yellow : color.red, text_size=size.tiny)
    table.cell(dash, 0, 4, "Net", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 4, str.tostring(netPct, "#.#") + "%", text_color=netPct > 0 ? color.lime : color.red, text_size=size.tiny)
    table.cell(dash, 0, 5, "In position", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 5, strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "flat", text_color=strategy.position_size != 0 ? color.lime : color.gray, text_size=size.tiny)
    table.cell(dash, 0, 6, "Stop", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 6, na(trailStop) ? "-" : str.tostring(trailStop, format.mintick), text_color=color.red, text_size=size.tiny)
    table.cell(dash, 0, 7, "Validated OOS", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 7, "PF 1.59 / DD 5.5%", text_color=color.aqua, text_size=size.tiny)
    table.cell(dash, 0, 8, "Edge is the EXIT", text_color=color.orange, text_size=size.tiny)
    table.cell(dash, 1, 8, "entry adds ~0", text_color=color.orange, text_size=size.tiny)
    table.cell(dash, 0, 9, autoScale ? "auto " + timeframe.period : "MANUAL settings",
         text_color=autoScale ? color.aqua : color.orange, text_size=size.tiny)
    table.cell(dash, 1, 9, autoScale ? "sma " + str.tostring(smaLenE) + " ema " + str.tostring(regimeLenE)
         + " grid " + str.tostring(klGridE, "#.##") : (nT < 250 ? "n<250: unstable" : ""),
         text_color=color.silver, text_size=size.tiny)


// ════════════════════════════════════════════════════════════════════
