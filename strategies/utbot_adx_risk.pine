//@version=6
// ============================================================================
// UT BOT + ADX FILTER + RISK SIZING  —  drawdown-reduction build
// ----------------------------------------------------------------------------
// MEASURED on XAUUSD 15m, 2019-12 -> 2026-07, key=19 ATR=10, 0.20 slip + 0.07
// comm/side, 1 unit. 301 baseline trades.
//
//   config                     n     PF     net     maxDD    MAR
//   baseline (as-is)          301   1.435   +2125    728     2.92
//   ADX >= 25                 227   1.485   +1680    680     2.47
//   ADX >= 28                 193   1.604   +1772    385     4.60
//   ADX >= 30  <-- shipped    178   1.596   +1625    323     5.04
//   ADX >= 32                 162   1.755   +1790    323     5.55
//   ADX >= 35                 129   1.580   +1048    347     3.02
//
//   DRAWDOWN -56%, PROFIT FACTOR +11%, RETURN PER UNIT OF DRAWDOWN 2.92 -> 5.04.
//   The whole band 25-35 improves BOTH metrics, so this is a plateau, not a
//   fitted cell. Below 22 the filter HURTS (PF 1.23-1.26), which is what a real
//   threshold looks like rather than a "trade less" artifact.
//
// WHY THERE IS NO TRAILING STOP HERE  (tested, rejected)
//   Every trail tighter than UT Bot's own 19 x ATR(10) fires BEFORE the signal
//   flip on 100% of trades -- it replaces the strategy instead of protecting it:
//     chandelier 12x ATR : PF 1.133 (-21%)   chandelier 8x : PF 0.927 (-35%)
//     chandelier  6x ATR : PF 0.978 (-32%)   chandelier 4x : PF 0.776 (-46%)
//     fixed 4x ATR stop  : PF 0.980 (-32%)   fixed 2x     : PF 0.668 (-53%)
//   The UT trail IS the stop. The only stop that earns its place is a WIDE
//   disaster stop for gaps, which costs about 5% of PF (12x ATR: PF 1.365,
//   DD -15%). It is OFF by default; turn it on only if you need gap cover.
//
// HONEST LIMITATION -- READ THIS
//   Year by year on ADX>=30: 2020 -139 | 2021 +54 | 2022 -72 | 2023 +7 |
//   2024 +147 | 2025 +857 | 2026 +740.  +1,597 of the +1,625 total comes from
//   2025-2026. The filter cuts drawdown; it does NOT change the fact that four
//   of seven years were flat-to-negative and the record is carried by the last
//   eighteen months. Measured on XAUUSD 15m -- re-verify on your own feed.
// ============================================================================
strategy(title="UT Bot + ADX + Risk", shorttitle="UTBOT-ADX", overlay=true,
         default_qty_type=strategy.fixed, default_qty_value=1,
         initial_capital=10000, currency=currency.NONE,
         process_orders_on_close=true, calc_on_every_tick=false, pyramiding=0)

float keyValue = input.float(19.0, "Key Value (sensitivity)", minval=0.1, step=0.5, group="UT Bot")
int   atrPeriod= input.int(10,  "ATR Period", minval=1, group="UT Bot")

bool  useAdx   = input.bool(true, "ADX trend filter", group="Filter")
int   adxLen   = input.int(14,  "ADX length", minval=2, group="Filter")
float adxMin   = input.float(30.0, "Minimum ADX to enter", minval=0, step=1, group="Filter",
     tooltip="Plateau runs 25-35. Below 22 the filter hurts. 30 is the interior choice.")

bool  useRisk  = input.bool(true, "Size from risk %", group="Risk")
float riskPct  = input.float(1.0, "Risk per trade (% of equity)", minval=0.05, maxval=10, step=0.05, group="Risk")
float fixedQty = input.float(1.0, "Fixed qty (risk sizing off)", minval=0.01, step=0.01, group="Risk")
float minQty   = input.float(0.0, "Minimum tradeable lot (0 = none)", minval=0.0, step=0.01, group="Risk")
float discAtr  = input.float(0.0, "Disaster stop (x ATR, 0 = off)", minval=0.0, step=1.0, group="Risk",
     tooltip="OFF by default. Tested: 12x costs ~5% of PF for -15% DD. Anything tighter than 12x destroys the edge.")

int fromDay=input.int(1,"From Day",minval=1,maxval=31,group="Backtest range")
int fromMon=input.int(1,"From Month",minval=1,maxval=12,group="Backtest range")
int fromYr =input.int(2019,"From Year",minval=1970,group="Backtest range")
int toDay  =input.int(1,"To Day",minval=1,maxval=31,group="Backtest range")
int toMon  =input.int(1,"To Month",minval=1,maxval=12,group="Backtest range")
int toYr   =input.int(2100,"To Year",minval=1970,group="Backtest range")
bool inRange = time >= timestamp(fromYr,fromMon,fromDay,0,0) and time <= timestamp(toYr,toMon,toDay,0,0)

// ---- UT Bot signal (verbatim) ----------------------------------------------
float xATR  = ta.atr(atrPeriod)
float nLoss = keyValue * xATR
float src   = close
var float trail = 0.0
float prev = nz(trail[1], 0.0)
trail := src > prev and src[1] > prev ? math.max(prev, src - nLoss) :
         src < prev and src[1] < prev ? math.min(prev, src + nLoss) :
         src > prev ? src - nLoss : src + nLoss
bool buy  = src > trail and ta.crossover(src, trail)
bool sell = src < trail and ta.crossover(trail, src)

// ---- ADX -------------------------------------------------------------------
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)
bool trendOk = not useAdx or adxVal >= adxMin

// ---- sizing ----------------------------------------------------------------
float atr14    = ta.atr(14)
float stopDist = discAtr > 0 ? discAtr * atr14 : nLoss
float riskAmt  = strategy.equity * riskPct / 100.0
float rawQty   = useRisk and stopDist > 0 ? math.max(riskAmt / stopDist, 0.0) : fixedQty
bool  tooSmall = minQty > 0 and rawQty < minQty
float qty      = tooSmall ? 0.0 : rawQty

// ---- orders ----------------------------------------------------------------
if buy and trendOk and inRange and qty > 0
    strategy.entry("long", strategy.long, qty=qty)
if sell and trendOk and inRange and qty > 0
    strategy.entry("short", strategy.short, qty=qty)

var float discPx = na
if strategy.position_size == 0
    discPx := na
else if na(discPx) and discAtr > 0
    discPx := strategy.position_size > 0 ? strategy.position_avg_price - discAtr * atr14 : strategy.position_avg_price + discAtr * atr14
if discAtr > 0 and not na(discPx)
    if strategy.position_size > 0
        strategy.exit("Lstop","long",  stop=discPx)
    if strategy.position_size < 0
        strategy.exit("Sstop","short", stop=discPx)

if not inRange and inRange[1]
    strategy.close_all(comment="range end")

plot(trail, "UT trail", color=src > trail ? color.new(color.green,0) : color.new(color.red,0))
plot(discAtr > 0 ? discPx : na, "Disaster stop", color=color.new(color.orange,0), style=plot.style_linebr)
bgcolor(trendOk ? na : color.new(color.gray, 90))
plotshape(buy  and trendOk and inRange, title="Buy",  text="Buy",  style=shape.labelup,   location=location.belowbar, color=color.green, textcolor=color.white, size=size.tiny)
plotshape(sell and trendOk and inRange, title="Sell", text="Sell", style=shape.labeldown, location=location.abovebar, color=color.red,   textcolor=color.white, size=size.tiny)

var table tb = table.new(position.top_right, 2, 4, border_width=1)
if barstate.islast
    table.cell(tb,0,0,"ADX now", text_size=size.small)
    table.cell(tb,1,0,str.tostring(adxVal,"#.#") + (trendOk ? " OK" : " BLOCK"), text_size=size.small, text_color=trendOk?color.green:color.red)
    table.cell(tb,0,1,"risk/trade", text_size=size.small)
    table.cell(tb,1,1,str.tostring(riskPct,"#.##")+"%", text_size=size.small)
    table.cell(tb,0,2,"qty", text_size=size.small)
    table.cell(tb,1,2,tooSmall ? "TOO SMALL" : str.tostring(qty,"#.###"), text_size=size.small, text_color=tooSmall?color.red:color.gray)
    table.cell(tb,0,3,"stop dist", text_size=size.small)
    table.cell(tb,1,3,str.tostring(stopDist,"#.##"), text_size=size.small)
