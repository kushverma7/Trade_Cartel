//@version=6
// ============================================================================
// UT BOT + RISK-CONTROLLED STOP  (HPotter's UT Bot, unchanged signal)
// ----------------------------------------------------------------------------
// WHY THIS EXISTS
//   The original has no disaster stop and no sizing rule. Its exit is the
//   xATRTrailingStop flip. On a 10k account that produced a single loss of
//   7,892 (79% of capital) and a drawdown of 23,408 (234% of starting capital,
//   shown as "25.96%" only because it is measured against peak equity after the
//   account had compounded to ~90k).
//
//   THE 79% LOSS WAS A SIZING PROBLEM, NOT A MISSING STOP. A trail cannot cap a
//   loss in dollars if the position is too large. Both are fixed here:
//     1. RISK-BASED SIZING  -- position size is solved from the stop distance so
//        every trade risks a fixed % of equity. This is the same mechanism that
//        made gold_trend_G1 work (risk solved to a drawdown budget).
//     2. DISASTER STOP      -- a wide ATR stop for gaps and spikes the trail
//        cannot catch. It is a TAIL GUARD, not the working exit.
//
// DESIGN RULES TAKEN FROM THIS REPO'S OWN RESULTS
//   * The disaster stop must sit WIDER than the signal's own trail, or it front-
//     runs the strategy and destroys the large winners that pay for a 42.7% win
//     rate. UT Bot's trail is keyValue x ATR (1x by default); the disaster stop
//     defaults to 4x ATR.
//   * A healthy trend book exits mostly on SIGNAL, rarely on stop. In the
//     validated au200_zrev_daily, 67 of 71 exits were state exits and 4 were
//     stops. Watch the "stop" vs "flip" exit ratio in the Strategy Tester -- if
//     stops dominate, the disaster stop is too tight and should be widened.
//   * Tighter stops than the target collapse the win rate: measured on AU200,
//     a 5 pt stop scored 8.7% wins vs 51.4% at 20 pts. Do not tighten this to
//     "reduce risk" -- reduce risk with the risk% input instead.
//
// WHAT THIS DOES NOT DO
//   It does not improve the edge. It caps the loss per trade and makes the
//   equity curve survivable. Expect LOWER headline returns than the unsized
//   original -- that headline was leverage, not performance.
// ============================================================================
strategy(title="UT Bot + Risk Stop", shorttitle="UTBOT-RS", overlay=true,
         default_qty_type=strategy.fixed, default_qty_value=1,
         initial_capital=10000, currency=currency.NONE,
         process_orders_on_close=true, calc_on_every_tick=false, pyramiding=0,
         max_lines_count=500, max_labels_count=500)

// ---- UT Bot inputs (unchanged) ---------------------------------------------
float keyValue = input.float(1.0, "Key Value (sensitivity)", minval=0.1, step=0.1, group="UT Bot")
int   atrPeriod= input.int(10,   "ATR Period", minval=1, group="UT Bot")
bool  useHA    = input.bool(false,"Signals from Heikin Ashi Candles", group="UT Bot")

// ---- risk control (new) -----------------------------------------------------
bool  useRisk  = input.bool(true, "Size from risk % (else fixed qty)", group="Risk")
float riskPct  = input.float(1.0, "Risk per trade (% of equity)", minval=0.05, maxval=10, step=0.05, group="Risk")
float fixedQty = input.float(1.0, "Fixed qty (when risk sizing is off)", minval=0.01, step=0.01, group="Risk")
float stopAtr  = input.float(4.0, "Disaster stop (x ATR, 0 = none)", minval=0.0, step=0.5, group="Risk",
     tooltip="Must be WIDER than Key Value or it front-runs the UT trail and kills the winners.")
bool  useBE    = input.bool(false,"Move stop to breakeven after X ATR", group="Risk")
float beTrig   = input.float(3.0, "Breakeven trigger (x ATR)", minval=0.5, step=0.5, group="Risk")

// ---- backtest window --------------------------------------------------------
int fromDay  = input.int(1,    "From Day",   minval=1, maxval=31, group="Backtest range")
int fromMon  = input.int(1,    "From Month", minval=1, maxval=12, group="Backtest range")
int fromYear = input.int(2019, "From Year",  minval=1970, group="Backtest range")
int toDay    = input.int(1,    "To Day",     minval=1, maxval=31, group="Backtest range")
int toMon    = input.int(1,    "To Month",   minval=1, maxval=12, group="Backtest range")
int toYear   = input.int(2100, "To Year",    minval=1970, group="Backtest range")
bool inRange = time >= timestamp(fromYear, fromMon, fromDay, 0, 0) and
               time <= timestamp(toYear, toMon, toDay, 0, 0)

// ---- UT Bot signal, ported verbatim -----------------------------------------
float xATR  = ta.atr(atrPeriod)
float nLoss = keyValue * xATR
float src   = useHA ? request.security(ticker.heikinashi(syminfo.tickerid), timeframe.period, close) : close

var float trail = 0.0
float prev = nz(trail[1], 0.0)
trail := src > prev and src[1] > prev ? math.max(prev, src - nLoss) :
         src < prev and src[1] < prev ? math.min(prev, src + nLoss) :
         src > prev ? src - nLoss : src + nLoss

bool above = ta.crossover(src, trail)
bool below = ta.crossover(trail, src)
bool buy   = src > trail and above
bool sell  = src < trail and below

// ---- risk-based sizing ------------------------------------------------------
// Size so that (stop distance x qty) == riskPct of equity. When the disaster
// stop is off, fall back to the UT trail distance so sizing still has a basis.
float stopDist = stopAtr > 0 ? stopAtr * xATR : nLoss
float riskAmt  = strategy.equity * riskPct / 100.0
float qty      = useRisk and stopDist > 0 ? math.max(riskAmt / stopDist, 0.0) : fixedQty

// ---- entries ----------------------------------------------------------------
if buy and inRange and qty > 0
    strategy.entry("long", strategy.long, qty=qty)
if sell and inRange and qty > 0
    strategy.entry("short", strategy.short, qty=qty)

// ---- disaster stop ----------------------------------------------------------
var float stopPx = na
if strategy.position_size == 0
    stopPx := na
else if na(stopPx) and stopAtr > 0
    stopPx := strategy.position_size > 0 ? strategy.position_avg_price - stopAtr * xATR : strategy.position_avg_price + stopAtr * xATR

if useBE and not na(stopPx) and strategy.position_size != 0
    float move = strategy.position_size > 0 ? close - strategy.position_avg_price : strategy.position_avg_price - close
    if move >= beTrig * xATR
        stopPx := strategy.position_size > 0 ? math.max(stopPx, strategy.position_avg_price) : math.min(stopPx, strategy.position_avg_price)

if stopAtr > 0 and not na(stopPx)
    if strategy.position_size > 0
        strategy.exit("Lstop", "long",  stop=stopPx)
    if strategy.position_size < 0
        strategy.exit("Sstop", "short", stop=stopPx)

// ---- close out when the backtest window ends (so no open trade inflates P&L) -
if not inRange and inRange[1]
    strategy.close_all(comment="range end")

// ---- plots ------------------------------------------------------------------
plot(trail, "UT trail", color=src > trail ? color.new(color.green,0) : color.new(color.red,0))
plot(stopAtr > 0 ? stopPx : na, "Disaster stop", color=color.new(color.orange,0), style=plot.style_linebr)
plotshape(buy  and inRange, title="Buy",  text="Buy",  style=shape.labelup,
          location=location.belowbar, color=color.green, textcolor=color.white, size=size.tiny)
plotshape(sell and inRange, title="Sell", text="Sell", style=shape.labeldown,
          location=location.abovebar, color=color.red,   textcolor=color.white, size=size.tiny)
barcolor(src > trail ? color.green : src < trail ? color.red : na)

var table tb = table.new(position.top_right, 2, 4, border_width=1)
if barstate.islast
    table.cell(tb, 0, 0, "risk/trade",  text_size=size.small)
    table.cell(tb, 1, 0, str.tostring(riskPct, "#.##") + "%", text_size=size.small)
    table.cell(tb, 0, 1, "stop dist",   text_size=size.small)
    table.cell(tb, 1, 1, str.tostring(stopDist, "#.##"), text_size=size.small)
    table.cell(tb, 0, 2, "qty now",     text_size=size.small)
    table.cell(tb, 1, 2, str.tostring(qty, "#.###"), text_size=size.small)
    table.cell(tb, 0, 3, "risk $",      text_size=size.small)
    table.cell(tb, 1, 3, str.tostring(riskAmt, "#."), text_size=size.small)
