        label.set_y(monthlyLabel, monthly_open)
        label.set_text(monthlyLabel, motext)
        if mergebool
            f_LevelMerge(pricearray, labelarray, monthly_open, monthlyLabel, MonthlyColor)
        if timeframe.isweekly and dayofweek(monthly_time) != dayofweek.monday
            line.set_x1(monthlyLine, monthly_time - (weekly_time - weekly_time[1]))
// ════════════════════ END KEY_LEVELS_MODULE ═════════════════════════

// ═════════════════════════════════════════════════════════════
// SIGNALS — all ta.* unconditional at top level (BUG-004)
// ═════════════════════════════════════════════════════════════
float atr      = ta.atr(atrLen)
float donHi    = ta.highest(high, entryLenE)[1]
float donLo    = ta.lowest(low, entryLenE)[1]
float regimeMa = ta.ema(close, regimeLenE)
float trendSma = ta.sma(close, smaLenE)
float slowSma  = ta.sma(close, sma2LenE)

bool emaFalling = regimeMa < regimeMa[slopeLenE]
bool regimeOkL = not useRegime or close > regimeMa
bool regimeOkS = (not useRegime or close < regimeMa) and (not useSlope or emaFalling)
bool smaOkL    = not useSma or (not na(trendSma) and close > trendSma)
bool smaOkS    = not useSma or (not na(trendSma) and close < trendSma)
bool sma2OkL   = not useSma2 or (not na(slowSma) and close > slowSma)
bool sma2OkS   = not useSma2 or (not na(slowSma) and close < slowSma)

// Entry confluence from the levels themselves: is one drawn within reach?
// Off by default — measured, and it costs money. See the input tooltip.
f_klNear(float px, float dist) =>
    bool found = false
    if array.size(klPrices) > 0
        for i = 0 to array.size(klPrices) - 1
            float p = array.get(klPrices, i)
            if not na(p) and math.abs(p - px) <= dist
                found := true
    found

bool klEntryOk = not useKLEntry or f_klNear(close, atr * klEntryAtr)

bool longSig  = not na(donHi) and close > donHi and regimeOkL and smaOkL and sma2OkL and klEntryOk
bool shortSig = not longOnly and not na(donLo) and close < donLo and regimeOkS and smaOkS and sma2OkS and klEntryOk

// ── the level the open trade is running toward ───────────────────
// Fixed at entry, acted on once. A long targets the nearest level ABOVE
// its entry, a short the nearest BELOW: "key level to key level".
//
// f_klNext reads klPrices[] — the array the embedded module fills with
// every level it draws. PORT DELTA: this block sits after the module, so
// the array holds the levels as of THIS bar. That ordering is why the
// strategy logic was moved below the module rather than left above it,
// where it would have read the previous bar's array.
f_klNext(float px, int dir) =>
    float best = na
    if array.size(klPrices) > 0
        for i = 0 to array.size(klPrices) - 1
            float p = array.get(klPrices, i)
            if not na(p)
                if dir > 0 and p > px
                    best := na(best) or p < best ? p : best
                else if dir < 0 and p < px
                    best := na(best) or p > best ? p : best
    best

// The floor is why this takes an atr argument: levels closer than
// klMinAtr are skipped, so the target is always a distance worth trading
// toward rather than whichever line happens to sit nearest.
f_klPick(float px, int dir, float a) =>
    float floorD = a * klMinAtr
    klSource == "Chart key levels" ? f_klNext(px + dir * floorD, dir)
         : dir > 0 ? (math.floor((px + floorD) / klGridE) + 1) * klGridE
                   : (math.ceil((px - floorD) / klGridE) - 1) * klGridE

// optional exit on an SMA cross against the position (default OFF)
var float klTarget = na
var bool  klDone   = false
var int   forceDir = 0        // set by a reversal, consumed on the next bar

bool klHit = useKL and not na(klTarget) and not klDone and
     strategy.position_size != 0 and
     (not klShorts or strategy.position_size < 0) and
     (strategy.position_size > 0 ? high >= klTarget - klTolE
                                 : low  <= klTarget + klTolE)

// Daye Q4 window and its opening bar
int   etHour   = hour(time, "UTC")
bool  inQ4     = etHour >= q4StartUtc and etHour < q4StartUtc + 6
bool  q4Open   = inQ4 and not inQ4[1]
bool  q4Bank   = useQ4 and q4Open and strategy.position_size != 0 and
     (not q4Shorts or strategy.position_size < 0)

bool smaCrossOut = useSma and smaExit and not na(trendSma) and
     ((strategy.position_size > 0 and close < trendSma) or
      (strategy.position_size < 0 and close > trendSma))

// ═════════════════════════════════════════════════════════════
// TRAILING STOP
// Ratchets in the trade's favour only, and is anchored to the PREVIOUS
// bar's extreme so the current bar can never move its own stop.
// ═════════════════════════════════════════════════════════════
var float trailStop = na

if strategy.position_size > 0
    float cand = high[1] - atr * trailMultE
    trailStop := na(trailStop) ? cand : math.max(trailStop, cand)
else if strategy.position_size < 0
    float cand = low[1] + atr * trailMultE
    trailStop := na(trailStop) ? cand : math.min(trailStop, cand)
else
    trailStop := na

// ═════════════════════════════════════════════════════════════
// EXECUTION
// ═════════════════════════════════════════════════════════════
// A pending reversal overrides the breakout: the level IS the signal.
// It still has to clear the regime filters — a flip into a side the
// regime forbids is dropped, not queued.
bool  flipL    = forceDir > 0 and regimeOkL and smaOkL and sma2OkL
bool  flipS    = forceDir < 0 and not longOnly and regimeOkS and smaOkS and sma2OkS
bool  goLong   = flipL or (forceDir == 0 and longSig)
bool  goShort  = flipS or (forceDir == 0 and shortSig)

// counter-trend side is sized smaller; direction is known before entry
bool  wantShort = goShort and not goLong
float effRisk  = wantShort ? riskPct * shortRisk : riskPct
float stopDist = atr * trailMultE
float qtyRaw   = stopDist > 0 ? strategy.equity * effRisk / 100.0 / stopDist : 0
float qtyCap   = strategy.equity * maxLev / close
float qty      = math.floor(math.min(qtyRaw, qtyCap))

if goLong and strategy.position_size == 0 and qty >= 1
    strategy.entry("L", strategy.long, qty=qty)
    trailStop := close - stopDist
    klTarget := f_klPick(close, 1, atr)
    klDone := false

if goShort and strategy.position_size == 0 and qty >= 1
    strategy.entry("S", strategy.short, qty=qty)
    trailStop := close + stopDist
    klTarget := f_klPick(close, -1, atr)
    klDone := false

// the flip is spent whether or not it was taken
if forceDir != 0
    forceDir := 0

// no take-profit and no time stop, deliberately: capping the winners is
// exactly what broke every previous engine in this repo.
// klFlip turns the level exit into a full stop-and-reverse instead.
if klHit
    if klFlip
        forceDir := strategy.position_size > 0 ? -1 : 1
        strategy.close_all(comment="Key level reverse")
    else
        strategy.close(strategy.position_size > 0 ? "L" : "S", qty_percent=klTake, comment="Key level")
    klDone := true
if q4Bank
    strategy.close(strategy.position_size > 0 ? "L" : "S", qty_percent=q4Take, comment="Q4 bank")
if smaCrossOut
    strategy.close_all(comment="SMA cross")
if strategy.position_size > 0 and not na(trailStop)
    strategy.exit("L-exit", "L", stop=trailStop)
if strategy.position_size < 0 and not na(trailStop)
    strategy.exit("S-exit", "S", stop=trailStop)

// ═════════════════════════════════════════════════════════════
// VISUALS
// ═════════════════════════════════════════════════════════════
plot(showBand and not na(donHi) ? donHi : na, "Breakout level", color.new(color.orange, 40), 1, plot.style_stepline)
plot(showStop and strategy.position_size != 0 ? trailStop : na, "Trailing stop", color.new(#D50000, 0), 2, plot.style_stepline)
plot(useRegime ? regimeMa : na, "Regime EMA", color.new(color.fuchsia, 50), 1)
plot(useSma ? trendSma : na, "Trend SMA", color.new(color.aqua, 25), 2)
plot(useSma2 ? slowSma : na, "Slow SMA (confluence)", color.new(#7E57C2, 15), 2)
bgcolor(useQ4 and inQ4 ? color.new(color.purple, 92) : na, title="Daye Q4 (profit-taking quarter)")
plot(useKL and strategy.position_size != 0 and not klDone ? klTarget : na,
     "Key-level target", color.new(color.yellow, 0), 2, plot.style_circles)

plotshape(goLong and strategy.position_size == 0, "Long entry", shape.triangleup, location.belowbar, color.new(#00C853, 0), size=size.small, text="LONG")
plotshape(goShort and strategy.position_size == 0, "Short entry", shape.triangledown, location.abovebar, color.new(#D50000, 0), size=size.small, text="SHORT")
plotshape(klHit ? klTarget : na, "Key-level exit", shape.diamond, location.absolute, color.new(color.yellow, 0), size=size.tiny)

bool exitedLong  = strategy.position_size[1] > 0 and strategy.position_size == 0
bool exitedShort = strategy.position_size[1] < 0 and strategy.position_size == 0
plotshape(exitedLong or exitedShort, "Stop hit", shape.xcross, location.absolute, color.new(color.gray, 0), size=size.tiny)

// ═════════════════════════════════════════════════════════════
// ALERTS
// ═════════════════════════════════════════════════════════════
alertcondition(goLong,  "Gold Trend — LONG entry",  "LONG {{ticker}} {{interval}} at {{close}}")
alertcondition(goShort, "Gold Trend — SHORT entry", "SHORT {{ticker}} {{interval}} at {{close}}")
alertcondition(exitedLong or exitedShort, "Gold Trend — trailing stop hit", "STOP HIT {{ticker}} {{interval}} at {{close}}")
alertcondition(klHit, "Gold Trend — key level reached", "KEY LEVEL {{ticker}} {{interval}} at {{close}}")

// ═════════════════════════════════════════════════════════════
// DASHBOARD
// ═════════════════════════════════════════════════════════════
var table dash = table.new(position.top_right, 2, 12, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.new(color.gray, 60))
if showDash and barstate.islast
    int nT = strategy.closedtrades
    int wT = 0
    float gw = 0.0
    float gl = 0.0
    if nT > 0
        for i = 0 to nT - 1
            float p = strategy.closedtrades.profit(i)
            wT += p > 0 ? 1 : 0
            gw += p > 0 ? p : 0.0
            gl += p < 0 ? -p : 0.0
    float wr = nT > 0 ? wT * 100.0 / nT : na
    float pf = gl > 0 ? gw / gl : na
    float netPct = (strategy.equity - strategy.initial_capital) / strategy.initial_capital * 100

    table.cell(dash, 0, 0, "GOLD TREND", text_color=color.orange, text_size=size.small)
    table.cell(dash, 1, 0, str.tostring(entryLenE) + " / " + str.tostring(trailMultE, "#.#") + "x", text_color=color.orange, text_size=size.small)
    table.cell(dash, 0, 1, "Trades", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 1, str.tostring(nT), text_color=nT < 250 ? color.yellow : color.white, text_size=size.tiny)
    table.cell(dash, 0, 2, "Win rate", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 2, na(wr) ? "-" : str.tostring(wr, "#.#") + "%", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 0, 3, "Profit factor", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 3, na(pf) ? "-" : str.tostring(pf, "#.##"), text_color=na(pf) ? color.gray : pf >= 1.3 ? color.lime : pf >= 1.0 ? color.yellow : color.red, text_size=size.tiny)
    table.cell(dash, 0, 4, "Net", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 4, str.tostring(netPct, "#.#") + "%", text_color=netPct > 0 ? color.lime : color.red, text_size=size.tiny)
    table.cell(dash, 0, 5, "In position", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 5, strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "flat", text_color=strategy.position_size != 0 ? color.lime : color.gray, text_size=size.tiny)
    table.cell(dash, 0, 6, "Stop", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 6, na(trailStop) ? "-" : str.tostring(trailStop, format.mintick), text_color=color.red, text_size=size.tiny)
    // ── live confluence read-out: what agrees RIGHT NOW, and with what ──
    // Written for manual trading: this is the checklist you would run by
    // eye before taking the trade, evaluated on the last closed bar.
    string cUp = (regimeOkL ? "EMA " : "") + (smaOkL ? "SMA" + str.tostring(smaLenE) + " " : "")
         + (sma2OkL ? "SMA" + str.tostring(sma2LenE) : "")
    string cDn = (regimeOkS ? "EMA " : "") + (smaOkS ? "SMA" + str.tostring(smaLenE) + " " : "")
         + (sma2OkS ? "SMA" + str.tostring(sma2LenE) : "")
    int nUp = (regimeOkL ? 1 : 0) + (smaOkL ? 1 : 0) + (sma2OkL ? 1 : 0)
    int nDn = (regimeOkS ? 1 : 0) + (smaOkS ? 1 : 0) + (sma2OkS ? 1 : 0)
    table.cell(dash, 0, 7, "Confluence", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 7, nUp == 3 ? "LONG 3/3" : nDn == 3 ? "SHORT 3/3"
         : "none (" + str.tostring(math.max(nUp, nDn)) + "/3)",
         text_color=nUp == 3 ? color.lime : nDn == 3 ? color.red : color.gray, text_size=size.tiny)
    table.cell(dash, 0, 8, "  agreeing", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 8, nUp >= nDn ? cUp : cDn, text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 0, 9, "Next level", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 9, na(klTarget) or strategy.position_size == 0 ? "-"
         : str.tostring(klTarget, format.mintick) + (klDone ? " (done)" : ""),
         text_color=klDone ? color.gray : color.yellow, text_size=size.tiny)
    table.cell(dash, 0, 10, "Validated OOS", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 10, "PF 1.62 / DD 8.1%", text_color=color.aqua, text_size=size.tiny)
    table.cell(dash, 0, 11, autoScale ? "auto " + timeframe.period : "MANUAL settings",
         text_color=autoScale ? color.aqua : color.orange, text_size=size.tiny)
    table.cell(dash, 1, 11, autoScale ? "sma " + str.tostring(smaLenE) + "/" + str.tostring(sma2LenE)
         + " ema " + str.tostring(regimeLenE) : (nT < 250 ? "n<250: unstable" : ""),
         text_color=color.silver, text_size=size.tiny)


