// ════════════════════════════════════════════════════════════════════
// KEY LEVELS STRATEGY — SPACEMAN EDITION  (v1.2, bug-fixed + scorecard)
// ════════════════════════════════════════════════════════════════════
// User-supplied v1.0 reported XAUUSD 30m, Jan 2 2025 - Jul 29 2026:
//   22 trades / WR 63.64% / PF 1.783 / +7.70% / max DD 7.01%
//
// THAT NUMBER IS NOT USABLE AS-IS. Four defects found, all fixed below.
// Read the notes before trusting any before/after comparison.
//
// FIX 1 — BUG-012, silent margin rejection (this is the big one)
//   v1.0 declared no margin_long/margin_short, so Pine v6 defaults both
//   to 100% (no leverage). Sizing was qty = round(equity * risk% / slDist)
//   = round(100 / slDist). On 30m gold slDist runs ~$6-37, so qty came out
//   3-17 contracts = $12,000-$68,000 notional against $10,000 equity.
//   TradingView SILENTLY skips any order exceeding buying power. The chart
//   plots ~4 signals per 5 days (hundreds over the tested range) but only
//   22 filled. The 22 that DID fill are the ones that happened to size
//   smallest, i.e. the widest-stop trades -- a biased subsample, not an
//   edge. PF 1.783 is an artifact of which orders survived the rejection
//   filter.
//   Fixed: margin_long/short = 5 (20:1, typical gold CFD) AND a hard cap
//   at equity * maxLev / close so sizing can never request more notional
//   than the account can hold. Signal-vs-fill counters added to the
//   dashboard so this failure mode can never hide again.
//
// FIX 2 — the TP1 tranche had no stop loss
//   v1.0: strategy.exit("L1", "L", limit=tp1, qty=q1)   <- limit only.
//   60% of every position (i_tp1Pct default) carried NO stop and rode
//   until the 36-bar time stop. That is why largest loss $639.14 dwarfs
//   largest profit $194.84 (3.3x the wrong way) on a strategy whose
//   fixed-R target is 1.5R. Fixed: both tranches carry stop=sl.
//
// FIX 3 — "Break + Retest" required no prior break
//   low12 = ta.lowest(low, 12) INCLUDES the current bar. The retest test
//   then read `low12 < lv` while also requiring `low > lv - tol`, so the
//   current bar's own dip satisfied the "was below" condition. Any bar
//   that wicked the level from above and closed above qualified -- no
//   break ever had to happen. Fixed with a [1] offset so the lookback
//   genuinely excludes the retest bar.
//
// FIX 4 — day counters incremented on signals, not fills
//   dayTrades and lastSig advanced whenever a signal fired, including on
//   orders that were then rejected, so the daily cap and cooldown were
//   throttling phantom trades. Now gated on an actual position change.
//
// UNCHANGED ON PURPOSE: the level set, entry conditions, session filter,
// TP/SL geometry and all defaults. The point of this build is to measure
// the SAME strategy with working execution, not a different strategy.
//
// SAMPLE-SIZE WARNING: 22 trades supports no conclusion in either
// direction. A 63.64% win rate on n=22 has a 95% confidence interval of
// roughly 41%-82%. Do not compare v1.1 to v1.0 on PF; compare on trade
// count first -- if fills jump into the hundreds, v1.0's number was the
// rejection artifact described above and is simply void.
// ════════════════════════════════════════════════════════════════════
//@version=6
strategy("Key Levels Strategy — Spaceman Edition v1.2",
     overlay            = true,
     max_lines_count    = 500,
     max_labels_count   = 500,
     initial_capital    = 10000,
     currency           = currency.USD,
     default_qty_type   = strategy.cash,
     default_qty_value  = 1000,
     commission_type    = strategy.commission.cash_per_contract,
     commission_value   = 0.07,
     slippage           = 3,
     process_orders_on_close = true,
     margin_long        = 5,
     margin_short       = 5,
     max_bars_back      = 500)

// ═════════════════════════════════════════════════════════════
// INPUTS
// ═════════════════════════════════════════════════════════════
grpSess = "Session"
i_tz      = input.string("Etc/UTC", "Timezone", group=grpSess)
i_london  = input.session("0800-1200", "London", group=grpSess)
i_ny      = input.session("1330-1630", "NY Overlap", group=grpSess)
i_useSess = input.bool(true, "Enable Session Filter", group=grpSess)

grpLvl = "Levels to Trade"
i_do    = input.bool(true, "Daily Open", group=grpLvl)
i_pdh   = input.bool(true, "Prev Day High", group=grpLvl)
i_pdl   = input.bool(true, "Prev Day Low", group=grpLvl)
i_wo    = input.bool(true, "Weekly Open", group=grpLvl)
i_pwh   = input.bool(true, "Prev Week High", group=grpLvl)
i_pwl   = input.bool(true, "Prev Week Low", group=grpLvl)
i_mo    = input.bool(false, "Monthly Open", group=grpLvl)
i_pmh   = input.bool(false, "Prev Month High", group=grpLvl)
i_pml   = input.bool(false, "Prev Month Low", group=grpLvl)
i_4ho   = input.bool(false, "4H Open", group=grpLvl)
i_4hh   = input.bool(false, "Prev 4H High", group=grpLvl)
i_4hl   = input.bool(false, "Prev 4H Low", group=grpLvl)
i_mon   = input.bool(true, "Monday Range", group=grpLvl)
i_lon   = input.bool(false, "London Range", group=grpLvl)
i_nyl   = input.bool(false, "NY Range", group=grpLvl)

grpEntry = "Entry Logic"
i_mode    = input.string("Both", "Entry Mode", options=["Sweep+Reclaim", "Break+Retest", "Both"], group=grpEntry)
i_tolAtr  = input.float(0.25, "Level Proximity (x ATR)", step=0.05, group=grpEntry)
i_bufAtr  = input.float(0.3, "Stop Buffer (x ATR)", step=0.05, group=grpEntry)
i_minSL   = input.float(1.0, "Min SL (x ATR)", step=0.1, group=grpEntry)
i_maxSL   = input.float(2.5, "Max SL (x ATR)", step=0.1, group=grpEntry)
i_cool    = input.int(3, "Cooldown Bars", minval=1, group=grpEntry)
i_volMin  = input.float(0.7, "Min ATR vs 20-bar avg", step=0.1, group=grpEntry)
i_brkLB   = input.int(12, "Break lookback (bars, excludes current)", minval=3, group=grpEntry)

grpExit = "Exit Logic"
i_tpMode  = input.string("Key Levels", "TP Mode", options=["Key Levels", "Fixed R"], group=grpExit)
i_tp1R    = input.float(1.5, "TP1 Fixed R", step=0.1, group=grpExit)
i_tp2R    = input.float(3.0, "TP2 Fixed R", step=0.1, group=grpExit)
i_tp1Pct  = input.float(60, "% Closed at TP1", minval=10, maxval=90, group=grpExit)
i_minTpr  = input.float(1.0, "Min TP1 Distance (R)", step=0.1, group=grpExit)

grpRisk = "Risk"
i_risk    = input.float(1.0, "Risk %", step=0.25, group=grpRisk)
i_maxLev  = input.float(20, "Max leverage (notional cap)", minval=1, group=grpRisk)
i_maxDay  = input.int(6, "Max Trades/Day", minval=1, group=grpRisk)
i_dayLoss = input.float(2.5, "Daily Loss Limit %", step=0.5, group=grpRisk)
i_timeStop= input.int(36, "Time Stop (bars)", minval=4, group=grpRisk)

grpDbg = "Debug"
i_debug   = input.bool(true, "Show Dashboard", group=grpDbg)

// ═════════════════════════════════════════════════════════════
// HTF LEVELS
// ═════════════════════════════════════════════════════════════
float atr14 = ta.atr(14)
float atrAvg= ta.sma(atr14, 20)
bool  volOk = atr14 > atrAvg * i_volMin

[dOpen, pdh, pdl] = request.security(syminfo.tickerid, "D",
     [open, high[1], low[1]], lookahead=barmerge.lookahead_on)

[wOpen, pwh, pwl] = request.security(syminfo.tickerid, "W",
     [open, high[1], low[1]], lookahead=barmerge.lookahead_on)

[mOpen, pmh, pml] = request.security(syminfo.tickerid, "M",
     [open, high[1], low[1]], lookahead=barmerge.lookahead_on)

[h4Open, p4hh, p4hl] = request.security(syminfo.tickerid, "240",
     [open, high[1], low[1]], lookahead=barmerge.lookahead_on)

[cdHigh, cdLow] = request.security(syminfo.tickerid, "D",
     [high, low], lookahead=barmerge.lookahead_on)

// ═════════════════════════════════════════════════════════════
// SESSION TRACKING (London / NY)
// ═════════════════════════════════════════════════════════════
bool inLondon = not na(time(timeframe.period, i_london, i_tz))
bool inNY     = not na(time(timeframe.period, i_ny, i_tz))
bool inSession = i_useSess ? (inLondon or inNY) : true

// one declaration per line -- comma-chained declarations are a known
// fragility in this repo's registry, and they buy nothing
var float lonHigh = na
var float lonLow  = na
var float lonOpen = na
var float nyHigh  = na
var float nyLow   = na
var float nyOpen  = na

if inLondon
    if na(lonHigh)
        lonHigh := high
        lonLow  := low
        lonOpen := open
    else
        lonHigh := math.max(lonHigh, high)
        lonLow  := math.min(lonLow, low)
else
    lonHigh := na
    lonLow  := na
    lonOpen := na

if inNY
    if na(nyHigh)
        nyHigh := high
        nyLow  := low
        nyOpen := open
    else
        nyHigh := math.max(nyHigh, high)
        nyLow  := math.min(nyLow, low)
else
    nyHigh := na
    nyLow  := na
    nyOpen := na

// ═════════════════════════════════════════════════════════════
// MONDAY RANGE
// ═════════════════════════════════════════════════════════════
var float monHigh = na
var float monLow  = na
var bool gotMonday = false

if dayofweek == dayofweek.monday and not gotMonday
    monHigh := cdHigh
    monLow  := cdLow
    gotMonday := true
if dayofweek == dayofweek.tuesday and gotMonday
    gotMonday := false

// ═════════════════════════════════════════════════════════════
// SIGNAL LEVEL ARRAY
// Named sigLevels, NOT klPrices -- klPrices belongs to the embedded
// Spaceman module at the bottom of this file and the two must not
// collide. This array is the strategy's own tradeable subset.
// ═════════════════════════════════════════════════════════════
var sigLevels = array.new_float(0)
// parallel array of level-TYPE ids, so a trade can be attributed back to
// which kind of level it was taken at (see the LEVEL SCORECARD below)
var sigIds = array.new_int(0)

f_sigPush(bool on, float px, int id) =>
    if on and not na(px)
        array.push(sigLevels, px)
        array.push(sigIds, id)

if barstate.isnew
    array.clear(sigLevels)
    array.clear(sigIds)
    f_sigPush(i_do,  dOpen, 0)
    f_sigPush(i_pdh, pdh, 1)
    f_sigPush(i_pdl, pdl, 2)
    f_sigPush(i_wo,  wOpen, 3)
    f_sigPush(i_pwh, pwh, 4)
    f_sigPush(i_pwl, pwl, 5)
    f_sigPush(i_mo,  mOpen, 6)
    f_sigPush(i_pmh, pmh, 7)
    f_sigPush(i_pml, pml, 8)
    f_sigPush(i_4ho, h4Open, 9)
    f_sigPush(i_4hh, p4hh, 10)
    f_sigPush(i_4hl, p4hl, 11)
    f_sigPush(i_mon and not na(monHigh), monHigh, 12)
    f_sigPush(i_mon and not na(monLow),  monLow, 13)
    f_sigPush(i_lon and not na(lonHigh), lonHigh, 14)
    f_sigPush(i_lon and not na(lonLow),  lonLow, 15)
    f_sigPush(i_nyl and not na(nyHigh),  nyHigh, 16)
    f_sigPush(i_nyl and not na(nyLow),   nyLow, 17)

// ═════════════════════════════════════════════════════════════
// LEVEL NAVIGATION
// ═════════════════════════════════════════════════════════════
f_nearestAbove(float px) =>
    float best = na
    int sz = array.size(sigLevels)
    if sz > 0
        for i = 0 to sz - 1
            float lv = array.get(sigLevels, i)
            if not na(lv) and lv > px and (na(best) or lv < best)
                best := lv
    best

f_nearestBelow(float px) =>
    float best = na
    int sz = array.size(sigLevels)
    if sz > 0
        for i = 0 to sz - 1
            float lv = array.get(sigLevels, i)
            if not na(lv) and lv < px and (na(best) or lv > best)
                best := lv
    best

f_tpAbove(float px, float minDist, float maxDist) =>
    float t = f_nearestAbove(px)
    for k = 0 to 5
        if not na(t) and (t - px) < minDist
            t := f_nearestAbove(t)
    na(t) ? na : (t - px) > maxDist ? na : t

f_tpBelow(float px, float minDist, float maxDist) =>
    float t = f_nearestBelow(px)
    for k = 0 to 5
        if not na(t) and (px - t) < minDist
            t := f_nearestBelow(t)
    na(t) ? na : (px - t) > maxDist ? na : t

// ═════════════════════════════════════════════════════════════
// ENTRY DETECTION
// ═════════════════════════════════════════════════════════════
float tol = atr14 * i_tolAtr

// FIX 3: [1] offset. Without it the lookback contains the retest bar
// itself, so "price was below the level" was satisfied by the very wick
// being tested and no break was ever required.
float lowLB  = ta.lowest(low, i_brkLB)[1]
float highLB = ta.highest(high, i_brkLB)[1]

bool sweepLong  = false
bool sweepShort = false
bool retestLong = false
bool retestShort = false

int sz = array.size(sigLevels)
if sz > 0
    for i = 0 to sz - 1
        float lv = array.get(sigLevels, i)
        if not na(lv)
            // Sweep + Reclaim
            if low < lv and close > lv and close > open
                sweepLong := true
            if high > lv and close < lv and close < open
                sweepShort := true
            // Break + Retest (prior break now genuinely required)
            if close > lv and low <= lv + tol and low > lv - tol and not na(lowLB) and lowLB < lv
                retestLong := true
            if close < lv and high >= lv - tol and high < lv + tol and not na(highLB) and highLB > lv
                retestShort := true

bool canSweep  = i_mode == "Sweep+Reclaim" or i_mode == "Both"
bool canRetest = i_mode == "Break+Retest"  or i_mode == "Both"

bool sigLong  = (canSweep and sweepLong)  or (canRetest and retestLong)
bool sigShort = (canSweep and sweepShort) or (canRetest and retestShort)

// ═════════════════════════════════════════════════════════════
// EXECUTION ENGINE
// ═════════════════════════════════════════════════════════════
var int lastSig = -9999
bool cd = bar_index - lastSig > i_cool

var int dayTrades = 0
var float dayEq0 = na
var bool halted = false
bool newDay = na(dayEq0) or dayofmonth(time, i_tz) != dayofmonth(time[1], i_tz)
if newDay
    dayTrades := 0
    dayEq0 := strategy.equity
    halted := false
if not na(dayEq0) and (strategy.equity - dayEq0) <= -dayEq0 * i_dayLoss / 100.0
    halted := true

bool ok = cd and not halted and dayTrades < i_maxDay and strategy.position_size == 0 and inSession and volOk

// the exact level being defended (closest to close)
float defLong  = na
float defShort = na
int   defLongId  = -1
int   defShortId = -1

if sigLong and sz > 0
    for i = 0 to sz - 1
        float lv = array.get(sigLevels, i)
        if not na(lv) and low < lv and close > lv
            if na(defLong) or math.abs(close - lv) < math.abs(close - defLong)
                defLong := lv
                defLongId := array.get(sigIds, i)

if sigShort and sz > 0
    for i = 0 to sz - 1
        float lv = array.get(sigLevels, i)
        if not na(lv) and high > lv and close < lv
            if na(defShort) or math.abs(close - lv) < math.abs(close - defShort)
                defShort := lv
                defShortId := array.get(sigIds, i)

bool goLong  = ok and sigLong  and not na(defLong)
bool goShort = ok and sigShort and not na(defShort)

// FIX 1 / FIX 4 instrumentation: count what was ORDERED vs what actually
// FILLED. If these diverge, orders are being rejected -- the exact
// failure that produced v1.0's 22 trades.
// ═════════════════════════════════════════════════════════════
// ATTRIBUTION STATE — which LEVEL and which MODE earned the money
// 15 level toggles alone is 32,768 combinations, before touching entry
// mode, tolerances, stops or targets. That is not searchable by hand.
// So instead of testing combos, each trade is tagged with the level
// TYPE it was taken at and the trigger that fired it, and its P&L is
// attributed back on close. One backtest ranks all 18 level types and
// both entry modes at once.
// ═════════════════════════════════════════════════════════════
var int[]   lvWin  = array.new_int(18, 0)
var int[]   lvLoss = array.new_int(18, 0)
var float[] lvProf = array.new_float(18, 0.0)
var float[] lvLosd = array.new_float(18, 0.0)
var int[]   mdWin  = array.new_int(2, 0)      // 0 = sweep, 1 = retest
var int[]   mdLoss = array.new_int(2, 0)
var float[] mdProf = array.new_float(2, 0.0)
var float[] mdLosd = array.new_float(2, 0.0)
var int  curLvl    = -1
var bool curSweep  = false
var bool curRetest = false
var int  lastClosed = 0

var int sigCount = 0
if goLong or goShort
    sigCount += 1

// ═════════════════════════════════════════════════════════════
// STOPS, TARGETS, SIZING
// ═════════════════════════════════════════════════════════════
if goLong
    float slRaw = close - defLong + atr14 * i_bufAtr
    float slDist = math.min(math.max(slRaw, atr14 * i_minSL), atr14 * i_maxSL)
    float sl = close - slDist

    float tp1 = na
    float tp2 = na
    if i_tpMode == "Key Levels"
        tp1 := f_tpAbove(close, slDist * i_minTpr, atr14 * 8)
        tp2 := not na(tp1) ? f_tpAbove(tp1, slDist * 0.5, atr14 * 8) : na
    if na(tp1)
        tp1 := close + slDist * i_tp1R
    if na(tp2)
        tp2 := close + slDist * i_tp2R

    // FIX 1: cap notional so the order can actually be filled
    float riskAmt = strategy.equity * i_risk / 100.0
    float qtyCap = strategy.equity * i_maxLev / close
    float qty = math.max(1, math.floor(math.min(riskAmt / slDist, qtyCap)))
    float q1 = math.max(1, math.floor(qty * i_tp1Pct / 100.0))
    float q2 = math.max(1, qty - q1)

    strategy.entry("L", strategy.long, qty=qty)
    curLvl := defLongId
    curSweep := canSweep and sweepLong
    curRetest := canRetest and retestLong
    // FIX 2: BOTH tranches carry the stop. v1.0's L1 had limit only,
    // leaving 60% of the position unprotected until the time stop.
    strategy.exit("L1", "L", stop=sl, limit=tp1, qty=q1)
    strategy.exit("L2", "L", stop=sl, limit=tp2, qty=q2)
    lastSig := bar_index

if goShort
    float slRaw = defShort - close + atr14 * i_bufAtr
    float slDist = math.min(math.max(slRaw, atr14 * i_minSL), atr14 * i_maxSL)
    float sl = close + slDist

    float tp1 = na
    float tp2 = na
    if i_tpMode == "Key Levels"
        tp1 := f_tpBelow(close, slDist * i_minTpr, atr14 * 8)
        tp2 := not na(tp1) ? f_tpBelow(tp1, slDist * 0.5, atr14 * 8) : na
    if na(tp1)
        tp1 := close - slDist * i_tp1R
    if na(tp2)
        tp2 := close - slDist * i_tp2R

    float riskAmt = strategy.equity * i_risk / 100.0
    float qtyCap = strategy.equity * i_maxLev / close
    float qty = math.max(1, math.floor(math.min(riskAmt / slDist, qtyCap)))
    float q1 = math.max(1, math.floor(qty * i_tp1Pct / 100.0))
    float q2 = math.max(1, qty - q1)

    strategy.entry("S", strategy.short, qty=qty)
    curLvl := defShortId
    curSweep := canSweep and sweepShort
    curRetest := canRetest and retestShort
    strategy.exit("S1", "S", stop=sl, limit=tp1, qty=q1)
    strategy.exit("S2", "S", stop=sl, limit=tp2, qty=q2)
    lastSig := bar_index

// FIX 4: the daily cap counts FILLS, not signals. v1.0 incremented on
// every signal including rejected ones, throttling on phantom trades.
var int lastPosCount = 0
if strategy.opentrades + strategy.closedtrades > lastPosCount
    dayTrades += 1
    lastPosCount := strategy.opentrades + strategy.closedtrades

// Time stop
if strategy.position_size != 0 and not na(lastSig) and bar_index - lastSig >= i_timeStop
    strategy.close_all(comment="Time")

// attribute each newly-closed trade to its level type and trigger mode
if strategy.closedtrades > lastClosed
    for k = lastClosed to strategy.closedtrades - 1
        float pnl = strategy.closedtrades.profit(k)
        if curLvl >= 0 and curLvl <= 17
            if pnl > 0
                array.set(lvWin, curLvl, array.get(lvWin, curLvl) + 1)
                array.set(lvProf, curLvl, array.get(lvProf, curLvl) + pnl)
            else
                array.set(lvLoss, curLvl, array.get(lvLoss, curLvl) + 1)
                array.set(lvLosd, curLvl, array.get(lvLosd, curLvl) - pnl)
        if curSweep
            if pnl > 0
                array.set(mdWin, 0, array.get(mdWin, 0) + 1)
                array.set(mdProf, 0, array.get(mdProf, 0) + pnl)
            else
                array.set(mdLoss, 0, array.get(mdLoss, 0) + 1)
                array.set(mdLosd, 0, array.get(mdLosd, 0) - pnl)
        if curRetest
            if pnl > 0
                array.set(mdWin, 1, array.get(mdWin, 1) + 1)
                array.set(mdProf, 1, array.get(mdProf, 1) + pnl)
            else
                array.set(mdLoss, 1, array.get(mdLoss, 1) + 1)
                array.set(mdLosd, 1, array.get(mdLosd, 1) - pnl)
    lastClosed := strategy.closedtrades

// ═════════════════════════════════════════════════════════════
// VISUALS
// ═════════════════════════════════════════════════════════════
plotshape(goLong,  "Buy",  style=shape.triangleup,   location=location.belowbar, color=color.new(#00C853, 0), size=size.small)
plotshape(goShort, "Sell", style=shape.triangledown, location=location.abovebar, color=color.new(#D50000, 0), size=size.small)
bgcolor(inSession ? color.new(color.blue, 95) : na, title="Session")

// ═════════════════════════════════════════════════════════════
// DASHBOARD
// ═════════════════════════════════════════════════════════════
float nextUp = f_tpAbove(close, atr14 * i_minSL * i_minTpr, atr14 * 8)
float nextDn = f_tpBelow(close, atr14 * i_minSL * i_minTpr, atr14 * 8)

var table vt = table.new(position.top_right, 3, 15, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.gray)
if i_debug and barstate.islast
    table.cell(vt, 0, 0, "KL STRATEGY", text_color=color.orange, text_size=size.small)
    table.cell(vt, 1, 0, "v1.2", text_color=color.orange, text_size=size.small)
    table.cell(vt, 2, 0, i_mode, text_color=color.white, text_size=size.tiny)

    table.cell(vt, 0, 1, "Session", text_color=color.gray, text_size=size.tiny)
    table.cell(vt, 1, 1, inSession ? "ON" : "OFF", text_color=inSession ? color.green : color.gray, text_size=size.tiny)

    table.cell(vt, 0, 2, "Levels", text_color=color.gray, text_size=size.tiny)
    table.cell(vt, 1, 2, str.tostring(sz), text_color=color.white, text_size=size.tiny)

    table.cell(vt, 0, 3, "Vol OK", text_color=color.gray, text_size=size.tiny)
    table.cell(vt, 1, 3, volOk ? "YES" : "NO", text_color=volOk ? color.green : color.red, text_size=size.tiny)

    table.cell(vt, 0, 4, "Sweep L/S", text_color=color.gray, text_size=size.tiny)
    table.cell(vt, 1, 4, str.tostring(sweepLong) + "/" + str.tostring(sweepShort), text_color=sweepLong or sweepShort ? color.yellow : color.gray, text_size=size.tiny)

    table.cell(vt, 0, 5, "Retest L/S", text_color=color.gray, text_size=size.tiny)
    table.cell(vt, 1, 5, str.tostring(retestLong) + "/" + str.tostring(retestShort), text_color=retestLong or retestShort ? color.yellow : color.gray, text_size=size.tiny)

    table.cell(vt, 0, 6, "Cooldown", text_color=color.gray, text_size=size.tiny)
    table.cell(vt, 1, 6, cd ? "READY" : str.tostring(bar_index - lastSig), text_color=cd ? color.green : color.red, text_size=size.tiny)

    table.cell(vt, 0, 7, "Daily", text_color=color.gray, text_size=size.tiny)
    table.cell(vt, 1, 7, str.tostring(dayTrades) + "/" + str.tostring(i_maxDay), text_color=dayTrades >= i_maxDay ? color.red : color.white, text_size=size.tiny)

    table.cell(vt, 0, 8, "Defend L", text_color=color.gray, text_size=size.tiny)
    table.cell(vt, 1, 8, na(defLong) ? "-" : str.tostring(defLong, format.mintick), text_color=color.lime, text_size=size.tiny)

    table.cell(vt, 0, 9, "Defend S", text_color=color.gray, text_size=size.tiny)
    table.cell(vt, 1, 9, na(defShort) ? "-" : str.tostring(defShort, format.mintick), text_color=color.red, text_size=size.tiny)

    table.cell(vt, 0, 10, "Next Up", text_color=color.gray, text_size=size.tiny)
    table.cell(vt, 1, 10, na(nextUp) ? "-" : str.tostring(nextUp, format.mintick), text_color=color.silver, text_size=size.tiny)

    table.cell(vt, 0, 11, "Next Dn", text_color=color.gray, text_size=size.tiny)
    table.cell(vt, 1, 11, na(nextDn) ? "-" : str.tostring(nextDn, format.mintick), text_color=color.silver, text_size=size.tiny)

    // ORDERED vs FILLED — if these diverge, orders are being rejected
    int filled = strategy.opentrades + strategy.closedtrades
    table.cell(vt, 0, 12, "Signals", text_color=color.gray, text_size=size.tiny)
    table.cell(vt, 1, 12, str.tostring(sigCount), text_color=color.white, text_size=size.tiny)
    table.cell(vt, 0, 13, "Filled", text_color=color.gray, text_size=size.tiny)
    table.cell(vt, 1, 13, str.tostring(filled), text_color=color.white, text_size=size.tiny)
    table.cell(vt, 0, 14, "Fill rate", text_color=color.gray, text_size=size.tiny)
    table.cell(vt, 1, 14, sigCount > 0 ? str.tostring(filled * 100.0 / sigCount, "#.#") + "%" : "-",
         text_color=sigCount > 0 and filled * 100.0 / sigCount < 90 ? color.red : color.lime, text_size=size.tiny)

    int nT = strategy.closedtrades
    int wT = 0
    float gw = 0.0
    float gl = 0.0
    if nT > 0
        for i = 0 to nT - 1
            float p = strategy.closedtrades.profit(i)
            wT += p > 0 ? 1 : 0
            gw += p > 0 ? p : 0.0
            gl += p < 0 ? -p : 0.0
    float wr = nT > 0 ? wT * 100.0 / nT : na
    float pf = gl > 0 ? gw / gl : na

    table.cell(vt, 2, 1, "Trades", text_color=color.silver, text_size=size.tiny)
    table.cell(vt, 2, 2, str.tostring(nT), text_color=color.white, text_size=size.tiny)
    table.cell(vt, 2, 3, "WR", text_color=color.silver, text_size=size.tiny)
    table.cell(vt, 2, 4, na(wr) ? "-" : str.tostring(wr, "#.#") + "%", text_color=color.white, text_size=size.tiny)
    table.cell(vt, 2, 5, "PF", text_color=color.silver, text_size=size.tiny)
    table.cell(vt, 2, 6, na(pf) ? "-" : str.tostring(pf, "#.##"), text_color=na(pf) ? color.gray : pf >= 1.5 ? color.lime : pf >= 1.0 ? color.yellow : color.red, text_size=size.tiny)
    table.cell(vt, 2, 7, nT < 100 ? "n too small" : "", text_color=color.orange, text_size=size.tiny)

// ═════════════════════════════════════════════════════════════
// LEVEL SCORECARD — this is the answer to "which combo"
// One run ranks every level type and both entry modes. Keep what has
// PF > 1 on a readable sample; switch off the rest and re-run.
// N < 20 renders grey: too thin to read, whatever the PF says. That is
// the same trap that made a 22-trade PF of 1.783 look like an edge.
// ═════════════════════════════════════════════════════════════
bool i_score = input.bool(true, "Show Level Scorecard", group=grpDbg)

var string[] lvName = array.from(
     "Daily Open", "Prev Day High", "Prev Day Low",
     "Weekly Open", "Prev Week High", "Prev Week Low",
     "Monthly Open", "Prev Month High", "Prev Month Low",
     "4H Open", "Prev 4H High", "Prev 4H Low",
     "Monday High", "Monday Low",
     "London High", "London Low", "NY High", "NY Low")
var string[] mdName = array.from("Sweep+Reclaim", "Break+Retest")

var table sc = table.new(position.bottom_left, 4, 23, bgcolor=color.new(color.black, 15),
     border_width=1, border_color=color.new(color.gray, 60))
if i_score and barstate.islast
    table.cell(sc, 0, 0, "LEVEL", text_color=color.orange, text_size=size.tiny)
    table.cell(sc, 1, 0, "N", text_color=color.orange, text_size=size.tiny)
    table.cell(sc, 2, 0, "WR", text_color=color.orange, text_size=size.tiny)
    table.cell(sc, 3, 0, "PF", text_color=color.orange, text_size=size.tiny)
    for i = 0 to 17
        int n = array.get(lvWin, i) + array.get(lvLoss, i)
        float gp = array.get(lvProf, i)
        float gl2 = array.get(lvLosd, i)
        float pf = gl2 > 0 ? gp / gl2 : na
        float wr = n > 0 ? array.get(lvWin, i) * 100.0 / n : na
        bool thin = n < 20
        color c = thin ? color.gray : color.silver
        table.cell(sc, 0, i + 1, array.get(lvName, i), text_color=c, text_size=size.tiny)
        table.cell(sc, 1, i + 1, str.tostring(n), text_color=c, text_size=size.tiny)
        table.cell(sc, 2, i + 1, na(wr) ? "-" : str.tostring(wr, "#.#") + "%", text_color=c, text_size=size.tiny)
        table.cell(sc, 3, i + 1, na(pf) ? "-" : str.tostring(pf, "#.##"),
             text_color=thin ? color.gray : pf >= 1.2 ? color.lime : pf >= 1.0 ? color.yellow : color.red,
             text_size=size.tiny)
    for m = 0 to 1
        int n = array.get(mdWin, m) + array.get(mdLoss, m)
        float gp = array.get(mdProf, m)
        float gl2 = array.get(mdLosd, m)
        float pf = gl2 > 0 ? gp / gl2 : na
        float wr = n > 0 ? array.get(mdWin, m) * 100.0 / n : na
        bool thin = n < 20
        table.cell(sc, 0, 19 + m, "MODE: " + array.get(mdName, m), text_color=color.orange, text_size=size.tiny)
        table.cell(sc, 1, 19 + m, str.tostring(n), text_color=thin ? color.gray : color.white, text_size=size.tiny)
        table.cell(sc, 2, 19 + m, na(wr) ? "-" : str.tostring(wr, "#.#") + "%", text_color=thin ? color.gray : color.white, text_size=size.tiny)
        table.cell(sc, 3, 19 + m, na(pf) ? "-" : str.tostring(pf, "#.##"),
             text_color=thin ? color.gray : pf >= 1.2 ? color.lime : pf >= 1.0 ? color.yellow : color.red,
             text_size=size.tiny)
    table.cell(sc, 0, 22, "grey = n<20, unreadable", text_color=color.gray, text_size=size.tiny)

alertcondition(goLong,  "KL Buy",  "Key Levels BUY {{ticker}}")
alertcondition(goShort, "KL Sell", "Key Levels SELL {{ticker}}")


// ════════════════════════════════════════════════════════════════════
// EMBEDDED: SpacemanBTC IDWM Key Levels V13.1  (verbatim port)
// Standing user directive (2026-07-28): every strategy in this repo
// embeds the key-level indicator and renders it EXACTLY as the
// standalone does. Canonical copy + port deltas + preserved quirks:
// trader_playbooks/skills/key_levels_module.pine. Do not "improve" it.
// Display + klPrices[]/klNames[] export only -- the strategy above
// trades its own sigLevels[] subset, so no trade logic is changed by
// this block and v1.0 vs v1.1 stays a clean comparison.
// ════════════════════════════════════════════════════════════════════

