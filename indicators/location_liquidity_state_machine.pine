// ════════════════════ END KEY_LEVELS_MODULE ═════════════════════════

// ════════════════════════════════════════════════════════════════════
//                     HOST LOGIC  (runs after the module)
// ════════════════════════════════════════════════════════════════════
zClustTol = input.float(15.0, "Levels merge into one cluster within (points)", minval = 0.01, group = "A Clusters")
zMinScore = input.float(3.0,  "Ignore clusters scoring below (rule 1)", minval = 0.0, step = 0.5, group = "A Clusters")
zApproach = input.float(30.0, "APPROACHING when price is within (points)", minval = 0.01, group = "A Clusters")
zQtrOn    = input.bool(true,  "Add Quarter Theory levels (rule 26)", group = "A Clusters")
zQtrLarge = input.float(250.0, "Large quarter (AU200/US30 250, gold 25, NQ 250)", minval = 0.01, group = "A Clusters")
zQtrW     = input.float(2.0,  "Quarter level weight", minval = 0.0, step = 0.5, group = "A Clusters")
zSwOn     = input.bool(true,  "Add swing highs / lows", group = "A Clusters")
zSwLen    = input.int(5, "Swing lookback", minval = 2, group = "A Clusters")
zSwW      = input.float(1.0, "Swing weight", minval = 0.0, step = 0.5, group = "A Clusters")
zKlW      = input.float(1.5, "Weight of each Key-Levels reference", minval = 0.0, step = 0.5, group = "A Clusters")

zMssBars  = input.int(30, "Structure must shift within N bars of the sweep", minval = 1, group = "B Sequence")
zDisplOn  = input.bool(true, "Require displacement (rule 12)", group = "B Sequence")
zDispl    = input.float(1.2, "Displacement = bar range / ATR at least", minval = 0.1, step = 0.1, group = "B Sequence")
zRetOn    = input.bool(true, "Require the retest (rule 13)", group = "B Sequence")
zRetBars  = input.int(30, "Retest must occur within N bars", minval = 1, group = "B Sequence")
zRetTol   = input.float(15.0, "Retest counts as reached within (points)", minval = 0.01, group = "B Sequence")

zVixOn    = input.bool(true, "VIX confidence (rule 21)", group = "C Confidence")
zVixSym   = input.symbol("TVC:VIX", "VIX symbol", group = "C Confidence")
zVixLen   = input.int(6, "VIX direction over N bars", minval = 1, group = "C Confidence")
zVixLvlOn = input.bool(true, "VIX must react at its OWN level (rule 22)", group = "C Confidence")
zVixPiv   = input.int(5, "VIX pivot lookback", minval = 2, group = "C Confidence")
zVixTol   = input.float(0.5, "VIX level tolerance", minval = 0.01, step = 0.1, group = "C Confidence")
zMagOn    = input.bool(true, "Mag 7 confidence (rule 23)", group = "C Confidence")
zMagLen   = input.int(6, "Mag 7 momentum over N bars", minval = 1, group = "C Confidence")
zMagMin   = input.int(5, "Need N of 7 agreeing", minval = 1, maxval = 7, group = "C Confidence")
zHardGate = input.bool(false, "Make VIX / Mag 7 HARD gates instead of confidence (rule 24 says no)", group = "C Confidence")
zUSonly   = input.bool(true, "Score VIX / Mag 7 as unavailable outside US cash hours", group = "C Confidence")

zTgtMin   = input.float(4.0, "Only clusters scoring this or more are targets (rule 19)", minval = 0.0, step = 0.5, group = "D Targets")
zTgtNear  = input.float(20.0, "TARGET APPROACHING within (points)", minval = 0.01, group = "D Targets")
zExtend   = input.bool(true, "Extend to the next cluster while structure holds (rule 20)", group = "D Targets")

zShowClu  = input.bool(true, "Draw scored clusters", group = "E Display")
zShowSeq  = input.bool(true, "Mark sweep and structure shift", group = "E Display")

zAtr = ta.atr(14)

// ── build the pool: module export + quarters + swings ───────────────
var float[] zPx = array.new_float()
var float[] zWt = array.new_float()
array.clear(zPx)
array.clear(zWt)
if array.size(klPrices) > 0
    for i = 0 to array.size(klPrices) - 1
        p = array.get(klPrices, i)
        if not na(p)
            array.push(zPx, p)
            array.push(zWt, zKlW)
if zQtrOn
    b = math.floor(low / zQtrLarge) * zQtrLarge
    for k = 0 to 3
        array.push(zPx, b + k * zQtrLarge)
        array.push(zWt, zQtrW)
zSHr = ta.pivothigh(zSwLen, zSwLen)
zSLr = ta.pivotlow (zSwLen, zSwLen)
var float zSwH = na
var float zSwL = na
if not na(zSHr)
    zSwH := zSHr
if not na(zSLr)
    zSwL := zSLr
if zSwOn and not na(zSwH)
    array.push(zPx, zSwH)
    array.push(zWt, zSwW)
if zSwOn and not na(zSwL)
    array.push(zPx, zSwL)
    array.push(zWt, zSwW)

// ── cluster them (rules 3, 25) ──────────────────────────────────────
var float[] zCmid = array.new_float()
var float[] zCsc  = array.new_float()
var int[]   zCn   = array.new_int()
array.clear(zCmid)
array.clear(zCsc)
array.clear(zCn)
if array.size(zPx) > 0
    used = array.new_bool(array.size(zPx), false)
    for i = 0 to array.size(zPx) - 1
        if not array.get(used, i)
            base = array.get(zPx, i)
            sum = base
            sc  = array.get(zWt, i)
            cnt = 1
            array.set(used, i, true)
            for j = i + 1 to array.size(zPx) - 1
                if not array.get(used, j) and math.abs(array.get(zPx, j) - base) <= zClustTol
                    sum := sum + array.get(zPx, j)
                    sc  := sc + array.get(zWt, j)
                    cnt := cnt + 1
                    array.set(used, j, true)
            array.push(zCmid, sum / cnt)
            array.push(zCsc, sc)
            array.push(zCn, cnt)

f_cluNear() =>
    m = float(na)
    s = 0.0
    d = float(na)
    if array.size(zCmid) > 0
        for i = 0 to array.size(zCmid) - 1
            if array.get(zCsc, i) >= zMinScore
                dd = math.abs(close - array.get(zCmid, i))
                if na(d) or dd < d
                    d := dd
                    m := array.get(zCmid, i)
                    s := array.get(zCsc, i)
    [m, s, d]

[zLvl, zScore, zDist] = f_cluNear()

f_target(dir, from) =>
    best = float(na)
    if array.size(zCmid) > 0
        for i = 0 to array.size(zCmid) - 1
            v = array.get(zCmid, i)
            if array.get(zCsc, i) >= zTgtMin
                if dir > 0 and v > from and (na(best) or v < best)
                    best := v
                if dir < 0 and v < from and (na(best) or v > best)
                    best := v
    best

// ── VIX (rules 21, 22) ──────────────────────────────────────────────
zVix  = request.security(zVixSym, timeframe.period, close, lookahead = barmerge.lookahead_off)
zVixH = request.security(zVixSym, timeframe.period, high,  lookahead = barmerge.lookahead_off)
zVixL = request.security(zVixSym, timeframe.period, low,   lookahead = barmerge.lookahead_off)
zVpH = ta.pivothigh(zVixH, zVixPiv, zVixPiv)
zVpL = ta.pivotlow (zVixL, zVixPiv, zVixPiv)
var float zVixR = na
var float zVixS = na
if not na(zVpH)
    zVixR := zVpH
if not na(zVpL)
    zVixS := zVpL
zVixDn = not na(zVix) and zVix < zVix[zVixLen]
zVixUp = not na(zVix) and zVix > zVix[zVixLen]
zVixAtR = not na(zVixR) and not na(zVixH) and math.abs(zVixH - zVixR) <= zVixTol
zVixAtS = not na(zVixS) and not na(zVixL) and math.abs(zVixL - zVixS) <= zVixTol
f_vix(dir) =>
    base = dir > 0 ? zVixDn : zVixUp
    lv   = dir > 0 ? zVixAtR : zVixAtS
    zVixLvlOn ? (base and lv) : base

// ── Mag 7 (rule 23) ─────────────────────────────────────────────────
f_m(s) =>
    v = request.security(s, timeframe.period, close, lookahead = barmerge.lookahead_off)
    na(v) or na(v[zMagLen]) ? 0 : v > v[zMagLen] ? 1 : v < v[zMagLen] ? -1 : 0
zA = f_m("NASDAQ:AAPL")
zB = f_m("NASDAQ:MSFT")
zC = f_m("NASDAQ:NVDA")
zD = f_m("NASDAQ:AMZN")
zE = f_m("NASDAQ:META")
zF = f_m("NASDAQ:GOOGL")
zG = f_m("NASDAQ:TSLA")
zMagU = (zA>0?1:0)+(zB>0?1:0)+(zC>0?1:0)+(zD>0?1:0)+(zE>0?1:0)+(zF>0?1:0)+(zG>0?1:0)
zMagD = (zA<0?1:0)+(zB<0?1:0)+(zC<0?1:0)+(zD<0?1:0)+(zE<0?1:0)+(zF<0?1:0)+(zG<0?1:0)
f_mag(dir) => dir > 0 ? zMagU >= zMagMin : zMagD >= zMagMin
zNyMin = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
zUSopen = zNyMin >= 570 and zNyMin < 960 and dayofweek != dayofweek.saturday and dayofweek != dayofweek.sunday
zAvail = not zUSonly or zUSopen

// ════════════════════ THE STATE MACHINE (rule 27) ═══════════════════
// 0 WAIT · 1 APPROACHING · 2 LIQUIDITY TAKEN / MSS WAIT · 3 RETEST WAIT
// 4 CONFIRMED · 5 TRADE ACTIVE · 6 TARGET APPROACHING · 7 TARGET REACHED
var int   zSt   = 0
var int   zDir  = 0
var float zALvl = na
var float zAExt = na
var float zMref = na
var float zEnt  = na
var float zTgt  = na
var float zInv  = na
var int   zBar  = 0
var float zQual = 0.0

zBuy  = false
zSell = false

// structure integrity for an open trade (rules 15, 20)
zStructOk = zDir == 0 ? true : (zDir > 0 ? (na(zSwL) or close > zSwL) : (na(zSwH) or close < zSwH))

if zSt <= 1
    zSt := not na(zLvl) and zDist <= zApproach ? 1 : 0

// rules 5-8: liquidity must be TAKEN, and reclaimed (rule 10)
zSwLo = zSt == 1 and not na(zLvl) and low  < zLvl and close > zLvl
zSwHi = zSt == 1 and not na(zLvl) and high > zLvl and close < zLvl
if zSt == 1
    if zSwLo
        zSt := 2
        zDir := 1
        zALvl := zLvl
        zAExt := low
        zMref := zSwH
        zBar := bar_index
        zQual := zScore
    else if zSwHi
        zSt := 2
        zDir := -1
        zALvl := zLvl
        zAExt := high
        zMref := zSwL
        zBar := bar_index
        zQual := zScore

if zSt == 2
    zAExt := zDir > 0 ? math.min(zAExt, low) : math.max(zAExt, high)
    zDsp = not zDisplOn or (high - low) >= zDispl * zAtr
    if na(zMref)
        zMref := zDir > 0 ? zSwH : zSwL
    zBroke = not na(zMref) and (zDir > 0 ? close > zMref : close < zMref) and zDsp
    if zBroke
        zSt := zRetOn ? 3 : 4
        zBar := bar_index
    else if bar_index - zBar > zMssBars
        zSt := 0
        zDir := 0

if zSt == 3
    zBack = zDir > 0 ? low <= zALvl + zRetTol : high >= zALvl - zRetTol
    zHold = zDir > 0 ? close > zALvl : close < zALvl
    if zBack and zHold and bar_index > zBar
        zSt := 4
    else if not zHold and bar_index > zBar
        zSt := 0
        zDir := 0
    else if bar_index - zBar > zRetBars
        zSt := 0
        zDir := 0

// confidence layers scored, not gating (rule 24)
zVok = zAvail and zVixOn and zDir != 0 ? f_vix(zDir) : false
zGok = zAvail and zMagOn and zDir != 0 ? f_mag(zDir) : false
zExtras = (zVixOn and zVok ? 1 : 0) + (zMagOn and zGok ? 1 : 0)

if zSt == 4
    zPass = not zHardGate or not zAvail or zExtras >= ((zVixOn ? 1 : 0) + (zMagOn ? 1 : 0))
    if zPass
        zBuy  := zDir > 0
        zSell := zDir < 0
        zEnt  := close
        zInv  := zDir > 0 ? zAExt : zAExt
        zTgt  := f_target(zDir, close)
        zQual := zQual + (zVok ? 2.0 : 0.0) + (zGok ? 2.0 : 0.0)
        zSt   := 5
    else
        zSt := 0
        zDir := 0

// rule 15: the thesis persists. Only invalidation or an opposing MSS ends it.
if zSt >= 5
    zHitInv = zDir > 0 ? low <= zInv : high >= zInv
    if zHitInv or not zStructOk
        zSt := 0
        zDir := 0
    else
        if na(zTgt)
            zTgt := f_target(zDir, close)
        if not na(zTgt)
            zReach = zDir > 0 ? high >= zTgt : low <= zTgt
            zNear  = zDir > 0 ? (zTgt - close) <= zTgtNear : (close - zTgt) <= zTgtNear
            if zReach
                // rule 18: TAKE PROFIT / WAIT. rules 19-20: extend if structure holds.
                if zExtend and zStructOk
                    zn = f_target(zDir, zTgt + zDir * 0.01)
                    zTgt := na(zn) ? zTgt : zn
                    zSt := 5
                else
                    zSt := 7
            else
                zSt := zNear ? 6 : 5

zStName = zSt == 0 ? "WAIT" : zSt == 1 ? "APPROACHING AREA" : zSt == 2 ? "LIQUIDITY TAKEN · MSS WAIT" : zSt == 3 ? "RETEST WAIT" : zSt == 5 ? (zDir > 0 ? "TRADE ACTIVE · LONG" : "TRADE ACTIVE · SHORT") : zSt == 6 ? "TARGET APPROACHING" : zSt == 7 ? "TARGET REACHED · TAKE PROFIT / WAIT" : "CONFIRMED"

// ── drawing ─────────────────────────────────────────────────────────
var box[] zBx = array.new_box()
if zShowClu and barstate.islast
    for i = 0 to array.size(zBx) - 1
        box.delete(array.get(zBx, i))
    array.clear(zBx)
    if array.size(zCmid) > 0
        for i = 0 to array.size(zCmid) - 1
            sc = array.get(zCsc, i)
            if sc >= zMinScore
                m = array.get(zCmid, i)
                op = sc >= zTgtMin ? 72 : 86
                array.push(zBx, box.new(bar_index - 250, m + zClustTol, bar_index + 25, m - zClustTol,
                     bgcolor = color.new(sc >= zTgtMin ? color.orange : color.gray, op),
                     border_color = color.new(color.orange, 55),
                     text = str.tostring(sc, "#.#"), text_size = size.tiny,
                     text_color = color.new(color.orange, 20), text_halign = text.align_left))

plotshape(zShowSeq and zSwLo, "sweep low",  shape.xcross, location.belowbar, color.new(color.orange, 0), size = size.tiny)
plotshape(zShowSeq and zSwHi, "sweep high", shape.xcross, location.abovebar, color.new(color.orange, 0), size = size.tiny)
plotshape(zShowSeq and zSt == 3 and zSt[1] == 2, "MSS", shape.diamond, location.absolute, color.new(color.aqua, 0), size = size.tiny)
plotshape(zBuy,  "BUY",  shape.labelup,   location.belowbar, color.new(color.green, 0), text = "BUY",  textcolor = color.white, size = size.small)
plotshape(zSell, "SELL", shape.labeldown, location.abovebar, color.new(color.red, 0),   text = "SELL", textcolor = color.white, size = size.small)
plot(zSt >= 5 ? zTgt : na, "target",       color.new(color.blue, 0),  2, plot.style_linebr)
plot(zSt >= 5 ? zInv : na, "invalidation", color.new(color.red, 20),  2, plot.style_linebr)

f_mk(b) => b ? "✓" : "✗"
f_cl(b) => b ? color.new(color.green, 55) : color.new(color.red, 62)
zGrade = zQual >= 10 ? "A" : zQual >= 7 ? "B" : zQual >= 5 ? "C" : "D"

var table zT = table.new(position.top_right, 3, 10, border_width = 1)
if barstate.islast
    table.cell(zT, 0, 0, "STATE", text_color = color.white, bgcolor = color.new(color.blue, 15))
    table.cell(zT, 1, 0, zStName, text_color = color.white, bgcolor = color.new(color.blue, 15))
    table.cell(zT, 2, 0, zSt >= 4 ? ("grade " + zGrade + "  " + str.tostring(zQual, "#.#")) : "", text_color = color.white, bgcolor = color.new(color.blue, 15))
    table.cell(zT, 0, 1, "1 location")
    table.cell(zT, 1, 1, f_mk(zSt >= 1), bgcolor = f_cl(zSt >= 1))
    table.cell(zT, 2, 1, na(zLvl) ? "no cluster in range" : str.tostring(zLvl, "#.##") + "  score " + str.tostring(zScore, "#.#") + "  d=" + str.tostring(zDist, "#.#"))
    table.cell(zT, 0, 2, "2 liquidity")
    table.cell(zT, 1, 2, f_mk(zSt >= 2), bgcolor = f_cl(zSt >= 2))
    table.cell(zT, 2, 2, zSt >= 2 ? (zDir > 0 ? "sell-side taken · reclaimed" : "buy-side taken · rejected") : "not swept")
    table.cell(zT, 0, 3, "3 structure")
    table.cell(zT, 1, 3, f_mk(zSt >= 3), bgcolor = f_cl(zSt >= 3))
    table.cell(zT, 2, 3, zSt >= 3 ? "shifted with displacement" : zSt == 2 ? "waiting" : "-")
    table.cell(zT, 0, 4, "4 retest")
    table.cell(zT, 1, 4, f_mk(zSt >= 4), bgcolor = f_cl(zSt >= 4))
    table.cell(zT, 2, 4, zSt >= 4 ? "held" : zSt == 3 ? "waiting" : "-")
    table.cell(zT, 0, 5, "5 VIX")
    table.cell(zT, 1, 5, zAvail ? f_mk(zVok) : "n/a", bgcolor = zAvail ? f_cl(zVok) : color.new(color.gray, 62))
    table.cell(zT, 2, 5, (na(zVix) ? "no data" : str.tostring(zVix, "#.##")) + (zVixDn ? " falling" : zVixUp ? " rising" : " flat") + (zVixAtR ? " @res" : zVixAtS ? " @sup" : " mid-nowhere"))
    table.cell(zT, 0, 6, "6 Mag 7")
    table.cell(zT, 1, 6, zAvail ? f_mk(zGok) : "n/a", bgcolor = zAvail ? f_cl(zGok) : color.new(color.gray, 62))
    table.cell(zT, 2, 6, str.tostring(zMagU) + " up / " + str.tostring(zMagD) + " down")
    table.cell(zT, 0, 7, "US hours")
    table.cell(zT, 1, 7, zUSopen ? "OPEN" : "CLOSED", bgcolor = zUSopen ? color.new(color.green, 55) : color.new(color.orange, 45))
    table.cell(zT, 2, 7, zUSopen ? "5 and 6 live" : "5 and 6 STALE — scored unavailable")
    table.cell(zT, 0, 8, "target")
    table.cell(zT, 1, 8, na(zTgt) or zSt < 5 ? "-" : str.tostring(zTgt, "#.##"))
    table.cell(zT, 2, 8, zSt == 7 ? "reached — needs its own setup to reverse (rule 18)" : zSt >= 5 ? "structure " + (zStructOk ? "intact" : "broken") : "")
    table.cell(zT, 0, 9, "invalidation")
    table.cell(zT, 1, 9, na(zInv) or zSt < 5 ? "-" : str.tostring(zInv, "#.##"))
    table.cell(zT, 2, 9, zSt >= 5 ? "thesis holds until this breaks (rule 15)" : "")

alertcondition(zBuy,  "LONG confirmed",  "Location → liquidity → MSS → retest confirmed LONG.")
alertcondition(zSell, "SHORT confirmed", "Location → liquidity → MSS → retest confirmed SHORT.")
alertcondition(zSt == 7 and zSt[1] != 7, "Target reached", "Liquidity target reached — take profit / wait.")
alertcondition(zSt == 2 and zSt[1] != 2, "Liquidity taken", "Liquidity taken at a scored cluster — waiting for the structure shift.")
