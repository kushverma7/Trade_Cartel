//@version=6
indicator("Trade Cartel - KAMA Key Level Signal Engine", shorttitle="TC-KAMA-KL", overlay=true, max_lines_count=100, max_labels_count=200)

// ============================================================
// Built from two user-supplied bases (integrated, math verified,
// credited per project standing rule -- never discard provenance):
//   1. "KL Adaptive MA" (unattributed) -- classic KAMA whose adaptive
//      smoothing constant is damped near HTF key levels. Ported as-is.
//   2. "Key Levels SpacemanBTC IDWM V13.1" (c) @sbtnc, TradingView --
//      only the non-repainting HTF level COMPUTATION is reused (daily/
//      weekly open, PDH/PDL, PWH/PWL, Monday range, Asia/London/NY
//      session ranges). The original's 500+ lines of line/label
//      drawing, level-merge, and display styling are NOT ported --
//      this engine only needs the raw price levels to gate entries.
//      Session windows re-anchored to America/New_York to match every
//      other engine in this repo (source's UTC-ish defaults replaced).
//
// NEW signal logic (not in either source): plain (undamped) KAMA
// crossing the level-damped KAMA, gated to fire ONLY when price sits
// within a proximity zone of an actual key level -- the "wall"
// confluence pattern already used in strategies/reversal_sniper_
// strategy.pine, applied here to a moving-average cross instead of a
// sweep/reject candle. The cross itself is meaningful: it only
// happens when price momentum overpowers the level's damping -- i.e.
// a break/acceptance of that level, not a random MA cross.
//
// UNTESTED -- brand new construct, no backtest yet. Per this
// project's standing rule (2026-07-20 retraction), nothing here is
// "proven" until backtested on a real sample.
// ============================================================

// ── KAMA core ────────────────────────────────────────────────
erLen   = input.int(10, "Efficiency Length", minval=2, group="KAMA Core")
fastLen = input.int(2,  "Fast Length",       minval=1, group="KAMA Core")
slowLen = input.int(30, "Slow Length",       minval=2, group="KAMA Core")

// ── Level-damped KAMA ───────────────────────────────────────
zoneMult = input.float(1.0, "MA Damping Zone (x ATR)", minval=0.1, step=0.1, group="Level-Damped KAMA")

// ── Key levels ───────────────────────────────────────────────
useDaily   = input.bool(true, "Daily Open + PDH/PDL",   group="Key Levels")
useWeekly  = input.bool(true, "Weekly Open + PWH/PWL",  group="Key Levels")
useMonday  = input.bool(true, "Monday Range",           group="Key Levels")
useAsia    = input.bool(true, "Asia Session Range",     group="Key Levels")
useLondon  = input.bool(true, "London Session Range",   group="Key Levels")
useNY      = input.bool(true, "New York Session Range", group="Key Levels")
asiaSess   = input.session("1800-0300", "Asia Session",   group="Key Levels")
londonSess = input.session("0300-1200", "London Session", group="Key Levels")
nySess     = input.session("0800-1700", "New York Session", group="Key Levels")
sessTz     = input.string("America/New_York", "Session Timezone", group="Key Levels")

// ── Signal ───────────────────────────────────────────────────
sigProxMult = input.float(1.0, "Signal Proximity Tolerance (x ATR)", minval=0.1, step=0.1, group="Signal")
cooldown    = input.int(10, "Cooldown Bars", minval=0, group="Signal")

// ── Exits (informational, non-executing) ────────────────────
atrLen      = input.int(14,   "ATR Length",                 group="Exits")
stopAtrMult = input.float(0.5, "Stop Beyond Level (x ATR)", step=0.1, group="Exits")
tpAtrMult   = input.float(2.0, "Target (x ATR)",            step=0.1, group="Exits")

// ── Display ──────────────────────────────────────────────────
showLevels = input.bool(true, "Show Key Levels",       group="Display")
showKama   = input.bool(true, "Show Both KAMA Lines",  group="Display")
showTable  = input.bool(true, "Show Status Table",     group="Display")

// ══ BASICS ════════════════════════════════════════════════════
atr = ta.atr(atrLen)

// ══ KAMA — shared efficiency ratio / smoothing constant ═══════
change     = math.abs(close - close[erLen])
volatility = math.sum(math.abs(close - close[1]), erLen)
er         = volatility != 0 ? change / volatility : 0.0
fastSC     = 2.0 / (fastLen + 1)
slowSC     = 2.0 / (slowLen + 1)
sc         = math.pow(er * (fastSC - slowSC) + slowSC, 2)

// ══ KEY LEVELS (non-repainting HTF idiom, same pattern as
//    reversal_sniper_strategy.pine) ════════════════════════════
dOpen  = request.security(syminfo.tickerid, "D", open,    lookahead=barmerge.lookahead_on)
pdHigh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
pdLow  = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_on)
wOpen  = request.security(syminfo.tickerid, "W", open,    lookahead=barmerge.lookahead_on)
pwHigh = request.security(syminfo.tickerid, "W", high[1], lookahead=barmerge.lookahead_on)
pwLow  = request.security(syminfo.tickerid, "W", low[1],  lookahead=barmerge.lookahead_on)

// Monday range (current week; freezes once Monday ends)
bool isMonday = dayofweek(time, sessTz) == dayofweek.monday
var float monHi = na
var float monLo = na
if isMonday and not isMonday[1]
    monHi := high
    monLo := low
else if isMonday
    monHi := math.max(monHi, high)
    monLo := math.min(monLo, low)

// Session ranges: Asia / London / New York (completed sessions only)
bool inAsia = not na(time(timeframe.period, asiaSess, sessTz))
var float asiaHi = na
var float asiaLo = na
if inAsia and not inAsia[1]
    asiaHi := high
    asiaLo := low
else if inAsia
    asiaHi := math.max(asiaHi, high)
    asiaLo := math.min(asiaLo, low)
bool asiaDone = not inAsia and not na(asiaHi)

bool inLondon = not na(time(timeframe.period, londonSess, sessTz))
var float lonHi = na
var float lonLo = na
if inLondon and not inLondon[1]
    lonHi := high
    lonLo := low
else if inLondon
    lonHi := math.max(lonHi, high)
    lonLo := math.min(lonLo, low)
bool londonDone = not inLondon and not na(lonHi)

bool inNY = not na(time(timeframe.period, nySess, sessTz))
var float nyHi = na
var float nyLo = na
if inNY and not inNY[1]
    nyHi := high
    nyLo := low
else if inNY
    nyHi := math.max(nyHi, high)
    nyLo := math.min(nyLo, low)
bool nyDone = not inNY and not na(nyHi)

// ══ ACTIVE LEVEL SET + NEAREST/PROXIMITY ═══════════════════════
levelArr = array.new_float()
if useDaily
    array.push(levelArr, dOpen)
    array.push(levelArr, pdHigh)
    array.push(levelArr, pdLow)
if useWeekly
    array.push(levelArr, wOpen)
    array.push(levelArr, pwHigh)
    array.push(levelArr, pwLow)
if useMonday and not na(monHi)
    array.push(levelArr, monHi)
    array.push(levelArr, monLo)
if useAsia and asiaDone
    array.push(levelArr, asiaHi)
    array.push(levelArr, asiaLo)
if useLondon and londonDone
    array.push(levelArr, lonHi)
    array.push(levelArr, lonLo)
if useNY and nyDone
    array.push(levelArr, nyHi)
    array.push(levelArr, nyLo)

float nearestLevel = na
float minDist = na
if array.size(levelArr) > 0
    for i = 0 to array.size(levelArr) - 1
        float lv = array.get(levelArr, i)
        if not na(lv)
            float d = math.abs(close - lv)
            if na(minDist) or d < minDist
                minDist := d
                nearestLevel := lv

// levelFactor: 0 near a level (full damping) -> 1 far from all levels (full KAMA speed)
levelFactor = na(minDist) ? 1.0 : math.min(minDist / (atr * zoneMult), 1.0)
bool nearLevel = not na(minDist) and minDist <= atr * sigProxMult

// ══ TWO KAMA LINES ══════════════════════════════════════════════
adaptiveSC = sc * levelFactor

var float kamaPlain    = na
var float kamaAdaptive = na
kamaPlain    := na(kamaPlain)    ? close : kamaPlain    + sc         * (close - kamaPlain)
kamaAdaptive := na(kamaAdaptive) ? close : kamaAdaptive + adaptiveSC * (close - kamaAdaptive)

// ══ SIGNAL — cross only counts when it happens AT a level ══════
bool crossUp   = ta.crossover(kamaPlain, kamaAdaptive)
bool crossDown = ta.crossunder(kamaPlain, kamaAdaptive)

var int lastSigBar = -100000
bool rawBuy  = crossUp   and nearLevel
bool rawSell = crossDown and nearLevel
bool buy  = rawBuy  and (bar_index - lastSigBar) > cooldown
bool sell = rawSell and (bar_index - lastSigBar) > cooldown
if buy or sell
    lastSigBar := bar_index

// ══ SUGGESTED EXITS (informational — plotted, not executed) ════
float longStop  = nearestLevel - atr * stopAtrMult
float longTp    = close + atr * tpAtrMult
float shortStop = nearestLevel + atr * stopAtrMult
float shortTp   = close - atr * tpAtrMult

var line entryLine = na
var line stopLine  = na
var line tpLine    = na
var label sigLabel = na

if buy
    line.delete(entryLine)
    line.delete(stopLine)
    line.delete(tpLine)
    label.delete(sigLabel)
    entryLine := line.new(bar_index, close, bar_index + 20, close, color=color.aqua, style=line.style_dotted)
    stopLine  := line.new(bar_index, longStop, bar_index + 20, longStop, color=color.red, style=line.style_dashed)
    tpLine    := line.new(bar_index, longTp, bar_index + 20, longTp, color=color.lime, style=line.style_dashed)
    sigLabel  := label.new(bar_index, close, "BUY\nSL " + str.tostring(longStop, format.mintick) + "\nTP " + str.tostring(longTp, format.mintick),
         style=label.style_label_up, location=location.belowbar, color=color.new(color.aqua, 0), textcolor=color.black, size=size.small)

if sell
    line.delete(entryLine)
    line.delete(stopLine)
    line.delete(tpLine)
    label.delete(sigLabel)
    entryLine := line.new(bar_index, close, bar_index + 20, close, color=color.yellow, style=line.style_dotted)
    stopLine  := line.new(bar_index, shortStop, bar_index + 20, shortStop, color=color.red, style=line.style_dashed)
    tpLine    := line.new(bar_index, shortTp, bar_index + 20, shortTp, color=color.lime, style=line.style_dashed)
    sigLabel  := label.new(bar_index, close, "SELL\nSL " + str.tostring(shortStop, format.mintick) + "\nTP " + str.tostring(shortTp, format.mintick),
         style=label.style_label_down, location=location.abovebar, color=color.new(color.yellow, 0), textcolor=color.black, size=size.small)

// ══ PLOTS ═══════════════════════════════════════════════════════
plot(showKama ? kamaPlain    : na, "KAMA (plain)",        color=color.new(color.gray, 30), linewidth=1)
plot(showKama ? kamaAdaptive : na, "KAMA (level-damped)", color=kamaAdaptive > kamaAdaptive[1] ? color.green : color.red, linewidth=2)

plot(showLevels and useDaily  ? dOpen  : na, "Daily Open",  color=color.new(color.aqua, 40),    style=plot.style_linebr)
plot(showLevels and useDaily  ? pdHigh : na, "PDH",         color=color.new(color.orange, 55),  style=plot.style_linebr)
plot(showLevels and useDaily  ? pdLow  : na, "PDL",         color=color.new(color.orange, 55),  style=plot.style_linebr)
plot(showLevels and useWeekly ? wOpen  : na, "Weekly Open", color=color.new(color.fuchsia, 40), style=plot.style_linebr)
plot(showLevels and useWeekly ? pwHigh : na, "PWH",         color=color.new(color.fuchsia, 55), style=plot.style_linebr)
plot(showLevels and useWeekly ? pwLow  : na, "PWL",         color=color.new(color.fuchsia, 55), style=plot.style_linebr)
plot(showLevels and useMonday ? monHi  : na, "Monday High", color=color.new(color.white, 55),   style=plot.style_linebr)
plot(showLevels and useMonday ? monLo  : na, "Monday Low",  color=color.new(color.white, 55),   style=plot.style_linebr)
plot(showLevels and useAsia   ? asiaHi : na, "Asia High",   color=color.new(color.silver, 55),  style=plot.style_linebr)
plot(showLevels and useAsia   ? asiaLo : na, "Asia Low",    color=color.new(color.silver, 55),  style=plot.style_linebr)
plot(showLevels and useLondon ? lonHi  : na, "London High", color=color.new(color.blue, 55),    style=plot.style_linebr)
plot(showLevels and useLondon ? lonLo  : na, "London Low",  color=color.new(color.blue, 55),    style=plot.style_linebr)
plot(showLevels and useNY     ? nyHi   : na, "NY High",     color=color.new(color.purple, 55),  style=plot.style_linebr)
plot(showLevels and useNY     ? nyLo   : na, "NY Low",      color=color.new(color.purple, 55),  style=plot.style_linebr)

plotshape(buy,  "BUY",  style=shape.triangleup,   location=location.belowbar, color=color.aqua,   size=size.small)
plotshape(sell, "SELL", style=shape.triangledown, location=location.abovebar, color=color.yellow, size=size.small)

// ══ STATUS TABLE ════════════════════════════════════════════════
if showTable and barstate.islast
    var table dash = table.new(position.top_right, 2, 4, border_width = 1)
    table.cell(dash, 0, 0, "KAMA / Key Level", bgcolor = color.new(color.purple, 60), text_color = color.white)
    table.cell(dash, 1, 0, "", bgcolor = color.new(color.purple, 60))
    table.cell(dash, 0, 1, "Trend")
    table.cell(dash, 1, 1, kamaAdaptive > kamaAdaptive[1] ? "bullish" : "bearish", text_color = kamaAdaptive > kamaAdaptive[1] ? color.green : color.red)
    table.cell(dash, 0, 2, "Nearest Level")
    table.cell(dash, 1, 2, na(nearestLevel) ? "n/a" : str.tostring(nearestLevel, format.mintick))
    table.cell(dash, 0, 3, "At Level?")
    table.cell(dash, 1, 3, nearLevel ? "YES" : "no", text_color = nearLevel ? color.orange : color.gray)

// ══ ALERTS ═══════════════════════════════════════════════════════
alertcondition(buy,  "KAMA-KL BUY",  "TC KAMA Key Level -- BUY at key level -- {{ticker}} {{interval}}")
alertcondition(sell, "KAMA-KL SELL", "TC KAMA Key Level -- SELL at key level -- {{ticker}} {{interval}}")
