//@version=6
indicator("Trade Cartel - Gann Square of Nine Engine", shorttitle="TC-GannSQ9", overlay=true, max_lines_count=300, max_labels_count=300)

// =====================================================================
// Voice #16 -- "Trading the Gann Square of Nine" (TradingFives, 2003)
// + W.D. Gann's own 1953 appendix notes (squares-1-to-19 watchlist only;
// the Master-144 numerology is explicitly NOT implemented, see playbook).
// One brain per voice -- extend this file in place for future Gann
// material, never fork a second Gann .pine.
//
// v2 (2026-07-20, "The W.D. Gann Master Commodities Course" -- Gann's
// own original grain/cotton/egg/soybean courses, 16,230 lines, read in
// full). Two genuinely new mechanics added, both explicitly absent from
// the TradingFives book (which said outright it makes "no claims" about
// Gann Angles): a true Gann Angle fan (1x1/2x1/4x1/8x1) from the shared
// major-pivot anchor, and a Signal Day single-bar reversal tag. A wide
// range of other course material (numbered trading/pyramiding rules,
// decades of seasonal/anniversary time-cycle tables for grains/cotton/
// eggs, the Hexagon Chart, Master 12/144 charts) is deliberately NOT
// built -- see trader_playbooks/gann_square_of_nine.md for the full
// writeup of what's there and why each piece was or wasn't coded.
// =====================================================================

grpAnchor = "Anchor / Major Pivot"
anchorMode = input.string("Auto (major swing)", "Anchor mode", options = ["Auto (major swing)", "Manual anchor"], group = grpAnchor)
majorLookback = input.int(200, "Auto: lookback bars for major swing", minval = 20, group = grpAnchor)
manualAnchorPrice = input.float(0.0, "Manual anchor price (0 = ignore)", group = grpAnchor)
manualAnchorBarsAgo = input.int(0, "Manual anchor bars ago", minval = 0, group = grpAnchor)
manualAnchorIsLow = input.bool(true, "Manual anchor is a swing LOW (uptrend roadmap)", group = grpAnchor)

grpGrid = "Square of Nine Grid"
gridDeg = input.float(180.0, "Horizontal grid step (degrees)", options = [45.0, 90.0, 135.0, 180.0], group = grpGrid)
numRotations = input.int(4, "Number of rotations to plot", minval = 1, maxval = 8, group = grpGrid)
showMid = input.bool(true, "Show 90-degree midpoint lines", group = grpGrid)
useThreeDigit = input.bool(true, "Auto-normalize price to 3 significant digits (untested on gold, see playbook)", group = grpGrid)
showRoadmap = input.bool(true, "Draw vertical time grid + diagonal channel", group = grpGrid)

grpSquare = "Squaring Price & Time"
showSquaring = input.bool(true, "Detect price-range = time squaring at swing pivots", group = grpSquare)
pivotWidth = input.int(10, "Pivot width (bars) for swing detection", minval = 2, group = grpSquare)
degTol = input.float(5.0, "Degree tolerance for a 'square' hit", minval = 1.0, maxval = 15.0, group = grpSquare)

grpTime = "Gann Time Counts (source watchlists)"
showTimeCounts = input.bool(true, "Flag bars-since-anchor on Gann's own squares watchlist", group = grpTime)
showMinorTime = input.bool(true, "Flag bars-since-last-swing on Gann's minor time-rule counts (v2)", group = grpTime)

grpAngle = "Gann Angle Fan (v2, Master Commodities Course Ch.5A/5B)"
showAngles = input.bool(true, "Show 1x1/2x1/4x1/8x1 angle fan from anchor", group = grpAngle)
angle1x1Rate = input.float(0.0, "1x1 rate, price/bar (0 = auto from ATR)", group = grpAngle)
autoAngleMult = input.float(0.25, "Auto rate = ATR(14) x this", minval = 0.05, step = 0.05, group = grpAngle)

grpSignal = "Signal Day (v2, Master Commodities Course)"
showSignalDay = input.bool(true, "Show Signal Day reversal tags", group = grpSignal)
signalLookback = input.int(5, "New-extreme lookback (bars)", minval = 2, group = grpSignal)

grpShow = "Display"
showTable = input.bool(true, "Show status table", group = grpShow)

// ---------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------
f_normFactor(_price) =>
    float p = _price
    float f = 1.0
    for i = 1 to 6
        if p >= 1000
            p := p / 10
            f := f / 10
    for i = 1 to 6
        if p < 100
            p := p * 10
            f := f * 10
    f

f_sqRotateDeg(_price, _deg) =>
    f = useThreeDigit ? f_normFactor(_price) : 1.0
    np = _price * f
    factor = _deg / 180.0
    base = math.sqrt(np) + factor
    nr = base > 0 ? math.pow(base, 2) : 0.0
    nr / f

f_toDegrees(_n) =>
    d = (math.sqrt(_n) * 180.0) - 225.0
    d := d % 360.0
    if d < 0
        d += 360.0
    d

f_toDegreesNorm(_n) =>
    f = useThreeDigit ? f_normFactor(_n) : 1.0
    f_toDegrees(_n * f)

f_squareCloseness(_d1, _d2) =>
    diff = math.abs(_d1 - _d2) % 360.0
    if diff > 180.0
        diff := 360.0 - diff
    rem = diff % 90.0
    math.min(rem, 90.0 - rem)

// ---------------------------------------------------------------------
// Anchor determination (recomputed every bar; redraw only fires on change)
// ---------------------------------------------------------------------
float anchorPrice = na
int anchorBarIdx = na
bool anchorIsLow = true

if anchorMode == "Manual anchor" and manualAnchorPrice > 0
    anchorPrice := manualAnchorPrice
    anchorBarIdx := bar_index - manualAnchorBarsAgo
    anchorIsLow := manualAnchorIsLow
else
    hhOffset = ta.highestbars(high, majorLookback)
    llOffset = ta.lowestbars(low, majorLookback)
    hh = ta.highest(high, majorLookback)
    ll = ta.lowest(low, majorLookback)
    if hhOffset > llOffset
        anchorPrice := hh
        anchorBarIdx := bar_index + hhOffset
        anchorIsLow := false
    else
        anchorPrice := ll
        anchorBarIdx := bar_index + llOffset
        anchorIsLow := true

// ---------------------------------------------------------------------
// Roadmap chart: redraw only when the anchor changes
// ---------------------------------------------------------------------
var line[] hLines = array.new_line()
var line[] midLines = array.new_line()
var line[] vLines = array.new_line()
var line[] chLines = array.new_line()
var label[] hLabels = array.new_label()
var label anchorLabel = na

var float vAnchorPrice = na
var int vAnchorBarIdx = na
var bool vAnchorIsLow = true
var int vVertSpacing = na
var float vSlope = na
var float vChBaseLow = na
var float vChBaseHigh = na

var int lastAnchorBarIdx = na
anchorChanged = anchorBarIdx != lastAnchorBarIdx and not na(anchorPrice)

if anchorChanged
    if array.size(hLines) > 0
        for i = 0 to array.size(hLines) - 1
            line.delete(array.get(hLines, i))
        array.clear(hLines)
    if array.size(midLines) > 0
        for i = 0 to array.size(midLines) - 1
            line.delete(array.get(midLines, i))
        array.clear(midLines)
    if array.size(vLines) > 0
        for i = 0 to array.size(vLines) - 1
            line.delete(array.get(vLines, i))
        array.clear(vLines)
    if array.size(chLines) > 0
        for i = 0 to array.size(chLines) - 1
            line.delete(array.get(chLines, i))
        array.clear(chLines)
    if array.size(hLabels) > 0
        for i = 0 to array.size(hLabels) - 1
            label.delete(array.get(hLabels, i))
        array.clear(hLabels)
    if not na(anchorLabel)
        label.delete(anchorLabel)

    lastAnchorBarIdx := anchorBarIdx
    vAnchorPrice := anchorPrice
    vAnchorBarIdx := anchorBarIdx
    vAnchorIsLow := anchorIsLow

    f = useThreeDigit ? f_normFactor(anchorPrice) : 1.0
    vertSpacing = int(math.round(math.sqrt(anchorPrice * f)))
    vVertSpacing := math.max(vertSpacing, 1)

    dir = anchorIsLow ? 1 : -1
    endBar = anchorBarIdx + vVertSpacing * (numRotations + 2)

    level1 = f_sqRotateDeg(anchorPrice, gridDeg * 1 * dir)
    level2 = f_sqRotateDeg(anchorPrice, gridDeg * 2 * dir)
    vSlope := (level1 - anchorPrice) / vVertSpacing

    anchorLabel := label.new(anchorBarIdx, anchorPrice, anchorIsLow ? "GANN ANCHOR (low)" : "GANN ANCHOR (high)", style = anchorIsLow ? label.style_label_up : label.style_label_down, color = color.new(color.blue, 20), textcolor = color.white, size = size.small)

    for r = 1 to numRotations
        deg = gridDeg * r * dir
        levelPrice = f_sqRotateDeg(anchorPrice, deg)
        hLine = line.new(anchorBarIdx, levelPrice, endBar, levelPrice, color = color.new(color.orange, 20), width = 1)
        array.push(hLines, hLine)
        hLbl = label.new(anchorBarIdx, levelPrice, str.tostring(math.round(deg)) + "°", style = label.style_label_right, color = color.new(color.orange, 100), textcolor = color.orange, size = size.tiny)
        array.push(hLabels, hLbl)
        if showMid
            midDeg = deg - (gridDeg / 2.0) * dir
            midPrice = f_sqRotateDeg(anchorPrice, midDeg)
            mLine = line.new(anchorBarIdx, midPrice, endBar, midPrice, color = color.new(color.orange, 70), width = 1, style = line.style_dotted)
            array.push(midLines, mLine)

    if showRoadmap
        for v = 1 to numRotations + 2
            vBar = anchorBarIdx + vVertSpacing * v
            vLine = line.new(vBar, anchorPrice, vBar, anchorPrice + dir * 1.0, extend = extend.both, color = color.new(color.gray, 60), style = line.style_dotted)
            array.push(vLines, vLine)

        ch1 = line.new(anchorBarIdx, anchorPrice, endBar, anchorPrice + vSlope * (endBar - anchorBarIdx), color = color.new(color.teal, 30), width = 1)
        ch2 = line.new(anchorBarIdx, level1, endBar, level1 + vSlope * (endBar - anchorBarIdx), color = color.new(color.teal, 30), width = 1)
        ch3 = line.new(anchorBarIdx, level2, endBar, level2 + vSlope * (endBar - anchorBarIdx), color = color.new(color.teal, 30), width = 1)
        array.push(chLines, ch1)
        array.push(chLines, ch2)
        array.push(chLines, ch3)
        vChBaseLow := anchorPrice
        vChBaseHigh := level2

// ---------------------------------------------------------------------
// Outer-channel breach (trend invalidation, 2-consecutive-close rule)
// ---------------------------------------------------------------------
f_boundAtBar(_startY) =>
    float result = na
    if not na(vSlope) and not na(vAnchorBarIdx)
        result := _startY + vSlope * (bar_index - vAnchorBarIdx)
    result

lowerBound = f_boundAtBar(vChBaseLow)
upperBound = f_boundAtBar(vChBaseHigh)

channelBreachRaw = showRoadmap and not na(vSlope) and (vAnchorIsLow ? close < lowerBound : close > upperBound)

var int breachCount = 0
breachCount := channelBreachRaw ? breachCount + 1 : 0
channelInvalidated = breachCount >= 2

// ---------------------------------------------------------------------
// v2: Gann Angle Fan (1x1, 2x1, 4x1, 8x1 -- the "geometric angles" the
// TradingFives Square-of-Nine book explicitly did not cover). Drawn
// from the SAME major-pivot anchor as the Roadmap chart. Gann's own
// rule was to pick a price-per-bar scale where the 45-degree (1x1)
// angle "looks right" against the chart -- an explicit discretionary
// choice, same spirit as the three-digit-controversy normalization
// already used elsewhere in this engine. Default here: ATR(14) x a
// user multiplier, our own convention, not a source-given constant.
// ---------------------------------------------------------------------
var line[] angleLines = array.new_line()
var label[] angleLabels = array.new_label()
var float vAngleRate = na

if anchorChanged
    if array.size(angleLines) > 0
        for i = 0 to array.size(angleLines) - 1
            line.delete(array.get(angleLines, i))
        array.clear(angleLines)
    if array.size(angleLabels) > 0
        for i = 0 to array.size(angleLabels) - 1
            label.delete(array.get(angleLabels, i))
        array.clear(angleLabels)

    vAngleRate := angle1x1Rate > 0 ? angle1x1Rate : atrv * autoAngleMult

    if showAngles and vAngleRate > 0
        dir2 = vAnchorIsLow ? 1 : -1
        angleEndBar = vAnchorBarIdx + vVertSpacing * (numRotations + 2)
        angleMults = array.from(0.125, 0.25, 0.5, 1.0, 2.0, 4.0, 8.0)
        for i = 0 to array.size(angleMults) - 1
            mult = array.get(angleMults, i)
            rate = vAngleRate * mult * dir2
            endY = vAnchorPrice + rate * (angleEndBar - vAnchorBarIdx)
            aLine = line.new(vAnchorBarIdx, vAnchorPrice, angleEndBar, endY, color = color.new(mult == 1.0 ? color.red : color.fuchsia, mult == 1.0 ? 0 : 55), width = mult == 1.0 ? 2 : 1)
            array.push(angleLines, aLine)
            angleName = mult >= 1.0 ? str.tostring(math.round(mult)) + "x1" : "1x" + str.tostring(math.round(1.0 / mult))
            aLbl = label.new(angleEndBar, endY, angleName, style = label.style_label_left, color = color.new(color.fuchsia, 100), textcolor = color.fuchsia, size = size.tiny)
            array.push(angleLabels, aLbl)

f_angleAtBar(_mult) =>
    float result = na
    if not na(vAngleRate) and not na(vAnchorBarIdx)
        dir2 = vAnchorIsLow ? 1 : -1
        result := vAnchorPrice + vAngleRate * _mult * dir2 * (bar_index - vAnchorBarIdx)
    result

// position-in-the-fan readout: highest angle multiple currently held
// (bull anchor) or lowest multiple currently broken below (bear anchor)
f_angleStrength() =>
    string strength = "below 1x1 (weak)"
    if showAngles and not na(vAngleRate)
        if vAnchorIsLow
            if close > f_angleAtBar(8.0)
                strength := "above 8x1 (strongest)"
            else if close > f_angleAtBar(4.0)
                strength := "above 4x1"
            else if close > f_angleAtBar(2.0)
                strength := "above 2x1"
            else if close > f_angleAtBar(1.0)
                strength := "above 1x1"
        else
            if close < f_angleAtBar(8.0)
                strength := "below -8x1 (weakest)"
            else if close < f_angleAtBar(4.0)
                strength := "below -4x1"
            else if close < f_angleAtBar(2.0)
                strength := "below -2x1"
            else if close < f_angleAtBar(1.0)
                strength := "below -1x1"
            else
                strength := "above -1x1 (strong)"
    strength

angleStrength = f_angleStrength()

// "rule of all angles": breaking below any held angle indicates decline
// to the next angle below it (source, verbatim, quoted in playbook)
angle1x1Val = f_angleAtBar(1.0)
angleBreak = showAngles and not na(angle1x1Val) and ((vAnchorIsLow and ta.crossunder(close, angle1x1Val)) or (not vAnchorIsLow and ta.crossover(close, angle1x1Val)))

// ---------------------------------------------------------------------
// v2: Signal Day -- single-bar reversal tag, quoted verbatim across the
// Master Commodities Course (grain/cotton/egg chapters alike): a new
// N-bar extreme that closes in the WEAK half of its own range (or
// beyond the open) is read as a reversal, no confirmation bar needed.
// ---------------------------------------------------------------------
newHighBar = high >= ta.highest(high, signalLookback)
newLowBar = low <= ta.lowest(low, signalLookback)
midBar = (high + low) / 2.0

signalDayBear = showSignalDay and newHighBar and (close < midBar or close < open)
signalDayBull = showSignalDay and newLowBar and (close > midBar or close > open)

if signalDayBear
    label.new(bar_index, high, "Signal Day ▼", style = label.style_label_down, color = color.new(color.orange, 20), textcolor = color.white, size = size.tiny, tooltip = "New " + str.tostring(signalLookback) + "-bar high, closed in the weak half of its range or below the open -- Gann's Signal Day, source treats as an immediate reversal cue, no confirmation bar required.")
if signalDayBull
    label.new(bar_index, low, "Signal Day ▲", style = label.style_label_up, color = color.new(color.orange, 20), textcolor = color.white, size = size.tiny, tooltip = "New " + str.tostring(signalLookback) + "-bar low, closed in the strong half of its range or above the open -- Gann's Signal Day.")

// ---------------------------------------------------------------------
// Squaring price with time at confirmed swing pivots
// ---------------------------------------------------------------------
ph = ta.pivothigh(pivotWidth, pivotWidth)
pl = ta.pivotlow(pivotWidth, pivotWidth)

var float lastPivotPrice = na
var int lastPivotBar = na

var bool squareHitBar = false
squareHitBar := false

if not na(ph)
    curBar = bar_index - pivotWidth
    if not na(lastPivotPrice)
        priceRange = math.abs(ph - lastPivotPrice)
        td = curBar - lastPivotBar
        if priceRange > 0 and td > 0
            rangeDeg = f_toDegreesNorm(priceRange)
            timeDeg = f_toDegrees(td)
            closeness = f_squareCloseness(rangeDeg, timeDeg)
            if closeness <= degTol
                squareHitBar := true
                if showSquaring
                    label.new(curBar, ph, "SQ " + str.tostring(closeness, "#.#") + "°", style = label.style_label_down, color = color.new(color.purple, 20), textcolor = color.white, size = size.tiny)
    lastPivotPrice := ph
    lastPivotBar := curBar

if not na(pl)
    curBar = bar_index - pivotWidth
    if not na(lastPivotPrice)
        priceRange = math.abs(pl - lastPivotPrice)
        td = curBar - lastPivotBar
        if priceRange > 0 and td > 0
            rangeDeg = f_toDegreesNorm(priceRange)
            timeDeg = f_toDegrees(td)
            closeness = f_squareCloseness(rangeDeg, timeDeg)
            if closeness <= degTol
                squareHitBar := true
                if showSquaring
                    label.new(curBar, pl, "SQ " + str.tostring(closeness, "#.#") + "°", style = label.style_label_up, color = color.new(color.purple, 20), textcolor = color.white, size = size.tiny)
    lastPivotPrice := pl
    lastPivotBar := curBar

// ---------------------------------------------------------------------
// Gann's own squares-1-to-19 bar-count watchlist (appendix, 1953 letter)
// ---------------------------------------------------------------------
var int[] masterSquares = array.from(16, 25, 36, 49, 64, 81, 100, 121, 144, 169, 196, 225, 256, 289, 324, 361)

barsSinceAnchor = na(vAnchorBarIdx) ? na : bar_index - vAnchorBarIdx
isTimeCountHit = showTimeCounts and not na(barsSinceAnchor) and barsSinceAnchor > 0 and array.includes(masterSquares, barsSinceAnchor)

if isTimeCountHit
    label.new(bar_index, high, "T=" + str.tostring(barsSinceAnchor), style = label.style_label_down, color = color.new(color.yellow, 30), textcolor = color.black, size = size.tiny)

// ---------------------------------------------------------------------
// v2: Gann's "minor time rule" bar counts (Master Commodities Course --
// distinct list from the 1953-letter squares watchlist above; tied to
// the most recent confirmed swing pivot, not the major anchor, matching
// the source's own framing ("watch for a minor change every 7, 10, 14,
// 20-21, 28, 30 days... seven weeks or 49 days usually marks the
// culmination of a rapid move"). Bars stand in for the source's days --
// untested whether that translation holds on a 5m chart, same caveat
// as the rest of this engine's timeframe-jump risk.
// ---------------------------------------------------------------------
var int[] minorTimeNums = array.from(7, 10, 14, 20, 21, 28, 30, 45, 49, 63, 66, 70, 84, 90)
barsSincePivot = na(lastPivotBar) ? na : bar_index - lastPivotBar
isMinorTimeHit = showMinorTime and not na(barsSincePivot) and barsSincePivot > 0 and array.includes(minorTimeNums, barsSincePivot)

if isMinorTimeHit
    label.new(bar_index, low, "t=" + str.tostring(barsSincePivot), style = label.style_label_up, color = color.new(color.aqua, 40), textcolor = color.black, size = size.tiny, tooltip = "Bars since last confirmed swing pivot landed on one of Gann's minor time-rule counts (7,10,14,20,21,28,30,45,49,63,66,70,84,90).")

// ---------------------------------------------------------------------
// Status table
// ---------------------------------------------------------------------
if showTable and barstate.islast
    var table dash = table.new(position.top_right, 2, 6, border_width = 1)
    table.cell(dash, 0, 0, "Gann Sq9", bgcolor = color.new(color.blue, 60), text_color = color.white)
    table.cell(dash, 1, 0, vAnchorIsLow ? "UP roadmap" : "DOWN roadmap", bgcolor = color.new(color.blue, 60), text_color = color.white)
    table.cell(dash, 0, 1, "Anchor price")
    table.cell(dash, 1, 1, na(vAnchorPrice) ? "n/a" : str.tostring(vAnchorPrice))
    table.cell(dash, 0, 2, "Vert spacing (bars)")
    table.cell(dash, 1, 2, na(vVertSpacing) ? "n/a" : str.tostring(vVertSpacing))
    table.cell(dash, 0, 3, "Bars since anchor")
    table.cell(dash, 1, 3, na(barsSinceAnchor) ? "n/a" : str.tostring(barsSinceAnchor))
    table.cell(dash, 0, 5, "Angle position")
    table.cell(dash, 1, 5, angleStrength)
    table.cell(dash, 0, 4, "Channel")
    table.cell(dash, 1, 4, channelInvalidated ? "BREACHED" : "intact", text_color = channelInvalidated ? color.red : color.green)

// ---------------------------------------------------------------------
// Alerts
// ---------------------------------------------------------------------
alertcondition(channelInvalidated, "Gann Roadmap Channel Breach", "Square of Nine roadmap channel invalidated on 2 consecutive closes -- possible trend change")
alertcondition(squareHitBar, "Gann Price=Time Squaring", "Price range and elapsed time squared within tolerance at a confirmed swing pivot")
alertcondition(isTimeCountHit, "Gann Master Number Time Count", "Bars-since-anchor landed on one of Gann's own squares-1-to-19 watchlist numbers")
alertcondition(isMinorTimeHit, "Gann Minor Time Rule Count", "Bars-since-last-pivot landed on one of Gann's minor time-rule counts (7,10,14,20,21,28,30,45,49,63,66,70,84,90)")
alertcondition(angleBreak, "Gann 1x1 Angle Break", "Price crossed the 1x1 (45-degree, 'death angle') from the current anchor -- 'the rule of all angles': indicates a move to the next angle below")
alertcondition(signalDayBear, "Gann Signal Day (bearish)", "New N-bar high closed in the weak half of its range or below the open -- Gann's Signal Day")
alertcondition(signalDayBull, "Gann Signal Day (bullish)", "New N-bar low closed in the strong half of its range or above the open -- Gann's Signal Day")
