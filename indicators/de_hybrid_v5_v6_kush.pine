//@version=6
indicator("DE Hybrid: V5 Entry + V6 X Exit [Kush]", shorttitle="DE·V5/V6", overlay=true, max_labels_count=300)

// ① Supertrend
st_len  = input.int(97, "ATR Period", group="① Supertrend")
st_mult = input.float(4.0, "Multiplier", group="① Supertrend", step=0.1)

// ② AlphaTrend
at_period = input.int(14, "Period", group="② AlphaTrend")
at_coeff  = input.float(1.0, "Coefficient", group="② AlphaTrend", step=0.1)
no_vol_at = input.bool(false, "No Volume (use RSI)", group="② AlphaTrend")

// ③ BBSR
ema_bbsr = input.int(200, "EMA Period", group="③ BBSR EMA")

// ④ EMA Stack
ema_fast = input.int(9, "EMA Fast", group="④ EMA Stack")
ema_mid  = input.int(21, "EMA Mid", group="④ EMA Stack")
ema_slow = input.int(50, "EMA Slow", group="④ EMA Stack")

// ⑤ RSI
rsi_len = input.int(14, "Length", group="⑤ RSI")
rsi_ob  = input.int(60, "Overbought", group="⑤ RSI", minval=55, maxval=80)
rsi_os  = input.int(40, "Oversold", group="⑤ RSI", minval=20, maxval=45)

// ⑥ MACD
macd_f   = input.int(8, "Fast", group="⑥ MACD")
macd_s   = input.int(17, "Slow", group="⑥ MACD")
macd_sig = input.int(9, "Signal", group="⑥ MACD")

// ⑦ Volatility Gate
ag_len  = input.int(14, "ATR Length", group="⑦ Volatility Gate")
ag_mult = input.float(1.0, "ATR Expansion Mult", group="⑦ Volatility Gate", step=0.1)
bb_len  = input.int(20, "BB Length", group="⑦ Volatility Gate")
bb_mult = input.float(2.0, "BB StdDev", group="⑦ Volatility Gate", step=0.1)
use_vg  = input.bool(true, "Require Vol Expansion", group="⑦ Volatility Gate")

// ⑧ Sweep
liq_lb = input.int(20, "Lookback", group="⑧ Sweep", minval=5, maxval=50)
sw_age = input.int(5, "Max Sweep Age", group="⑧ Sweep", minval=1, maxval=20)

// ⑨ Volume
vol_len = input.int(20, "MA Length", group="⑨ Volume")
vol_thr = input.float(1.1, "Surge Multiplier", group="⑨ Volume", step=0.1)
use_vol = input.bool(false, "Require Volume Surge", group="⑨ Volume")

// ⑩ Engine
min_conf  = input.int(3, "Min Confluences", group="⑩ Engine", minval=1, maxval=5)
use_trend = input.bool(true, "Enable Trend Engine", group="⑩ Engine")
use_rev   = input.bool(true, "Enable Reversal Engine", group="⑩ Engine")
cooldown  = input.int(5, "Signal Cooldown", group="⑩ Engine", minval=1, maxval=30)

// ⑪ Session
use_sess   = input.bool(false, "Session Filter", group="⑪ Session")
sess_start = input.int(700, "Session Start HHMM", group="⑪ Session", minval=0, maxval=2359)
sess_end   = input.int(1700, "Session End HHMM", group="⑪ Session", minval=0, maxval=2359)

// ⑫ V6 X Exit
exit_atr_len      = input.int(14, "Exit ATR Length", group="⑫ V6 X Exit")
giveback_atr      = input.float(0.8, "Profit Giveback ATR", group="⑫ V6 X Exit", step=0.1)
use_giveback_exit = input.bool(true, "Use Profit Giveback X", group="⑫ V6 X Exit")
use_ema21_exit    = input.bool(true, "Use EMA21 Break X", group="⑫ V6 X Exit")
use_mom_exit      = input.bool(true, "Use Momentum Loss X", group="⑫ V6 X Exit")
use_at_exit       = input.bool(true, "Use AlphaTrend Flip X", group="⑫ V6 X Exit")
use_sweep_exit    = input.bool(true, "Use Opposite Sweep X", group="⑫ V6 X Exit")
min_bars_exit     = input.int(1, "Min Bars Before X", group="⑫ V6 X Exit", minval=1, maxval=20)

// ⑬ Colours
c_bull = input.color(color.new(#00FFBB, 0), "Bull", group="⑬ Colours")
c_bear = input.color(color.new(#FF3D57, 0), "Bear", group="⑬ Colours")
c_rev  = input.color(color.new(#FFD700, 0), "Reversal", group="⑬ Colours")

// ─── SUPERTREND
[st_line, st_dir] = ta.supertrend(st_mult, st_len)
st_bull = st_dir == -1
st_bear = st_dir == 1

// ─── ALPHATREND
at_atr = ta.sma(ta.tr(true), at_period)
upT = low - at_atr * at_coeff
downT = high + at_atr * at_coeff

mom_bull = no_vol_at ? ta.rsi(close, at_period) >= 50 : ta.mfi(hlc3, at_period) >= 50

var float AT = na
AT := mom_bull ? (upT < nz(AT[1]) ? nz(AT[1]) : upT) : (downT > nz(AT[1]) ? nz(AT[1]) : downT)

at_bull = AT > AT[2]
at_bear = AT < AT[2]
at_flip_bull = AT > AT[2] and AT[1] <= AT[3]
at_flip_bear = AT < AT[2] and AT[1] >= AT[3]
at_cont_bull = at_bull and AT[2] > AT[4]
at_cont_bear = at_bear and AT[2] < AT[4]

// ─── BBSR
bbsr = ta.ema(close, ema_bbsr)
above_bbsr = close > bbsr
below_bbsr = close < bbsr

// ─── EMA STACK
ef = ta.ema(close, ema_fast)
em = ta.ema(close, ema_mid)
es = ta.ema(close, ema_slow)

ema50_rising = es > es[3]
ema50_fall = es < es[3]
ema9_up = ef > ef[1] and ef[1] > ef[2]
ema9_down = ef < ef[1] and ef[1] < ef[2]

// ─── RSI
rsi = ta.rsi(close, rsi_len)
rsi_bull_z = rsi > 45 and rsi < 70
rsi_bear_z = rsi < 55 and rsi > 30
rsi_rev_bull = rsi < rsi_os and rsi > rsi[1]
rsi_rev_bear = rsi > rsi_ob and rsi < rsi[1]

// ─── MACD
[ml, sl2, mh] = ta.macd(close, macd_f, macd_s, macd_sig)
macd_bull = ml > sl2
macd_bear = ml < sl2

// ─── VOLATILITY GATE
agv = ta.atr(ag_len)
aga = ta.sma(agv, 50)
axp = agv > aga * ag_mult

[bbu, bbs, bbl] = ta.bb(close, bb_len, bb_mult)

vgb = not use_vg or (axp and close > bbs)
vgs = not use_vg or (axp and close < bbs)

// ─── SWEEP
rph = ta.highest(high[1], liq_lb)
rpl = ta.lowest(low[1], liq_lb)

swb = low < rpl and close > rpl
sws = high > rph and close < rph

var int sba = 9999
var int ssa = 9999
sba := swb ? 0 : sba + 1
ssa := sws ? 0 : ssa + 1

rsb = sba <= sw_age
rss = ssa <= sw_age

// ─── VOLUME
vma = ta.sma(volume, vol_len)
vsg = volume > vma * vol_thr
vok = not use_vol or vsg

// ─── SESSION
hhmm = hour * 100 + minute
ins = not use_sess or (hhmm >= sess_start and hhmm < sess_end)

// ─── COOLDOWN
var int bss = cooldown + 1
bss := bss + 1
cd = bss > cooldown

// ─── ORIGINAL V5 SIGNAL ENGINE
tgb = st_bull and above_bbsr and ema50_rising
tgs = st_bear and below_bbsr and ema50_fall

tbs = (st_bull ? 1 : 0) + (at_cont_bull ? 1 : 0) + (above_bbsr ? 1 : 0) + (rsi_bull_z ? 1 : 0) + (macd_bull ? 1 : 0)
tss = (st_bear ? 1 : 0) + (at_cont_bear ? 1 : 0) + (below_bbsr ? 1 : 0) + (rsi_bear_z ? 1 : 0) + (macd_bear ? 1 : 0)

tbr = use_trend and tgb and tbs >= min_conf and vgb and vok and ins and cd
tsr = use_trend and tgs and tss >= min_conf and vgs and vok and ins and cd

rbr = use_rev and rsb and at_flip_bull and rsi_rev_bull and ema9_up and vgb and ins and cd
rsr = use_rev and rss and at_flip_bear and rsi_rev_bear and ema9_down and vgs and ins and cd

v5_buy_raw = tbr or rbr
v5_sell_raw = tsr or rsr

// ─── STATE MACHINE
//  0 = flat, can take either side
//  1 = long
// -1 = short
//  2 = exited long, waiting only for V5 SELL
// -2 = exited short, waiting only for V5 BUY
var int state = 0
var float entry_price = na
var float best_high = na
var float best_low = na
var int entry_bar = na

abuy = v5_buy_raw and (state == 0 or state == -2)
asell = v5_sell_raw and (state == 0 or state == 2)

irb = abuy and rbr and not tbr
irs = asell and rsr and not tsr

if abuy
    state := 1
    bss := 0
    entry_price := close
    best_high := high
    best_low := na
    entry_bar := bar_index

if asell
    state := -1
    bss := 0
    entry_price := close
    best_low := low
    best_high := na
    entry_bar := bar_index

if state == 1
    best_high := na(best_high) ? high : math.max(best_high, high)

if state == -1
    best_low := na(best_low) ? low : math.min(best_low, low)

// ─── V6 STYLE X EXIT
exit_atr = ta.atr(exit_atr_len)
can_exit = not na(entry_bar) and bar_index - entry_bar >= min_bars_exit

long_profit = state == 1 and close > entry_price
short_profit = state == -1 and close < entry_price

long_giveback = use_giveback_exit and state == 1 and long_profit and close < best_high - exit_atr * giveback_atr
short_giveback = use_giveback_exit and state == -1 and short_profit and close > best_low + exit_atr * giveback_atr

long_ema_break = use_ema21_exit and state == 1 and close < em and close[1] < em[1]
short_ema_break = use_ema21_exit and state == -1 and close > em and close[1] > em[1]

long_mom_loss = use_mom_exit and state == 1 and mh < mh[1] and mh[1] < mh[2] and rsi < rsi[1]
short_mom_loss = use_mom_exit and state == -1 and mh > mh[1] and mh[1] > mh[2] and rsi > rsi[1]

long_at_flip = use_at_exit and state == 1 and at_flip_bear
short_at_flip = use_at_exit and state == -1 and at_flip_bull

long_opp_sweep = use_sweep_exit and state == 1 and sws and rsi > 55 and rsi < rsi[1]
short_opp_sweep = use_sweep_exit and state == -1 and swb and rsi < 45 and rsi > rsi[1]

exl = can_exit and state == 1 and (long_giveback or long_ema_break or long_mom_loss or long_at_flip or long_opp_sweep)
exs = can_exit and state == -1 and (short_giveback or short_ema_break or short_mom_loss or short_at_flip or short_opp_sweep)

if exl
    state := 2
    entry_price := na
    best_high := na
    best_low := na
    entry_bar := na

if exs
    state := -2
    entry_price := na
    best_high := na
    best_low := na
    entry_bar := na

// ─── PLOTS
plot(st_line, "SuperTrend", color=st_bull ? color.new(c_bull, 20) : color.new(c_bear, 20), linewidth=2)

k1 = plot(AT, "AT", color.new(#0022FC, 0), linewidth=2)
k2 = plot(AT[2], "AT2", color.new(#FC0400, 0), linewidth=2)
fill(k1, k2, color=at_bull ? color.new(#00E60F, 80) : color.new(#80000B, 80))

plot(bbsr, "BBSR EMA 200", color.new(#4FC3F7, 40), linewidth=2)
plot(ef, "EMA 9", color.new(color.yellow, 60), linewidth=1)
plot(em, "EMA 21", color.new(color.orange, 60), linewidth=1)
plot(es, "EMA 50", color.new(color.red, 60), linewidth=1)
plot(use_vg ? bbs : na, "BB Midline", color.new(color.white, 70), linewidth=1, style=plot.style_circles)

plotshape(swb, title="Sweep Low", style=shape.triangleup, location=location.belowbar, color=color.new(c_bull, 40), size=size.tiny)
plotshape(sws, title="Sweep High", style=shape.triangledown, location=location.abovebar, color=color.new(c_bear, 40), size=size.tiny)

plotshape(abuy and not irb, title="V5 BUY Entry", style=shape.labelup, location=location.belowbar, color=c_bull, textcolor=color.black, text="BUY", size=size.normal)
plotshape(abuy and irb, title="V5 R-BUY Entry", style=shape.labelup, location=location.belowbar, color=c_rev, textcolor=color.black, text="R-BUY", size=size.normal)

plotshape(asell and not irs, title="V5 SELL Entry", style=shape.labeldown, location=location.abovebar, color=c_bear, textcolor=color.white, text="SELL", size=size.normal)
plotshape(asell and irs, title="V5 R-SELL Entry", style=shape.labeldown, location=location.abovebar, color=c_rev, textcolor=color.white, text="R-SELL", size=size.normal)

plotshape(exl, title="V6 X Exit Long", style=shape.xcross, location=location.abovebar, color=color.new(c_bear, 0), size=size.small, text="X")
plotshape(exs, title="V6 X Exit Short", style=shape.xcross, location=location.belowbar, color=color.new(c_bull, 0), size=size.small, text="X")

barcolor(state == 1 ? color.new(c_bull, 65) : state == -1 ? color.new(c_bear, 65) : na)

// ─── ALERTS
alertcondition(abuy and not irb, "V5 BUY ENTRY", "V5 BUY Entry — {{ticker}} {{interval}}")
alertcondition(abuy and irb, "V5 R-BUY ENTRY", "V5 R-BUY Entry — {{ticker}} {{interval}}")
alertcondition(asell and not irs, "V5 SELL ENTRY", "V5 SELL Entry — {{ticker}} {{interval}}")
alertcondition(asell and irs, "V5 R-SELL ENTRY", "V5 R-SELL Entry — {{ticker}} {{interval}}")
alertcondition(exl, "V6 X EXIT LONG", "V6 X Exit Long — {{ticker}} {{interval}}")
alertcondition(exs, "V6 X EXIT SHORT", "V6 X Exit Short — {{ticker}} {{interval}}")
