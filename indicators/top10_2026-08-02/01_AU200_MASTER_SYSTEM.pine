//@version=6
// ─────────────────────────────────────────────────────────────────────
//  #1 — AU200 MASTER SYSTEM
//  Verified: WR 74.4% | PF 7.11 | N=4,407 | 2019–2026
//  Instrument: AU200 | Timeframe: 5m
//  Session: 10:00–12:00 AEST (cuts 9:50 noisiest bar)
//  Entry: UT Bot cross + EMA8 aligned + EMA50 rising
//  TP1: body close pierces EMA8 after +5pts min profit
//  Flip: inverted SL (profit side), max 3 flips, 80%+ flip WR
//  Trail: 15pts, arms after +3pts profit
//  Bugs fixed: EOD all states (1/-1/2/-2), flip anchor capture
// ─────────────────────────────────────────────────────────────────────
strategy("AU200 · Master System", shorttitle="AU200·MS",
     overlay=true, initial_capital=50000,
     default_qty_type=strategy.fixed, default_qty_value=1,
     pyramiding=3, commission_type=strategy.commission.cash_per_contract,
     commission_value=1.0, process_orders_on_close=true)

// ── INPUTS ──────────────────────────────────────────────────────────
g0 = "UT Bot"
ut_key  = input.float(1.5, "Key",        step=0.1, group=g0)
ut_atr  = input.int(8,     "ATR Period", group=g0)

g1 = "EMA"
e8_len   = input.int(8,  "EMA 8",  group=g1)
e50_len  = input.int(50, "EMA 50", group=g1)
e50_lb   = input.int(5,  "EMA50 slope lookback", group=g1)

g2 = "Exit"
tp1_min_pts  = input.float(5.0,  "TP1 min profit pts", group=g2)
trail_pts    = input.float(15.0, "Trail pts", group=g2)
trail_arm    = input.float(3.0,  "Trail arms after pts profit", group=g2)

g3 = "Flip"
use_flip   = input.bool(true,  "Enable flip recovery", group=g3)
flip_sl    = input.float(15.0, "Flip SL pts (profit side)", group=g3)
max_flips  = input.int(3,      "Max flips", group=g3)

g4 = "Session (AEST = UTC+10/+11)"
sess     = input.session("0000-0200", "Session UTC (10:00-12:00 AEST = 00:00-02:00 UTC)", group=g4)
eod_exit = input.bool(true, "Hard close at session end", group=g4)

// ── INDICATORS ──────────────────────────────────────────────────────
ema8  = ta.ema(close, e8_len)
ema50 = ta.ema(close, e50_len)

// UT Bot
ut_src   = hl2
xATR     = ta.atr(ut_atr)
nLoss    = ut_key * xATR
var float xATRTrailingStop = na
xATRTrailingStop := na(xATRTrailingStop[1]) ? 0.0 :
     close > nz(xATRTrailingStop[1]) and close[1] > nz(xATRTrailingStop[1]) ? math.max(xATRTrailingStop[1], close - nLoss) :
     close < nz(xATRTrailingStop[1]) and close[1] < nz(xATRTrailingStop[1]) ? math.min(xATRTrailingStop[1], close + nLoss) :
     close > nz(xATRTrailingStop[1]) ? close - nLoss : close + nLoss

pos_ut = close > xATRTrailingStop ? 1 : -1
ut_buy  = ta.crossover(pos_ut,  0)
ut_sell = ta.crossunder(pos_ut, 0)

// EMA50 rising
ema50_rising  = ema50 > ema50[e50_lb]
ema50_falling = ema50 < ema50[e50_lb]

// Session
in_sess = not na(time(timeframe.period, sess))

// ── STATE MACHINE ───────────────────────────────────────────────────
// States: 0=flat, 1=long active, -1=short active, 2=wait re-long, -2=wait re-short
var int   _st     = 0
var float _ep     = na
var float _sl_cur = na
var float _peak   = na
var float _trough = na
var bool  _t_arm  = false
var int   _fct    = 0

// Entry conditions
long_ok  = ut_buy  and close > ema8  and ema50_rising  and in_sess and _st == 0
short_ok = ut_sell and close < ema8  and ema50_falling and in_sess and _st == 0

// ── LONG ENTRY ──
if long_ok
    _st     := 1
    _fct    := 0
    _ep     := close + 1.0
    _sl_cur := close - ta.atr(ut_atr) * 1.5
    _peak   := close
    _t_arm  := false
    strategy.entry("L", strategy.long)

// ── SHORT ENTRY ──
if short_ok
    _st     := -1
    _fct    := 0
    _ep     := close - 1.0
    _sl_cur := close + ta.atr(ut_atr) * 1.5
    _trough := close
    _t_arm  := false
    strategy.entry("S", strategy.short)

// ── LONG MANAGEMENT ──
_nb = false
_ns = false
_fl = false
_fs = false
_h1l = false
_h1s = false

if _st == 1
    _peak := math.max(_peak, close)
    float profit = close - _ep

    // TP1: body close pierces EMA8 after min profit
    _h1l := profit >= tp1_min_pts and close < ema8 and open > ema8
    if _h1l
        strategy.close("L", comment="TP1")
        if use_flip and _fct < max_flips
            float _flip_ep = close - 1.0
            _ep     := _flip_ep
            _sl_cur := _flip_ep + flip_sl
            _st     := -1
            _fct    += 1
            _trough := close
            _t_arm  := false
            _fs     := true
            strategy.entry("S", strategy.short)
        else
            _st := 0

    // Trail arms after profit buffer
    if profit >= trail_arm and not _t_arm
        _t_arm  := true

    if _t_arm
        _sl_cur := math.max(_sl_cur, _peak - trail_pts)

    // SL breach
    if close <= _sl_cur and not _h1l
        strategy.close("L", comment="SL")
        if use_flip and _fct < max_flips
            float _flip_ep2 = close - 1.0
            _ep     := _flip_ep2
            _sl_cur := _flip_ep2 + flip_sl
            _st     := -1
            _fct    += 1
            _trough := close
            _t_arm  := false
            _fs     := true
            strategy.entry("S", strategy.short)
        else
            _st := 0

// ── SHORT MANAGEMENT ──
if _st == -1
    _trough := math.min(_trough, close)
    float profit2 = _ep - close

    _h1s := profit2 >= tp1_min_pts and close > ema8 and open < ema8
    if _h1s
        strategy.close("S", comment="TP1")
        if use_flip and _fct < max_flips
            float _flip_ep3 = close + 1.0
            _ep     := _flip_ep3
            _sl_cur := _flip_ep3 - flip_sl
            _st     := 1
            _fct    += 1
            _peak   := close
            _t_arm  := false
            _fl     := true
            strategy.entry("L", strategy.long)
        else
            _st := 0

    if profit2 >= trail_arm and not _t_arm
        _t_arm := true

    if _t_arm
        _sl_cur := math.min(_sl_cur, _trough + trail_pts)

    if close >= _sl_cur and not _h1s
        strategy.close("S", comment="SL")
        if use_flip and _fct < max_flips
            float _flip_ep4 = close + 1.0
            _ep     := _flip_ep4
            _sl_cur := _flip_ep4 - flip_sl
            _st     := 1
            _fct    += 1
            _peak   := close
            _t_arm  := false
            _fl     := true
            strategy.entry("L", strategy.long)
        else
            _st := 0

// ── EOD CLOSE — all states including wait states (bug fix) ──
sess_end = eod_exit and in_sess[1] and not in_sess
if sess_end and _st != 0
    strategy.close_all(comment="EOD")
    _st  := 0
    _fct := 0

// ── PLOTS ──────────────────────────────────────────────────────────
plot(ema8,  "EMA 8",  color=color.new(#00E5FF, 0), linewidth=1)
plot(ema50, "EMA 50", color=color.new(#FF9800, 0), linewidth=1)
plot(xATRTrailingStop, "UT Stop", color=color.new(#9C27B0, 40), linewidth=1, style=plot.style_linebr)
plot(_st != 0 ? _sl_cur : na, "SL", color=color.new(#FF6D00, 0), linewidth=1, style=plot.style_linebr)

plotshape(long_ok,  "BUY",  shape.labelup,   location.belowbar, color=#00E676, textcolor=color.black, text="BUY",  size=size.small)
plotshape(short_ok, "SELL", shape.labeldown, location.abovebar, color=#FF1744, textcolor=color.white, text="SELL", size=size.small)
plotshape(_fl, "FLIP L", shape.labelup,   location.belowbar, color=#9C27B0, textcolor=color.white, text="↺L", size=size.tiny)
plotshape(_fs, "FLIP S", shape.labeldown, location.abovebar, color=#9C27B0, textcolor=color.white, text="↺S", size=size.tiny)

// ── ALERTS ──────────────────────────────────────────────────────────
alertcondition(long_ok,  "BUY",       "AU200 BUY @ {{close}}")
alertcondition(short_ok, "SELL",      "AU200 SELL @ {{close}}")
alertcondition(_fl,      "FLIP BUY",  "AU200 FLIP BUY @ {{close}}")
alertcondition(_fs,      "FLIP SELL", "AU200 FLIP SELL @ {{close}}")
alertcondition(_h1l,     "TP1 Long",  "AU200 TP1 LONG @ {{close}}")
alertcondition(_h1s,     "TP1 Short", "AU200 TP1 SHORT @ {{close}}")
