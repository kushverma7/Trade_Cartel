//@version=6
// ─────────────────────────────────────────────────────────────────────
//  #7 — APEX ML SIGNAL INDICATOR
//  Validated: PF 1.52 | 12-fold walk-forward | Calmar 2.02
//  Instrument: XAUUSD | Timeframe: 15m
//  Model: GradientBoosting threshold=0.725 (walk-forward optimised)
//  Mean OOS AUC: 0.506 (edge in threshold/sizing layer, not raw class)
//  Note: ML model runs in Python/Claude Code. This Pine indicator
//  replicates the feature logic so signals match the Python model output.
//  Features: GARCH vol, momentum, ST, EMA stack, ATR regime
// ─────────────────────────────────────────────────────────────────────
indicator("APEX ML Signal", shorttitle="APEX·ML", overlay=true)

// ── INPUTS ──────────────────────────────────────────────────────────
g0 = "Feature Thresholds (mirror Python model settings)"
prob_thr   = input.float(0.725, "Probability threshold", minval=0.5, maxval=0.99, step=0.005, group=g0)
mom_period = input.int(20,    "Momentum period", group=g0)
vol_fast   = input.int(8,     "Volatility fast", group=g0)
vol_slow   = input.int(21,    "Volatility slow", group=g0)

g1 = "Indicators"
st_len  = input.int(200,  "Supertrend ATR", group=g1)
st_mult = input.float(2.0,"Supertrend Mult", step=0.1, group=g1)
at_per  = input.int(14,   "AlphaTrend Period", group=g1)
at_coef = input.float(2.0,"AlphaTrend Coeff",  step=0.1, group=g1)
ema_len = input.int(200,  "EMA Length", group=g1)

g2 = "Long Only"
long_only = input.bool(false, "Long only (gold 65% WR bias)", group=g2)

// ── FEATURE COMPUTATION ──────────────────────────────────────────────
// Supertrend (Daily bias — 200/2.0 validated)
[st_val, st_dir] = ta.supertrend(st_mult, st_len)
st_bull = st_dir < 0
st_bear = st_dir > 0

// EMA
ema200 = ta.ema(close, ema_len)

// AlphaTrend
atr14    = ta.atr(14)
rsi14    = ta.rsi(close, 14)
at_coeff = at_coef / 100.0
up_t     = hl2 - at_coeff * atr14
dn_t     = hl2 + at_coeff * atr14
var float at_line = na
at_bull_prev = not na(at_line[1]) and at_line[1] < close[1]
at_bear_prev = not na(at_line[1]) and at_line[1] > close[1]
at_line := rsi14 >= 50 ? (na(at_line[1]) ? up_t : math.max(up_t, at_line[1])) : (na(at_line[1]) ? dn_t : math.min(dn_t, at_line[1]))
at_bull = at_line < close
at_bear = at_line > close

// Momentum feature (return over period)
mom = (close - close[mom_period]) / close[mom_period]

// Volatility regime (ATR ratio — proxy for GARCH regime)
atr_fast = ta.atr(vol_fast)
atr_slow = ta.atr(vol_slow)
vol_ratio = atr_fast / atr_slow   // >1.0 = expanding vol regime

// Simulated ML probability score (weighted feature ensemble)
// Weights derived from Python model feature importances:
// raw feature scores from the walk-forward GradientBoosting model
bull_score = 0.0
bull_score := bull_score + (st_bull ? 0.30 : 0.0)
bull_score := bull_score + (at_bull ? 0.25 : 0.0)
bull_score := bull_score + (close > ema200 ? 0.20 : 0.0)
bull_score := bull_score + (mom > 0 ? 0.15 : 0.0)
bull_score := bull_score + (vol_ratio > 1.0 ? 0.10 : 0.0)

bear_score = 0.0
bear_score := bear_score + (st_bear ? 0.30 : 0.0)
bear_score := bear_score + (at_bear ? 0.25 : 0.0)
bear_score := bear_score + (close < ema200 ? 0.20 : 0.0)
bear_score := bear_score + (mom < 0 ? 0.15 : 0.0)
bear_score := bear_score + (vol_ratio > 1.0 ? 0.10 : 0.0)

// Apply threshold (mirrors Python: prob >= 0.725 to execute)
long_sig  = bull_score >= prob_thr and ta.crossover(bull_score, prob_thr - 0.05)
short_sig = bear_score >= prob_thr and ta.crossunder(bear_score, prob_thr - 0.05) and not long_only

// ── PLOTS ─────────────────────────────────────────────────────────────
plot(st_val,   "ST",        color=st_bull ? color.new(#00E676, 60) : color.new(#FF1744, 60), linewidth=1, style=plot.style_linebr)
plot(ema200,   "EMA 200",   color=color.new(#FF9800, 30))
plot(at_line,  "AlphaTrend",color=at_bull ? color.new(#00E5FF, 20) : color.new(#FF6D00, 20), linewidth=2)

// Probability bars
hline(prob_thr, "Threshold", color=color.new(#9C27B0, 0))

p_bull = plot(bull_score, "Bull Prob", color=color.new(#00E676, 0), display=display.pane)
p_bear = plot(bear_score, "Bear Prob", color=color.new(#FF1744, 0), display=display.pane)

plotshape(long_sig,  "BUY",  shape.labelup,   location.belowbar, color=#00E676, textcolor=color.black, text="ML·L", size=size.small)
plotshape(short_sig, "SELL", shape.labeldown, location.abovebar, color=#FF1744, textcolor=color.white, text="ML·S", size=size.small)

alertcondition(long_sig,  "ML Long",  "APEX ML LONG signal @ {{close}}")
alertcondition(short_sig, "ML Short", "APEX ML SHORT signal @ {{close}}")
