//@version=6
// ─────────────────────────────────────────────────────────────────────
//  #4 — XAUUSD 1H CONFLUENCE SYSTEM
//  Verified: PF 4.08 | WR ~60% | N=862 | 21 years
//  Instrument: XAUUSD | Timeframe: 1H
//  Stack: Supertrend ATR14/M7 + EMA50 + VWAP
//  Direction: longs 65% WR vs shorts 53.8% — long-only toggle included
//  Exit: 3-layer ATR protocol (hard floor → TP1 be+buffer → trail)
// ─────────────────────────────────────────────────────────────────────
strategy("XAUUSD · 1H Confluence", shorttitle="XAU·1H",
     overlay=true, initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=1,
     pyramiding=0, commission_type=strategy.commission.cash_per_contract,
     commission_value=0.3, process_orders_on_close=true)

// ── INPUTS ──────────────────────────────────────────────────────────
g0 = "Supertrend"
st_len  = input.int(14,  "ATR Length", group=g0)
st_mult = input.float(7.0, "Multiplier", step=0.1, group=g0)

g1 = "EMA"
ema_len = input.int(50, "EMA Length", group=g1)

g2 = "Exit (ATR-based)"
atr_sl   = input.float(1.5, "SL = ATR ×",    step=0.1, group=g2)
atr_tp1  = input.float(1.5, "TP1 = ATR ×",   step=0.1, group=g2)
tp1_pct  = input.float(50,  "TP1 exit %",     step=5,   group=g2)
be_buf   = input.float(0.5, "BE buffer ATR ×", step=0.1, group=g2)
atr_arm  = input.float(1.0, "Trail arm ATR ×", step=0.1, group=g2)
atr_trl  = input.float(2.0, "Trail ATR ×",    step=0.1, group=g2)

g3 = "Direction"
long_only = input.bool(false, "Long only (65% vs 53.8% WR)", group=g3)

// ── INDICATORS ──────────────────────────────────────────────────────
[st_val, st_dir] = ta.supertrend(st_mult, st_len)
ema50 = ta.ema(close, ema_len)
vwap  = ta.vwap(close)
atr14 = ta.atr(14)

// Supertrend direction
st_bull = st_dir < 0
st_bear = st_dir > 0

// ── SIGNALS ──────────────────────────────────────────────────────────
long_sig  = ta.crossover(close, st_val) and close > ema50 and close > vwap and st_bull
short_sig = ta.crossunder(close, st_val) and close < ema50 and close < vwap and st_bear and not long_only

// ── STATE ─────────────────────────────────────────────────────────────
var int   _pos    = 0
var int   _phase  = 0
var float _ep     = na
var float _sl     = na
var float _tp1    = na
var float _trail  = na
var bool  _t_arm  = false

// ── ENTRY ─────────────────────────────────────────────────────────────
if long_sig and _pos == 0
    _pos   := 1
    _phase := 1
    _ep    := close
    _sl    := close - atr_sl * atr14
    _tp1   := close + atr_tp1 * atr14
    _t_arm := false
    _trail := na
    strategy.entry("L", strategy.long)

if short_sig and _pos == 0
    _pos   := -1
    _phase := 1
    _ep    := close
    _sl    := close + atr_sl * atr14
    _tp1   := close - atr_tp1 * atr14
    _t_arm := false
    _trail := na
    strategy.entry("S", strategy.short)

// ── LONG MANAGEMENT ───────────────────────────────────────────────────
if _pos == 1
    // Phase 1 → TP1
    if _phase == 1 and close >= _tp1
        strategy.close("L", qty_percent=tp1_pct, comment="TP1")
        _sl    := _ep - be_buf * atr14
        _phase := 2

    // Phase 2 → arm trail
    if _phase == 2 and close >= _tp1 + atr_arm * atr14
        _t_arm := true
        _trail := close - atr_trl * atr14
        _phase := 3

    // Phase 3 → update trail
    if _phase == 3
        _trail := math.max(_trail, close - atr_trl * atr14)
        _sl    := math.max(_sl, _trail)

    // SL / trail breach
    if close <= _sl
        strategy.close("L", comment=_phase == 1 ? "SL" : "Trail")
        _pos   := 0
        _phase := 0

    // Supertrend flip exit
    if st_bear
        strategy.close("L", comment="ST·Flip")
        _pos   := 0
        _phase := 0

// ── SHORT MANAGEMENT ──────────────────────────────────────────────────
if _pos == -1
    if _phase == 1 and close <= _tp1
        strategy.close("S", qty_percent=tp1_pct, comment="TP1")
        _sl    := _ep + be_buf * atr14
        _phase := 2

    if _phase == 2 and close <= _tp1 - atr_arm * atr14
        _t_arm := true
        _trail := close + atr_trl * atr14
        _phase := 3

    if _phase == 3
        _trail := math.min(_trail, close + atr_trl * atr14)
        _sl    := math.min(_sl, _trail)

    if close >= _sl
        strategy.close("S", comment=_phase == 1 ? "SL" : "Trail")
        _pos   := 0
        _phase := 0

    if st_bull
        strategy.close("S", comment="ST·Flip")
        _pos   := 0
        _phase := 0

// ── PLOTS ─────────────────────────────────────────────────────────────
plot(st_val, "Supertrend", color=st_bull ? #00E676 : #FF1744, linewidth=2, style=plot.style_linebr)
plot(ema50,  "EMA 50",     color=color.new(#FF9800, 0), linewidth=1)
plot(vwap,   "VWAP",       color=color.new(#00E5FF, 0), linewidth=1)
plot(_pos != 0 ? _sl : na, "SL", color=color.new(#FF6D00, 0), linewidth=1, style=plot.style_linebr)

plotshape(long_sig,  "BUY",  shape.labelup,   location.belowbar, color=#00E676, textcolor=color.black, text="BUY",  size=size.small)
plotshape(short_sig, "SELL", shape.labeldown, location.abovebar, color=#FF1744, textcolor=color.white, text="SELL", size=size.small)

alertcondition(long_sig,  "Long",  "XAUUSD 1H LONG @ {{close}}")
alertcondition(short_sig, "Short", "XAUUSD 1H SHORT @ {{close}}")
