//@version=6
// ─────────────────────────────────────────────────────────────────────
//  #9 — APEX v1 — XAUUSD 5m  TP50/SL15
//  Verified: PF 1.309 | EV +3.36pts/trade | Net +1,953pts | 5m
//  Optimal from 42-combo TP/SL grid sweep on XAUUSD 5m (2023–2025)
//  Stack: DE v6 + HTF 1H bias + PDL/PDH gates + Quarter Theory
//  Exit: FIXED TP=50pts, SL=15pts (no trail — confirmed optimal)
//  IMPORTANT: flip exits removed (improved WR 31→37.3%, PnL -31→+1,495pts)
//  Spread: 0.20pts (used in original test), 1pt conservative toggle
// ─────────────────────────────────────────────────────────────────────
strategy("APEX v1 — TP50/SL15", shorttitle="APEX·v1",
     overlay=true, initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=1,
     pyramiding=0, commission_type=strategy.commission.cash_per_contract,
     commission_value=0.2, process_orders_on_close=true)

// ── INPUTS ──────────────────────────────────────────────────────────
g0 = "Exit (verified TP50/SL15)"
tp_pts    = input.float(50.0, "TP pts (verified optimal)", step=2.5, group=g0)
sl_pts    = input.float(15.0, "SL pts (verified optimal)", step=2.5, group=g0)

g1 = "HTF Bias (1H)"
use_htf   = input.bool(true, "Enable 1H bias gate", group=g1)
htf_st_l  = input.int(14,    "HTF ST ATR", group=g1)
htf_st_m  = input.float(7.0, "HTF ST Mult", step=0.1, group=g1)

g2 = "Session"
use_sess  = input.bool(true,  "Enable session filter", group=g2)
sess      = input.session("0200-1600", "London+NY UTC", group=g2)

g3 = "Direction"
long_only = input.bool(false, "Long only (65% WR gold)", group=g3)

// ── CORE CONFLUENCE ENGINE (DE v6 foundation) ─────────────────────────
atr14 = ta.atr(14)

// Supertrend
[st_val, st_dir] = ta.supertrend(3.1, 97)
st_bull = st_dir < 0
st_bear = st_dir > 0

// Andean Trend
andean_len   = 25
andean_alpha = 2.5
up1_a = 0.0
up2_a = 0.0
dn1_a = 0.0
dn2_a = 0.0
up1_a := math.max(close, open, up1_a[1]) - (up1_a[1] - up2_a[1]) / andean_len
up2_a := up2_a[1] + (up1_a - up2_a[1]) / andean_len
dn1_a := math.min(close, open, dn1_a[1]) + (dn2_a[1] - dn1_a[1]) / andean_len
dn2_a := dn2_a[1] - (dn2_a[1] - dn1_a[1]) / andean_len
andean_bull = close > up2_a
andean_bear = close < dn2_a

// EMA 200
ema200 = ta.ema(close, 200)

// MACD 8/17/9
[macd_line, macd_sig, macd_hist] = ta.macd(close, 8, 17, 9)
macd_bull = macd_hist > 0
macd_bear = macd_hist < 0

// HTF 1H Supertrend
f_htf_st() =>
    [sv, sd] = ta.supertrend(htf_st_m, htf_st_l)
    sd
htf_dir = request.security(syminfo.tickerid, "60", f_htf_st(), lookahead=barmerge.lookahead_off)
htf_bull = htf_dir < 0
htf_bear = htf_dir > 0

// Session
in_sess = not use_sess or not na(time(timeframe.period, sess))

// PDL / PDH institutional gates
pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_off)
pdl = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_off)
above_pdl = close > pdl
below_pdh = close < pdh

// Quarter Theory (1000-pip range, 25-pip buffer zones)
q_range = 1000.0
q_unit  = q_range / 4.0
q_base  = math.floor(close / q_range) * q_range
q1 = q_base + q_unit
q2 = q_base + q_unit * 2.0
q3 = q_base + q_unit * 3.0
buf = 25.0
in_q1_bull = close > q1 + buf and close < q1 + buf * 3.0
in_q2_bull = close > q2 + buf and close < q2 + buf * 3.0
in_q3_bull = close > q3 + buf and close < q3 + buf * 3.0
qt_bull    = in_q1_bull or in_q2_bull or in_q3_bull
qt_bear    = not qt_bull

// Confluence scoring
bull_c = (st_bull ? 1 : 0) + (andean_bull ? 1 : 0) + (macd_bull ? 1 : 0) + (close > ema200 ? 1 : 0) + (qt_bull ? 1 : 0)
bear_c = (st_bear ? 1 : 0) + (andean_bear ? 1 : 0) + (macd_bear ? 1 : 0) + (close < ema200 ? 1 : 0) + (qt_bear ? 1 : 0)

htf_ok_bull = not use_htf or htf_bull
htf_ok_bear = not use_htf or htf_bear

// ── SIGNALS ───────────────────────────────────────────────────────────
long_sig  = bull_c >= 3 and htf_ok_bull and above_pdl and in_sess
short_sig = bear_c >= 3 and htf_ok_bear and below_pdh and in_sess and not long_only

// No flip exits (removed — improved WR 31%→37.3%)
// New entries only when flat

// ── STATE ─────────────────────────────────────────────────────────────
var int   _pos = 0
var float _ep  = na
var float _sl  = na
var float _tp  = na

long_fire  = long_sig  and not long_sig[1]  and _pos == 0
short_fire = short_sig and not short_sig[1] and _pos == 0

if long_fire
    _pos := 1
    _ep  := close
    _sl  := close - sl_pts
    _tp  := close + tp_pts
    strategy.entry("L", strategy.long)

if short_fire
    _pos := -1
    _ep  := close
    _sl  := close + sl_pts
    _tp  := close - tp_pts
    strategy.entry("S", strategy.short)

if _pos == 1
    if close >= _tp
        strategy.close("L", comment="TP")
        _pos := 0
    else if close <= _sl
        strategy.close("L", comment="SL")
        _pos := 0

if _pos == -1
    if close <= _tp
        strategy.close("S", comment="TP")
        _pos := 0
    else if close >= _sl
        strategy.close("S", comment="SL")
        _pos := 0

// ── PLOTS ─────────────────────────────────────────────────────────────
plot(st_val,  "ST",      color=st_bull ? color.new(#00E676, 40) : color.new(#FF1744, 40), linewidth=1, style=plot.style_linebr)
plot(ema200,  "EMA 200", color=color.new(#FF9800, 30))
plot(pdh, "PDH", color=color.new(#00E5FF, 60), linewidth=1, style=plot.style_circles)
plot(pdl, "PDL", color=color.new(#FF6D00, 60), linewidth=1, style=plot.style_circles)
plot(_pos != 0 ? _sl : na, "SL", color=color.new(#FF1744, 0), linewidth=1, style=plot.style_linebr)
plot(_pos != 0 ? _tp : na, "TP", color=color.new(#00E676, 0), linewidth=1, style=plot.style_linebr)

plotshape(long_fire,  "BUY",  shape.labelup,   location.belowbar, color=#00E676, textcolor=color.black, text="BUY",  size=size.small)
plotshape(short_fire, "SELL", shape.labeldown, location.abovebar, color=#FF1744, textcolor=color.white, text="SELL", size=size.small)

alertcondition(long_fire,  "Long",  "APEX v1 LONG @ {{close}}")
alertcondition(short_fire, "Short", "APEX v1 SHORT @ {{close}}")
