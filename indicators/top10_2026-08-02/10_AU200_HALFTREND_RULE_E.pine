//@version=6
// ─────────────────────────────────────────────────────────────────────
//  #10 — AU200 HALFTREND RULE E
//  Verified: PF 1.172 | 50.3 net pts/month | 10yr, 212,177 bars
//  Best of 1,920-combination grid search
//  Params: amplitude=3, channelDeviation=1, emaFast=5, emaSlow=50
//          confirmWindow=5 (73.65% confirmation rate, 2,476 signals)
//  Exit Rule E: SL=20pts, TP1=40pts (50% exit), trail=10pts
//  MAE validated: 10pt SL survives 65.3% of trades
//                 20pt SL survives 82.0% of trades
// ─────────────────────────────────────────────────────────────────────
strategy("AU200 · HalfTrend Rule E", shorttitle="AU200·HT",
     overlay=true, initial_capital=50000,
     default_qty_type=strategy.fixed, default_qty_value=2,
     pyramiding=0, commission_type=strategy.commission.cash_per_contract,
     commission_value=1.0, process_orders_on_close=true)

// ── INPUTS (all confirmed optimal from 1,920-combo grid) ─────────────
g0 = "HalfTrend (confirmed: amplitude=3, deviation=1)"
amplitude       = input.int(3,   "Amplitude",        minval=1, group=g0)
channelDeviation= input.float(1.0,"Channel Deviation",step=0.5, group=g0)

g1 = "EMA Filters (confirmed: fast=5, slow=50, window=5)"
emaFast         = input.int(5,  "EMA Fast", group=g1)
emaSlow         = input.int(50, "EMA Slow", group=g1)
confirmWindow   = input.int(5,  "Confirm Window bars", group=g1)

g2 = "Exit Rule E (confirmed: SL=20, TP1=40 50%, trail=10)"
sl_pts   = input.float(20.0, "SL pts  (82% MAE survival)", group=g2)
tp1_pts  = input.float(40.0, "TP1 pts (50% exit)",         group=g2)
trl_pts  = input.float(10.0, "Trail pts (runner)",         group=g2)
trl_arm  = input.float(3.0,  "Trail arm after pts profit", group=g2)

g3 = "Optional Enhancements (v6 improvements)"
use_adx     = input.bool(true,  "ADX ≥ 18 filter", group=g3)
use_daily   = input.bool(false, "Daily EMA20 bias", group=g3)
use_atr_sl  = input.bool(false, "ATR-adaptive SL (1.5×ATR14)", group=g3)
use_sydney  = input.bool(false, "Sydney session only", group=g3)
sydney_sess = input.session("2200-0600", "Sydney UTC session", group=g3)

// ── HALFTREND ────────────────────────────────────────────────────────
atr2     = ta.atr(100) / 2.0 * amplitude
var float nextBar  = 0.0
var float highPrice= high
var float lowPrice = low
var int   trend    = 0
var float arrowHigh= na
var float arrowLow = na
var float hT       = na
var int   dir      = 0

highPrice := trend == 0 ? math.max(high, highPrice) : high
lowPrice  := trend == 0 ? math.min(low,  lowPrice)  : low

highma = ta.ema(math.max(close, open), amplitude)
lowma  = ta.ema(math.min(close, open), amplitude)

if trend == 0
    if highPrice >= nextBar
        dir       := 1
        trend     := 1
        arrowLow  := lowPrice
        hT        := arrowLow
        nextBar   := highPrice - channelDeviation * atr2
        highPrice := high
        lowPrice  := low
else
    if lowPrice <= nextBar
        dir       := -1
        trend     := 0
        arrowHigh := highPrice
        hT        := arrowHigh
        nextBar   := lowPrice + channelDeviation * atr2
        highPrice := high
        lowPrice  := low

// HalfTrend value
ht_up   = dir ==  1
ht_down = dir == -1

// ── EMA FILTERS ──────────────────────────────────────────────────────
ema_f = ta.ema(close, emaFast)
ema_s = ta.ema(close, emaSlow)
ema_slope_bull = ema_f > ema_f[1] and ema_s > ema_s[1]
ema_slope_bear = ema_f < ema_f[1] and ema_s < ema_s[1]
price_ema_bull = close > ema_f and close > ema_s
price_ema_bear = close < ema_f and close < ema_s

// Confirmation window: at least 1 bar within `confirmWindow` closing beyond signal
var bool confirmed_bull = false
var bool confirmed_bear = false
flip_bull = ta.crossover(dir,  0)
flip_bear = ta.crossunder(dir, 0)

if flip_bull
    confirmed_bull := false
if flip_bear
    confirmed_bear := false

for i = 0 to confirmWindow - 1
    if ht_up and close[i] > close[i + 1]
        confirmed_bull := true
    if ht_down and close[i] < close[i + 1]
        confirmed_bear := true

// ── ADX FILTER ───────────────────────────────────────────────────────
f_dmi_adx() =>
    [p, m, a] = ta.dmi(14, 14)
    a
adx = f_dmi_adx()
adx_ok = not use_adx or adx >= 18

// ── DAILY BIAS ───────────────────────────────────────────────────────
d_ema20 = request.security(syminfo.tickerid, "D", ta.ema(close, 20), lookahead=barmerge.lookahead_off)
daily_bull = not use_daily or close > d_ema20
daily_bear = not use_daily or close < d_ema20

// ── SESSION ──────────────────────────────────────────────────────────
in_sess = not use_sydney or not na(time(timeframe.period, sydney_sess))

// ── ATR-ADAPTIVE SL ──────────────────────────────────────────────────
atr14   = ta.atr(14)
sl_use  = use_atr_sl ? atr14 * 1.5 : sl_pts

// ── SIGNALS ───────────────────────────────────────────────────────────
long_sig  = flip_bull and confirmed_bull and ema_slope_bull and price_ema_bull and adx_ok and daily_bull and in_sess
short_sig = flip_bear and confirmed_bear and ema_slope_bear and price_ema_bear and adx_ok and daily_bear and in_sess

// ── STATE ─────────────────────────────────────────────────────────────
var int   _pos     = 0
var float _ep      = na
var float _sl      = na
var float _tp1     = na
var float _pk      = na
var float _tr2     = na
var bool  _tp1done = false
var bool  _t_arm   = false

if long_sig and _pos == 0
    _pos     := 1
    _ep      := close + 1.0
    _sl      := _ep - sl_use
    _tp1     := _ep + tp1_pts
    _pk      := close
    _tp1done := false
    _t_arm   := false
    strategy.entry("L", strategy.long, qty=2)

if short_sig and _pos == 0
    _pos     := -1
    _ep      := close - 1.0
    _sl      := _ep + sl_use
    _tp1     := _ep - tp1_pts
    _tr2     := close
    _tp1done := false
    _t_arm   := false
    strategy.entry("S", strategy.short, qty=2)

if _pos == 1
    _pk := math.max(_pk, close)
    float p = close - _ep

    if not _tp1done and close >= _tp1
        strategy.close("L", qty=1, comment="TP1")
        _sl      := _ep
        _tp1done := true

    if _tp1done and p >= trl_arm and not _t_arm
        _t_arm := true

    if _t_arm
        _sl := math.max(_sl, _pk - trl_pts)

    if close <= _sl
        strategy.close("L", comment="SL/Trail")
        _pos := 0

if _pos == -1
    _tr2 := math.min(_tr2, close)
    float p2 = _ep - close

    if not _tp1done and close <= _tp1
        strategy.close("S", qty=1, comment="TP1")
        _sl      := _ep
        _tp1done := true

    if _tp1done and p2 >= trl_arm and not _t_arm
        _t_arm := true

    if _t_arm
        _sl := math.min(_sl, _tr2 + trl_pts)

    if close >= _sl
        strategy.close("S", comment="SL/Trail")
        _pos := 0

// ── PLOTS ─────────────────────────────────────────────────────────────
plot(ema_f, "EMA Fast", color=color.new(#00E5FF, 0))
plot(ema_s, "EMA Slow", color=color.new(#FF9800, 0))
plot(_pos != 0 ? _sl : na,  "SL",  color=color.new(#FF1744, 0), linewidth=1, style=plot.style_linebr)
plot(_pos == 1 and not _tp1done ? _tp1 : na, "TP1", color=color.new(#00E676, 0), linewidth=1, style=plot.style_linebr)

plotshape(long_sig,  "BUY",  shape.labelup,   location.belowbar, color=#00E676, textcolor=color.black, text="BUY",  size=size.small)
plotshape(short_sig, "SELL", shape.labeldown, location.abovebar, color=#FF1744, textcolor=color.white, text="SELL", size=size.small)

alertcondition(long_sig,  "HT Long",  "AU200 HalfTrend LONG @ {{close}}")
alertcondition(short_sig, "HT Short", "AU200 HalfTrend SHORT @ {{close}}")
