//@version=6
// ─────────────────────────────────────────────────────────────────────
//  #8 — XAUUSD DAILY TRIPLE STACK
//  Verified: PF 1.44 | WR 60% | N=148 | 7 years
//  Instrument: XAUUSD | Timeframe: Daily
//  Stack: Supertrend 200/2.0 + AlphaTrend 14/2.0 + EMA200
//  Only statistically validated edge across full XAUUSD history
//  Longs: 65% WR | Shorts: 53.8% WR
//  Long-only mode included
// ─────────────────────────────────────────────────────────────────────
strategy("XAUUSD · Daily Triple Stack", shorttitle="XAU·D3",
     overlay=true, initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=1,
     pyramiding=0, commission_type=strategy.commission.cash_per_contract,
     commission_value=0.3, process_orders_on_close=true)

// ── INPUTS ──────────────────────────────────────────────────────────
g0 = "Supertrend (confirmed 200/2.0)"
st_len  = input.int(200,  "ATR Length",   group=g0)
st_mult = input.float(2.0,"Multiplier",   step=0.1, group=g0)

g1 = "AlphaTrend (confirmed 14/2.0)"
at_per  = input.int(14,   "Period",       group=g1)
at_coef = input.float(2.0,"Coefficient",  step=0.1, group=g1)

g2 = "EMA"
ema_len = input.int(200, "EMA Length", group=g2)

g3 = "Exit"
atr_sl  = input.float(2.0, "SL = ATR ×",     step=0.1, group=g3)
atr_tp1 = input.float(2.0, "TP1 = ATR ×",    step=0.1, group=g3)
tp1_pct = input.float(50,  "TP1 exit %",      step=5,   group=g3)
atr_trl = input.float(3.0, "Trail ATR ×",     step=0.1, group=g3)
atr_arm = input.float(1.5, "Trail arm ATR ×", step=0.1, group=g3)

g4 = "Direction"
long_only = input.bool(false, "Long only (65% WR vs 53.8%)", group=g4)

// ── INDICATORS ──────────────────────────────────────────────────────
// Supertrend
[st_val, st_dir] = ta.supertrend(st_mult, st_len)
st_bull = st_dir < 0
st_bear = st_dir > 0

// EMA 200
ema200 = ta.ema(close, ema_len)

// AlphaTrend
atr14    = ta.atr(14)
rsi14    = ta.rsi(close, 14)
at_c     = at_coef / 100.0
var float at_val = na
at_up    = hl2 - at_c * atr14
at_dn    = hl2 + at_c * atr14
at_val  := rsi14 >= 50 ? (na(at_val[1]) ? at_up : math.max(at_up, at_val[1])) : (na(at_val[1]) ? at_dn : math.min(at_dn, at_val[1]))
at_bull  = at_val < close
at_bear  = at_val > close

// AlphaTrend cross (entry trigger)
at_bull_cross = ta.crossover(close,  at_val)
at_bear_cross = ta.crossunder(close, at_val)

// ── SIGNALS (all 3 must agree) ───────────────────────────────────────
long_sig  = at_bull_cross and st_bull and close > ema200
short_sig = at_bear_cross and st_bear and close < ema200 and not long_only

// ── STATE ─────────────────────────────────────────────────────────────
var int   _pos   = 0
var int   _phase = 0
var float _ep    = na
var float _sl    = na
var float _tp1   = na
var float _trail = na

atr_cur = ta.atr(14)

if long_sig and _pos == 0
    _pos   := 1
    _phase := 1
    _ep    := close
    _sl    := close - atr_sl * atr_cur
    _tp1   := close + atr_tp1 * atr_cur
    _trail := na
    strategy.entry("L", strategy.long)

if short_sig and _pos == 0
    _pos   := -1
    _phase := 1
    _ep    := close
    _sl    := close + atr_sl * atr_cur
    _tp1   := close - atr_tp1 * atr_cur
    _trail := na
    strategy.entry("S", strategy.short)

if _pos == 1
    if _phase == 1 and close >= _tp1
        strategy.close("L", qty_percent=tp1_pct, comment="TP1")
        _sl    := _ep
        _phase := 2

    if _phase == 2 and close >= _ep + atr_arm * atr_cur
        _trail := close - atr_trl * atr_cur
        _phase := 3

    if _phase == 3
        _trail := math.max(_trail, close - atr_trl * atr_cur)
        _sl    := math.max(_sl, _trail)

    if close <= _sl or st_bear
        strategy.close("L", comment=st_bear ? "ST·Flip" : "SL/Trail")
        _pos   := 0
        _phase := 0

if _pos == -1
    if _phase == 1 and close <= _tp1
        strategy.close("S", qty_percent=tp1_pct, comment="TP1")
        _sl    := _ep
        _phase := 2

    if _phase == 2 and close <= _ep - atr_arm * atr_cur
        _trail := close + atr_trl * atr_cur
        _phase := 3

    if _phase == 3
        _trail := math.min(_trail, close + atr_trl * atr_cur)
        _sl    := math.min(_sl, _trail)

    if close >= _sl or st_bull
        strategy.close("S", comment=st_bull ? "ST·Flip" : "SL/Trail")
        _pos   := 0
        _phase := 0

// ── PLOTS ─────────────────────────────────────────────────────────────
plot(st_val,  "Supertrend", color=st_bull ? color.new(#00E676, 0) : color.new(#FF1744, 0), linewidth=2, style=plot.style_linebr)
plot(at_val,  "AlphaTrend", color=at_bull ? color.new(#00E5FF, 0) : color.new(#FF6D00, 0), linewidth=2)
plot(ema200,  "EMA 200",    color=color.new(#FF9800, 30))
plot(_pos != 0 ? _sl : na, "SL", color=color.new(#FF6D00, 0), linewidth=1, style=plot.style_linebr)

plotshape(long_sig,  "BUY",  shape.labelup,   location.belowbar, color=#00E676, textcolor=color.black, text="BUY",  size=size.normal)
plotshape(short_sig, "SELL", shape.labeldown, location.abovebar, color=#FF1744, textcolor=color.white, text="SELL", size=size.normal)

alertcondition(long_sig,  "Daily Long",  "XAUUSD DAILY LONG @ {{close}}")
alertcondition(short_sig, "Daily Short", "XAUUSD DAILY SHORT @ {{close}}")
