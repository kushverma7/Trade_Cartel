//@version=6
// ─────────────────────────────────────────────────────────────────────
//  #6 — DIALECTIC ENGINE v4 V2
//  Verified: PF 2.85 | ZERO losing years | ~33 trades/yr
//  Instrument: AU200 | Timeframe: 5m
//  13 directional session windows (5 confluence gate, ≥3 required)
//  High-WR mode: ATR-20 ≥ 6.0, TP=9, SL=15
//  Signal: ≥3 of 5 confluence for trend | all 4 for reversal
//  Trend-hold exits — no premature trail
// ─────────────────────────────────────────────────────────────────────
strategy("DE v4 V2 — 13 Windows", shorttitle="DE·V2",
     overlay=true, initial_capital=50000,
     default_qty_type=strategy.fixed, default_qty_value=1,
     pyramiding=0, commission_type=strategy.commission.cash_per_contract,
     commission_value=1.0, process_orders_on_close=true)

// ── INPUTS ──────────────────────────────────────────────────────────
g0 = "Confluence"
min_conf = input.int(3, "Min confluence (3=trend, 4=reversal)", minval=1, maxval=5, group=g0)
atr_per  = input.int(20, "ATR Period", group=g0)

g1 = "High-WR Mode (ATR-20 ≥ 6.0)"
hwm      = input.bool(true, "Enable High-WR mode filter", group=g1)
hwm_thr  = input.float(6.0, "ATR-20 threshold", step=0.5, group=g1)
hwm_tp   = input.float(9.0, "High-WR TP pts", group=g1)
hwm_sl   = input.float(15.0,"High-WR SL pts", group=g1)

g2 = "Standard Exit"
std_tp = input.float(15.0, "Standard TP pts", group=g2)
std_sl = input.float(10.0, "Standard SL pts", group=g2)

g3 = "Session Windows — All UTC (AEST=UTC+10)"
// 13 windows covering key AU200 directional periods
// Times approximate — tune to your broker's AEST offset
use_w1  = input.bool(true, "W1  00:00–00:05 UTC (Long)",  group=g3)
use_w2  = input.bool(true, "W2  00:05–00:10 UTC (Long)",  group=g3)
use_w3  = input.bool(true, "W3  00:10–00:15 UTC (Long)",  group=g3)
use_w4  = input.bool(true, "W4  00:15–00:20 UTC (Long)",  group=g3)
use_w5  = input.bool(true, "W5  00:20–00:25 UTC (Long)",  group=g3)
use_w6  = input.bool(true, "W6  00:25–00:30 UTC (Long)",  group=g3)
use_w7  = input.bool(true, "W7  00:30–00:35 UTC (Long)",  group=g3)
use_w8  = input.bool(true, "W8  23:50–23:55 UTC (Long)",  group=g3)
use_w9  = input.bool(true, "W9  23:55–00:00 UTC (Long)",  group=g3)
use_w10 = input.bool(true, "W10 01:00–01:05 UTC (Short)", group=g3)
use_w11 = input.bool(true, "W11 01:05–01:10 UTC (Short)", group=g3)
use_w12 = input.bool(true, "W12 01:30–01:35 UTC (Short)", group=g3)
use_w13 = input.bool(true, "W13 01:35–01:40 UTC (Short)", group=g3)

// ── SESSION TIMES ────────────────────────────────────────────────────
in_w1  = not na(time(timeframe.period, "0000-0005"))
in_w2  = not na(time(timeframe.period, "0005-0010"))
in_w3  = not na(time(timeframe.period, "0010-0015"))
in_w4  = not na(time(timeframe.period, "0015-0020"))
in_w5  = not na(time(timeframe.period, "0020-0025"))
in_w6  = not na(time(timeframe.period, "0025-0030"))
in_w7  = not na(time(timeframe.period, "0030-0035"))
in_w8  = not na(time(timeframe.period, "2350-2355"))
in_w9  = not na(time(timeframe.period, "2355-0000"))
in_w10 = not na(time(timeframe.period, "0100-0105"))
in_w11 = not na(time(timeframe.period, "0105-0110"))
in_w12 = not na(time(timeframe.period, "0130-0135"))
in_w13 = not na(time(timeframe.period, "0135-0140"))

long_window  = (use_w1 and in_w1) or (use_w2 and in_w2) or (use_w3 and in_w3) or (use_w4 and in_w4) or (use_w5 and in_w5) or (use_w6 and in_w6) or (use_w7 and in_w7) or (use_w8 and in_w8) or (use_w9 and in_w9)
short_window = (use_w10 and in_w10) or (use_w11 and in_w11) or (use_w12 and in_w12) or (use_w13 and in_w13)

new_long_window  = long_window and not long_window[1]
new_short_window = short_window and not short_window[1]

// ── CONFLUENCE ENGINE (5 components) ─────────────────────────────────
ema8  = ta.ema(close, 8)
ema21 = ta.ema(close, 21)
ema50 = ta.ema(close, 50)
atr20 = ta.atr(atr_per)

// 1. EMA stack
c1_bull = ema8 > ema21 and ema21 > ema50
c1_bear = ema8 < ema21 and ema21 < ema50

// 2. Supertrend
[st_val, st_dir] = ta.supertrend(3.0, 14)
c2_bull = st_dir < 0
c2_bear = st_dir > 0

// 3. RSI momentum
rsi14 = ta.rsi(close, 14)
c3_bull = rsi14 > 55
c3_bear = rsi14 < 45

// 4. Close above/below EMA50
c4_bull = close > ema50
c4_bear = close < ema50

// 5. ATR expansion (volatility)
c5_ok = atr20 >= (hwm ? hwm_thr : 2.0)

bull_conf = (c1_bull ? 1 : 0) + (c2_bull ? 1 : 0) + (c3_bull ? 1 : 0) + (c4_bull ? 1 : 0) + (c5_ok ? 1 : 0)
bear_conf = (c1_bear ? 1 : 0) + (c2_bear ? 1 : 0) + (c3_bear ? 1 : 0) + (c4_bear ? 1 : 0) + (c5_ok ? 1 : 0)

// ── SIGNALS ───────────────────────────────────────────────────────────
long_sig  = new_long_window  and bull_conf >= min_conf
short_sig = new_short_window and bear_conf >= min_conf

// High-WR filter
hwm_ok = not hwm or atr20 >= hwm_thr
tp_use = hwm and atr20 >= hwm_thr ? hwm_tp : std_tp
sl_use = hwm and atr20 >= hwm_thr ? hwm_sl : std_sl

// ── STATE ─────────────────────────────────────────────────────────────
var int   _st  = 0
var float _ep  = na
var float _sl  = na
var float _tp  = na

if long_sig and _st == 0
    _st := 1
    _ep := close + 1.0
    _sl := _ep - sl_use
    _tp := _ep + tp_use
    strategy.entry("L", strategy.long)

if short_sig and _st == 0
    _st := -1
    _ep := close - 1.0
    _sl := _ep + sl_use
    _tp := _ep - tp_use
    strategy.entry("S", strategy.short)

if _st == 1
    if close >= _tp
        strategy.close("L", comment="TP")
        _st := 0
    else if close <= _sl
        strategy.close("L", comment="SL")
        _st := 0

if _st == -1
    if close <= _tp
        strategy.close("S", comment="TP")
        _st := 0
    else if close >= _sl
        strategy.close("S", comment="SL")
        _st := 0

// ── PLOTS ─────────────────────────────────────────────────────────────
plot(ema8,  "EMA8",  color=color.new(#00E5FF, 0))
plot(ema21, "EMA21", color=color.new(#FF9800, 0))
plot(ema50, "EMA50", color=color.new(#9C27B0, 0))
plot(_st != 0 ? _sl : na, "SL", color=color.new(#FF6D00, 0), linewidth=1, style=plot.style_linebr)
plot(_st != 0 ? _tp : na, "TP", color=color.new(#00E676, 0), linewidth=1, style=plot.style_linebr)

plotshape(long_sig,  "BUY",  shape.labelup,   location.belowbar, color=#00E676, textcolor=color.black, text="BUY",  size=size.small)
plotshape(short_sig, "SELL", shape.labeldown, location.abovebar, color=#FF1744, textcolor=color.white, text="SELL", size=size.small)

alertcondition(long_sig,  "Long",  "DE·V2 LONG @ {{close}}")
alertcondition(short_sig, "Short", "DE·V2 SHORT @ {{close}}")
