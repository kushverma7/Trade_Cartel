// ============================================================
// VALENTINI MOMENTUM-JOIN ENGINE [Real-Time]
// Source rules: trader_playbooks/valentini_scalping.md
// (Robbins World Cup scalper transcript — verified track record)
//
// Core doctrine: NEVER catch the falling knife. Join confirmed
// pressure at a point of interest, in the day's bias direction.
// Reversals only beyond the 2nd VWAP SD, toward fair value.
//
// Honest proxy note: true orderflow/footprint data is not
// available in Pine. "Aggression" here = volume surge + dominant
// body + directional close. It approximates, not replicates,
// his trigger.
//
// Scenarios (bar close, non-repainting):
//   JOIN ▲/▼   — IB+VWAP bias set, pullback touched POI (VWAP or
//                IB edge), aggression candle resumes bias
//   REVERT ▲/▼ — late-session close back inside the 2nd SD band
//                after excursion beyond it -> fade toward VWAP
// ============================================================
//@version=6
indicator("Valentini Momentum-Join Engine [Real-Time]", overlay=true, max_labels_count=500)

// ── Inputs ───────────────────────────────────────────────────
string sessStr   = input.session("0930-1600", "Trading Session (exchange time NY)", group="① Session / Bias")
int    ibMins    = input.int(30, "Initial Balance (minutes)", minval=5, maxval=120, group="① Session / Bias")
int    revStart  = input.int(1230, "Reversion Window Start (HHMM NY)", group="① Session / Bias",
     tooltip="Mid/late-session rebalance window. Reversion signals only after this time.")

float  volMult   = input.float(1.5, "Aggression Volume (x avg)", step=0.1, group="② Aggression Proxy")
float  bodyPct   = input.float(0.6, "Aggression Body (fraction of range)", step=0.05, group="② Aggression Proxy")
float  poiTol    = input.float(0.3, "POI Touch Tolerance (x ATR)", step=0.05, group="② Aggression Proxy")

int    cooldown  = input.int(6, "Signal Cooldown (bars)", minval=1, group="③ Engine")
bool   showBands = input.bool(true, "Show VWAP + SD Bands", group="③ Engine")

// v2 — from live-session transcript: failed-auction weakening + CVD
int    rejMax    = input.int(3, "Max Level Rejections (then setup = weak)", minval=1, maxval=10, group="④ Execution Quality v2")
bool   useRejGate= input.bool(true, "Suppress JOIN at weak (over-rejected) levels", group="④ Execution Quality v2")
bool   useCvd    = input.bool(true, "CVD Divergence Warnings", group="④ Execution Quality v2")

// ── Session state ────────────────────────────────────────────
bool inSess  = not na(time(timeframe.period, sessStr, "America/New_York"))
bool newSess = inSess and not inSess[1]
int  hhmm    = hour(time, "America/New_York") * 100 + minute(time, "America/New_York")

// ── Session-anchored VWAP + standard deviations ──────────────
var float cumPV  = 0.0
var float cumV   = 0.0
var float cumPV2 = 0.0
if newSess
    cumPV  := 0.0
    cumV   := 0.0
    cumPV2 := 0.0
if inSess
    cumPV  += hlc3 * volume
    cumV   += volume
    cumPV2 += hlc3 * hlc3 * volume

float vwap = cumV > 0 ? cumPV / cumV : na
float varv = cumV > 0 ? math.max(cumPV2 / cumV - vwap * vwap, 0.0) : na
float sd   = math.sqrt(varv)
float sd1u = vwap + sd
float sd1d = vwap - sd
float sd2u = vwap + 2 * sd
float sd2d = vwap - 2 * sd

// ── Initial balance ──────────────────────────────────────────
var float ibHi = na
var float ibLo = na
var int   sessStartMs = na
if newSess
    ibHi := high
    ibLo := low
    sessStartMs := time
bool ibForming = inSess and not na(sessStartMs) and (time - sessStartMs) < ibMins * 60000
if ibForming
    ibHi := math.max(ibHi, high)
    ibLo := math.min(ibLo, low)
bool ibDone = inSess and not ibForming and not na(ibHi)

// ── Day bias: IB breakout + VWAP side (Valentini: trade the
//    direction the session accepted, never predict) ───────────
var int bias = 0
if newSess
    bias := 0
if ibDone
    if close > ibHi and close > vwap
        bias := 1
    else if close < ibLo and close < vwap
        bias := -1
    // bias persists; flips only on opposite breakout

// ── Aggression proxy (footprint stand-in) ────────────────────
float atrv    = ta.atr(14)
float avgVol  = ta.sma(volume, 20)
bool  volAgg  = volume >= avgVol * volMult
float body    = math.abs(close - open)
bool  bodyAgg = (high - low) > 0 and body >= (high - low) * bodyPct
bool  aggUp   = volAgg and bodyAgg and close > open
bool  aggDn   = volAgg and bodyAgg and close < open

// ── POI touch: pullback into VWAP or the IB edge ─────────────
bool poiTouchLong  = low  <= math.max(vwap, ibHi) + atrv * poiTol and low  >= math.min(vwap, ibHi) - atrv * poiTol
bool poiTouchShort = high >= math.min(vwap, ibLo) - atrv * poiTol and high <= math.max(vwap, ibLo) + atrv * poiTol
bool pulledBackL   = poiTouchLong  or poiTouchLong[1]  or poiTouchLong[2]
bool pulledBackS   = poiTouchShort or poiTouchShort[1] or poiTouchShort[2]

// ── Cooldown ─────────────────────────────────────────────────
var int lastSig = -9999
bool cd = bar_index - lastSig > cooldown

// ── v2: Failed-auction weakening (rejection counter) ─────────
// Valentini: every rejection at the attacked level weakens the
// setup. After rejMax rejections, JOINs are suppressed until the
// level actually breaks (acceptance resets the count).
float atkHi = ta.highest(high, 20)[1]
float atkLo = ta.lowest(low, 20)[1]
var int rejUp = 0
var int rejDn = 0
if newSess
    rejUp := 0
    rejDn := 0
if inSess
    if high >= atkHi - atrv * 0.1 and close < atkHi
        rejUp += 1
    if close > atkHi
        rejUp := 0
    if low <= atkLo + atrv * 0.1 and close > atkLo
        rejDn += 1
    if close < atkLo
        rejDn := 0
bool weakUp = rejUp >= rejMax
bool weakDn = rejDn >= rejMax

// ── v2: CVD (candle-direction proxy) + divergence warning ────
var float cvd = 0.0
if newSess
    cvd := 0.0
cvd += close > open ? volume : close < open ? -volume : 0.0

float ph = ta.pivothigh(high, 5, 5)
float pl = ta.pivotlow(low, 5, 5)
var float lastPhPrice = na
var float lastPhCvd   = na
var float lastPlPrice = na
var float lastPlCvd   = na
bool bearDiv = false
bool bullDiv = false
if not na(ph)
    if not na(lastPhPrice) and ph > lastPhPrice and cvd[5] < lastPhCvd
        bearDiv := true
    lastPhPrice := ph
    lastPhCvd   := cvd[5]
if not na(pl)
    if not na(lastPlPrice) and pl < lastPlPrice and cvd[5] > lastPlCvd
        bullDiv := true
    lastPlPrice := pl
    lastPlCvd   := cvd[5]

// ── JOIN signals: bias + pullback to POI + aggression resume ─
bool joinLong  = cd and ibDone and bias == 1  and pulledBackL and aggUp  and close > vwap and (not useRejGate or not weakUp)
bool joinShort = cd and ibDone and bias == -1 and pulledBackS and aggDn  and close < vwap and (not useRejGate or not weakDn)

// ── REVERT signals: late session, back inside 2nd SD band ────
bool revWindow   = inSess and hhmm >= revStart
bool revertLong  = cd and revWindow and close[1] < sd2d[1] and close > sd2d and close < vwap
bool revertShort = cd and revWindow and close[1] > sd2u[1] and close < sd2u and close > vwap

if joinLong or joinShort or revertLong or revertShort
    lastSig := bar_index

// ── Chart printing ───────────────────────────────────────────
plot(showBands and inSess ? vwap : na, "VWAP",  color.new(color.orange, 0), 2, plot.style_linebr)
plot(showBands and inSess ? sd1u : na, "+1SD", color.new(color.gray, 60), 1, plot.style_linebr)
plot(showBands and inSess ? sd1d : na, "-1SD", color.new(color.gray, 60), 1, plot.style_linebr)
plot(showBands and inSess ? sd2u : na, "+2SD", color.new(color.red, 40), 1, plot.style_linebr)
plot(showBands and inSess ? sd2d : na, "-2SD", color.new(color.green, 40), 1, plot.style_linebr)
plot(ibDone ? ibHi : na, "IB High", color.new(color.aqua, 40), 1, plot.style_linebr)
plot(ibDone ? ibLo : na, "IB Low",  color.new(color.aqua, 40), 1, plot.style_linebr)
bgcolor(ibForming ? color.new(color.blue, 94) : na, title="Initial Balance forming")

if joinLong
    label.new(bar_index, low, "JOIN ▲", style=label.style_label_up, color=color.new(#00C853, 10), textcolor=color.white, size=size.small)
if joinShort
    label.new(bar_index, high, "JOIN ▼", style=label.style_label_down, color=color.new(#D50000, 10), textcolor=color.white, size=size.small)
if revertLong
    label.new(bar_index, low, "REVERT ▲ tgt VWAP", style=label.style_label_up, color=color.new(#00B0FF, 10), textcolor=color.white, size=size.small)
if revertShort
    label.new(bar_index, high, "REVERT ▼ tgt VWAP", style=label.style_label_down, color=color.new(#FF6D00, 10), textcolor=color.white, size=size.small)

// v2 warnings
if useRejGate and weakUp and not weakUp[1]
    label.new(bar_index, high, "WEAK HIGH (" + str.tostring(rejUp) + " rejections)", style=label.style_label_down, color=color.new(color.gray, 30), textcolor=color.white, size=size.tiny)
if useRejGate and weakDn and not weakDn[1]
    label.new(bar_index, low, "WEAK LOW (" + str.tostring(rejDn) + " rejections)", style=label.style_label_up, color=color.new(color.gray, 30), textcolor=color.white, size=size.tiny)
if useCvd and bearDiv
    label.new(bar_index, high, "CVD DIV ▼", style=label.style_label_down, color=color.new(#AA00FF, 20), textcolor=color.white, size=size.tiny)
if useCvd and bullDiv
    label.new(bar_index, low, "CVD DIV ▲", style=label.style_label_up, color=color.new(#AA00FF, 20), textcolor=color.white, size=size.tiny)

// ── Alerts (bar close) ───────────────────────────────────────
alertcondition(joinLong,    "JOIN Long",    "Valentini: momentum-join long — {{ticker}} {{interval}}")
alertcondition(joinShort,   "JOIN Short",   "Valentini: momentum-join short — {{ticker}} {{interval}}")
alertcondition(revertLong,  "REVERT Long",  "Valentini: 2SD revert long to VWAP — {{ticker}} {{interval}}")
alertcondition(revertShort, "REVERT Short", "Valentini: 2SD revert short to VWAP — {{ticker}} {{interval}}")
alertcondition(joinLong or joinShort or revertLong or revertShort, "ANY Valentini Signal", "Valentini signal — {{ticker}} {{interval}}")
alertcondition(bearDiv, "CVD Bearish Divergence", "Valentini v2: CVD bearish divergence — {{ticker}} {{interval}}")
alertcondition(bullDiv, "CVD Bullish Divergence", "Valentini v2: CVD bullish divergence — {{ticker}} {{interval}}")
