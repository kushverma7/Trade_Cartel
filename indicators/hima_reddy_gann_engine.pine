alertcondition(channelAlertUp, "Channel Alert (up)", "Hima Reddy Gann Engine -- price crossed the projected up-channel -- {{ticker}} {{interval}}")
alertcondition(channelAlertDn, "Channel Alert (down)", "Hima Reddy Gann Engine -- price crossed the projected down-channel -- {{ticker}} {{interval}}")
alertcondition(trailStopHit, "2-Bar Trail Stop Hit", "Hima Reddy Gann Engine -- 2-bar trailing stop hit -- {{ticker}} {{interval}}")
