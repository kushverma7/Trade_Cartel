//@version=6
indicator("Trade Cartel - Hima Reddy Gann Trading Engine", shorttitle="TC-HRGann", overlay=true, max_lines_count=100, max_labels_count=200, max_boxes_count=60, max_bars_back=5000)
// NOTE: 5000 is Pine Script's hard technical ceiling for max_bars_back --
// TradingView does not allow a higher value regardless of what a script
// requests, so this is the real maximum, not a design choice. The trade
// simulator below (win/loss/R tracking) is NOT limited by this parameter
// at all -- it accumulates forward bar-by-bar over however much history
// your chart has loaded, so trade-count stats are effectively unbounded.

// ============================================================
// Voice #19 -- "The Trading Methodologies of W.D. Gann" by Hima
// Reddy (2013). See trader_playbooks/hima_reddy_gann_methodology.md
// for the full extraction. DIFFERENT voice from
// gann_square_of_nine_engine.pine (voice #16, Gann's own Square of
// Nine / angle / time-cycle work) -- zero overlap, do not merge.
//
// IMPORTANT: the "Gann Box" BUY ZONE / SELL ZONE styling the user
// referenced (Telegram screenshots, "WDGANN SANDIP GANN BOX") is
// CONFIRMED NOT sourced from this book -- the term never appears in
// it, and it never describes a rectangular geometric price-time grid.
// This engine builds the visual language (shaded zones, multi-TF RSI
// table) from the book's REAL documented mechanics instead: eighths
// retracement (with a tolerance zone, our own convention -- the book
// only describes single LINES, not bands), RSI-applied retracement,
// test-failure, double/triple top-bottom breaks, and the trendline-
// parallel "channel" construction.
//
// UNTESTED -- brand new construct, no backtest. Per this project's
// 2026-07-20 standing rule, nothing here is "proven" or "flagship".
// ============================================================

// ── Swing detection ──────────────────────────────────────────
pw = input.int(5, "Pivot Width (bars)", minval=2, maxval=15, group="Swing")

// ── Eighths retracement ──────────────────────────────────────
showZones = input.bool(true, "Show Eighths Retracement Zones", group="Eighths Retracement")
zoneTolMult = input.float(0.25, "Zone Tolerance (x ATR)", minval=0.05, step=0.05, group="Eighths Retracement")

// ── RSI ───────────────────────────────────────────────────────
rsiLen = input.int(14, "RSI Length", group="RSI")
rsiPw  = input.int(5,  "RSI Pivot Width (bars)", minval=2, maxval=15, group="RSI")

// ── Signals ───────────────────────────────────────────────────
use50Sig      = input.bool(true, "50% Retracement Buy/Sell (Point #7)", group="Signals")
useTestFail   = input.bool(true, "Test-Failure Signal (2-bar rule)",    group="Signals")
useDblTriple  = input.bool(true, "Double/Triple Top-Bottom Break",      group="Signals")
useTimeExceed = input.bool(true, "Time-Exceedance Confluence (Pts #4/#5)", group="Signals")
cooldown      = input.int(10, "Cooldown Bars", minval=0, group="Signals")

// ── Channel ───────────────────────────────────────────────────
showChannel = input.bool(true, "Show Trendline + Parallel Channel", group="Channel")

// ── Exits (informational) ────────────────────────────────────
atrLen = input.int(14, "ATR Length", group="Exits")
trailBuf = input.float(0.1, "2-Bar Trail Buffer (x ATR)", step=0.05, group="Exits")

// ── Trade Simulator (your own TP/SL, auto win/loss/R tracking) ──
simEnabled = input.bool(true, "Enable Trade Simulator", group="Trade Simulator")
slModeInput = input.string("Structural (2-bar)", "Stop Loss Mode",
     options=["Structural (2-bar)", "ATR Multiple", "Fixed Points"], group="Trade Simulator")
slAtrMult   = input.float(1.0, "SL: ATR Multiple (or 2-bar buffer x ATR)", step=0.1, group="Trade Simulator")
slFixedPts  = input.float(5.0, "SL: Fixed Points", step=0.5, group="Trade Simulator")
tpModeInput = input.string("Risk:Reward Ratio", "Take Profit Mode",
     options=["Risk:Reward Ratio", "ATR Multiple", "Fixed Points"], group="Trade Simulator")
rrRatio     = input.float(2.0, "TP: Risk:Reward Ratio (e.g. 2.0 = 2:1)", minval=0.1, step=0.1, group="Trade Simulator")
tpAtrMult   = input.float(2.0, "TP: ATR Multiple", step=0.1, group="Trade Simulator")
tpFixedPts  = input.float(10.0, "TP: Fixed Points", step=0.5, group="Trade Simulator")
showSimTable = input.bool(true, "Show Trade Results Table", group="Trade Simulator")

// ── Display ───────────────────────────────────────────────────
showCandles = input.bool(true, "Color Candles (4-color scheme, our own convention)", group="Display")
showTable   = input.bool(true, "Show Status / Multi-TF RSI Table", group="Display")

// ══ BASICS ════════════════════════════════════════════════════
atr = ta.atr(atrLen)
zoneTol = atr * zoneTolMult

// ══ PRICE SWING (alternating leg, same idiom as fibo storyline /
//    quarters price engine elsewhere in this repo) ══════════════
ph = ta.pivothigh(pw, pw)
pl = ta.pivotlow(pw, pw)

var float prevPivot = na
var int   prevPivotBar = na
var bool  prevWasHigh = false
var float legA = na
var float legB = na
var int   legABar = na
var int   legBBar = na
var int   legDir = 0
bool legFormed = false

var float[] lowPivots  = array.new_float()
var int[]   lowPivotBars = array.new_int()
var float[] highPivots = array.new_float()
var int[]   highPivotBars = array.new_int()

if not na(ph)
    if not na(prevPivot) and not prevWasHigh
        legA := prevPivot
        legB := ph
        legABar := prevPivotBar
        legBBar := bar_index - pw
        legDir := 1
        legFormed := true
    array.unshift(highPivots, ph)
    array.unshift(highPivotBars, bar_index - pw)
    if array.size(highPivots) > 3
        array.pop(highPivots)
        array.pop(highPivotBars)
    prevPivot := ph
    prevPivotBar := bar_index - pw
    prevWasHigh := true

if not na(pl)
    if not na(prevPivot) and prevWasHigh
        legA := prevPivot
        legB := pl
        legABar := prevPivotBar
        legBBar := bar_index - pw
        legDir := -1
        legFormed := true
    array.unshift(lowPivots, pl)
    array.unshift(lowPivotBars, bar_index - pw)
    if array.size(lowPivots) > 3
        array.pop(lowPivots)
        array.pop(lowPivotBars)
    prevPivot := pl
    prevPivotBar := bar_index - pw
    prevWasHigh := false

// ══ EIGHTHS RETRACEMENT GRID ════════════════════════════════════
f_eighthLevel(_pct) =>
    na(legA) or na(legB) ? na : legB - (legB - legA) * _pct / 100.0

var box[] zoneBoxes = array.new_box()
var label[] zoneLabels = array.new_label()

if legFormed and showZones
    if array.size(zoneBoxes) > 0
        for i = 0 to array.size(zoneBoxes) - 1
            box.delete(array.get(zoneBoxes, i))
            label.delete(array.get(zoneLabels, i))
    array.clear(zoneBoxes)
    array.clear(zoneLabels)
    pctLevels = array.from(0.0, 12.5, 25.0, 37.5, 50.0, 62.5, 75.0, 87.5, 100.0)
    for i = 0 to array.size(pctLevels) - 1
        pct = array.get(pctLevels, i)
        lvl = f_eighthLevel(pct)
        isFifty = pct == 50.0
        boxColor = lvl > close ? color.new(color.red, 85) : color.new(color.aqua, 85)
        b = box.new(bar_index, lvl + zoneTol, bar_index + 40, lvl - zoneTol,
             border_color=isFifty ? color.new(color.yellow, 20) : color.new(color.gray, 60),
             bgcolor=boxColor, border_width=isFifty ? 2 : 1)
        array.push(zoneBoxes, b)
        lbl = label.new(bar_index + 40, lvl, (lvl > close ? "SELL " : "BUY ") + str.tostring(pct, "#.#") + "%",
             style=label.style_label_left, color=color.new(color.black, 100),
             textcolor=lvl > close ? color.red : color.aqua, size=size.tiny)
        array.push(zoneLabels, lbl)

level50 = f_eighthLevel(50.0)

// nearest eighths level to current close (for test-failure detector)
float nearestEighth = na
float nearestEighthDist = na
if not na(legA) and not na(legB)
    pctLevels2 = array.from(0.0, 12.5, 25.0, 37.5, 50.0, 62.5, 75.0, 87.5, 100.0)
    for i = 0 to array.size(pctLevels2) - 1
        lvl2 = f_eighthLevel(array.get(pctLevels2, i))
        d = math.abs(close - lvl2)
        if na(nearestEighthDist) or d < nearestEighthDist
            nearestEighthDist := d
            nearestEighth := lvl2

// ══ RSI + RSI's OWN EIGHTHS RETRACEMENT (book's RSI-applied variant) ═
rsi = ta.rsi(close, rsiLen)
rph = ta.pivothigh(rsi, rsiPw, rsiPw)
rpl = ta.pivotlow(rsi, rsiPw, rsiPw)

var float rPrevPivot = na
var bool  rPrevWasHigh = false
var float rLegA = na
var float rLegB = na
var int   rLegDir = 0

if not na(rph)
    if not na(rPrevPivot) and not rPrevWasHigh
        rLegA := rPrevPivot
        rLegB := rph
        rLegDir := 1
    rPrevPivot := rph
    rPrevWasHigh := true
if not na(rpl)
    if not na(rPrevPivot) and rPrevWasHigh
        rLegA := rPrevPivot
        rLegB := rpl
        rLegDir := -1
    rPrevPivot := rpl
    rPrevWasHigh := false

rsi50 = na(rLegA) or na(rLegB) ? na : rLegB - (rLegB - rLegA) * 0.5
// confluence: RSI holding on the trend side of its OWN 50% retracement
bool rsiConfluenceBull = not na(rsi50) and rLegDir == 1  and rsi > rsi50
bool rsiConfluenceBear = not na(rsi50) and rLegDir == -1 and rsi < rsi50

// ══ SIGNAL 1: 50% RETRACEMENT BUY/SELL (Buying/Selling Point #7) ═══
bool touched50 = not na(level50) and low <= level50 + zoneTol and high >= level50 - zoneTol
bool sig50Buy  = use50Sig and legDir == 1  and touched50 and close > level50 and rsiConfluenceBull
bool sig50Sell = use50Sig and legDir == -1 and touched50 and close < level50 and rsiConfluenceBear

// ══ SIGNAL 2: TEST-FAILURE (2-bar window, both directions) ═════════
bool testFailBear = useTestFail and not na(nearestEighth) and
     ((high > nearestEighth and close < nearestEighth) or
      (high[1] > nearestEighth and close[1] >= nearestEighth and close < nearestEighth))
bool testFailBull = useTestFail and not na(nearestEighth) and
     ((low < nearestEighth and close > nearestEighth) or
      (low[1] < nearestEighth and close[1] <= nearestEighth and close > nearestEighth))

// ══ SIGNAL 3: DOUBLE/TRIPLE TOP-BOTTOM BREAK ═══════════════════════
var float dbLow = na
var int   dbCount = 1
var float dbBreakoutHigh = na
if not na(pl)
    if not na(dbLow) and math.abs(pl - dbLow) <= zoneTol
        dbCount += 1
    else
        dbCount := 1
    dbLow := pl
    dbBreakoutHigh := na
if dbCount >= 2
    dbBreakoutHigh := na(dbBreakoutHigh) ? high : math.max(dbBreakoutHigh, high)
bool dblBottomBreak = useDblTriple and dbCount >= 2 and not na(dbBreakoutHigh[1]) and
     close > dbBreakoutHigh[1] and close[1] <= dbBreakoutHigh[1]

var float dtHigh = na
var int   dtCount = 1
var float dtBreakoutLow = na
if not na(ph)
    if not na(dtHigh) and math.abs(ph - dtHigh) <= zoneTol
        dtCount += 1
    else
        dtCount := 1
    dtHigh := ph
    dtBreakoutLow := na
if dtCount >= 2
    dtBreakoutLow := na(dtBreakoutLow) ? low : math.min(dtBreakoutLow, low)
bool dblTopBreak = useDblTriple and dtCount >= 2 and not na(dtBreakoutLow[1]) and
     close < dtBreakoutLow[1] and close[1] >= dtBreakoutLow[1]

// ══ SIGNAL 4: TIME-EXCEEDANCE CONFLUENCE (Buying/Selling Points #4/#5) ═
var int lastBullLegBars = na
var int lastBearLegBars = na
if legFormed
    barsInLeg = legBBar - legABar
    if legDir == 1
        lastBearLegBars := barsInLeg
    else
        lastBullLegBars := barsInLeg
barsSinceLastPivot = na(prevPivotBar) ? na : bar_index - prevPivotBar
bool timeExceedBull = useTimeExceed and prevWasHigh == false and not na(lastBearLegBars) and
     not na(barsSinceLastPivot) and barsSinceLastPivot > lastBearLegBars
bool timeExceedBear = useTimeExceed and prevWasHigh == true and not na(lastBullLegBars) and
     not na(barsSinceLastPivot) and barsSinceLastPivot > lastBullLegBars

// ══ COMBINED SIGNAL + COOLDOWN ══════════════════════════════════════
var int lastSigBar = -100000
bool rawBuy  = sig50Buy  or testFailBull or dblBottomBreak
bool rawSell = sig50Sell or testFailBear or dblTopBreak
bool buy  = rawBuy  and (bar_index - lastSigBar) > cooldown
bool sell = rawSell and (bar_index - lastSigBar) > cooldown
if buy or sell
    lastSigBar := bar_index

// ══ TRENDLINE + PARALLEL CHANNEL (from origin bar's opposite extreme) ═
var line upTL = na
var line upChannel = na
var line dnTL = na
var line dnChannel = na
var float chNow  = na
var float chNowD = na

if showChannel and array.size(lowPivots) >= 2
    lowB1 = array.get(lowPivotBars, 1)
    lowB0 = array.get(lowPivotBars, 0)
    lowV1 = array.get(lowPivots, 1)
    lowV0 = array.get(lowPivots, 0)
    if lowB0 != lowB1
        slopeUp = (lowV0 - lowV1) / (lowB0 - lowB1)
        tlNow = lowV1 + slopeUp * (bar_index - lowB1)
        originHigh = high[bar_index - lowB1]
        chNow := originHigh + slopeUp * (bar_index - lowB1)
        line.delete(upTL)
        line.delete(upChannel)
        upTL := line.new(lowB1, lowV1, bar_index, tlNow, color=color.new(color.lime, 30), width=1)
        upChannel := line.new(lowB1, originHigh, bar_index, chNow, color=color.new(color.lime, 60), style=line.style_dashed, width=1)

if showChannel and array.size(highPivots) >= 2
    hiB1 = array.get(highPivotBars, 1)
    hiB0 = array.get(highPivotBars, 0)
    hiV1 = array.get(highPivots, 1)
    hiV0 = array.get(highPivots, 0)
    if hiB0 != hiB1
        slopeDn = (hiV0 - hiV1) / (hiB0 - hiB1)
        tlNowD = hiV1 + slopeDn * (bar_index - hiB1)
        originLow = low[bar_index - hiB1]
        chNowD := originLow + slopeDn * (bar_index - hiB1)
        line.delete(dnTL)
        line.delete(dnChannel)
        dnTL := line.new(hiB1, hiV1, bar_index, tlNowD, color=color.new(color.red, 30), width=1)
        dnChannel := line.new(hiB1, originLow, bar_index, chNowD, color=color.new(color.red, 60), style=line.style_dashed, width=1)

// ta.crossunder/crossover called unconditionally every bar for
// consistency (compiler warning fix) -- chNow/chNowD persist via var
// so the cross still evaluates correctly against the last-drawn channel
bool channelAlertUp = ta.crossunder(close, chNow)
bool channelAlertDn = ta.crossover(close, chNowD)

// ══ SUGGESTED 2-BAR TRAILING STOP (Reddy's runaway-move exit rule) ═
var int   sigEntryBar = na
var int   sigDir = 0
if buy
    sigEntryBar := bar_index
    sigDir := 1
if sell
    sigEntryBar := bar_index
    sigDir := -1
float trail2Bar = sigDir == 1 ? low[2] - atr * trailBuf : sigDir == -1 ? high[2] + atr * trailBuf : na
bool trailStopHit = not na(sigEntryBar) and bar_index > sigEntryBar and
     ((sigDir == 1 and close < trail2Bar) or (sigDir == -1 and close > trail2Bar))
if trailStopHit
    sigDir := 0
    sigEntryBar := na

// ══ TRADE SIMULATOR — your SL/TP settings, RR-based exit, auto
//    win/loss/R tracking. One trade at a time (flat before next entry,
//    matching this project's no-pyramiding standing rule). Entries only
//    on the fired buy/sell signal; SL/TP fixed at entry, not repainted.
// ══════════════════════════════════════════════════════════════════
f_slPrice(_dir) =>
    float result = na
    if slModeInput == "Structural (2-bar)"
        result := _dir == 1 ? low[2] - atr * slAtrMult : high[2] + atr * slAtrMult
    else if slModeInput == "ATR Multiple"
        result := _dir == 1 ? close - atr * slAtrMult : close + atr * slAtrMult
    else
        result := _dir == 1 ? close - slFixedPts : close + slFixedPts
    result

f_tpPrice(_dir, _entry, _stop) =>
    slDist = math.abs(_entry - _stop)
    float result = na
    if tpModeInput == "Risk:Reward Ratio"
        result := _dir == 1 ? _entry + slDist * rrRatio : _entry - slDist * rrRatio
    else if tpModeInput == "ATR Multiple"
        result := _dir == 1 ? _entry + atr * tpAtrMult : _entry - atr * tpAtrMult
    else
        result := _dir == 1 ? _entry + tpFixedPts : _entry - tpFixedPts
    result

var bool  inTrade   = false
var int   tDir      = 0
var float tEntry    = na
var float tStop     = na
var float tTarget   = na
var int   tEntryBar = na

var int   totalTrades = 0
var int   simWins     = 0
var int   simLosses   = 0
var float sumR        = 0.0
var float grossWinR   = 0.0
var float grossLossR  = 0.0

if simEnabled and not inTrade and (buy or sell)
    tDir      := buy ? 1 : -1
    tEntry    := close
    tStop     := f_slPrice(tDir)
    tTarget   := f_tpPrice(tDir, tEntry, tStop)
    tEntryBar := bar_index
    inTrade   := true

if simEnabled and inTrade and bar_index > tEntryBar
    bool hitStop   = tDir == 1 ? low <= tStop   : high >= tStop
    bool hitTarget = tDir == 1 ? high >= tTarget : low <= tTarget
    // conservative: if both the stop and target could have been hit on
    // the same bar, assume the stop hit first (worst case, not optimistic)
    if hitStop
        totalTrades += 1
        simLosses += 1
        sumR += -1.0
        grossLossR += 1.0
        inTrade := false
    else if hitTarget
        rMultiple = math.abs(tEntry - tStop) > 0 ? math.abs(tTarget - tEntry) / math.abs(tEntry - tStop) : na
        totalTrades += 1
        simWins += 1
        sumR += rMultiple
        grossWinR += rMultiple
        inTrade := false

float simWinRate = totalTrades > 0 ? simWins / totalTrades * 100.0 : na
float simAvgR    = totalTrades > 0 ? sumR / totalTrades : na
float simPF      = grossLossR > 0 ? grossWinR / grossLossR : na

// live SL/TP lines for the open simulated trade
var line simEntryLine = na
var line simStopLine  = na
var line simTpLine    = na
if simEnabled and inTrade and bar_index == tEntryBar
    line.delete(simEntryLine)
    line.delete(simStopLine)
    line.delete(simTpLine)
    simEntryLine := line.new(tEntryBar, tEntry,  tEntryBar + 50, tEntry,  color=color.new(color.white, 20), style=line.style_dotted)
    simStopLine  := line.new(tEntryBar, tStop,   tEntryBar + 50, tStop,   color=color.new(color.red, 20),   style=line.style_dashed)
    simTpLine    := line.new(tEntryBar, tTarget, tEntryBar + 50, tTarget, color=color.new(color.lime, 20),  style=line.style_dashed)

// ══ SIGNAL LABELS ═══════════════════════════════════════════════════
if buy
    label.new(bar_index, low - atr * 0.3, "BUY", style=label.style_label_up,
         color=color.new(color.aqua, 0), textcolor=color.black, size=size.small)
if sell
    label.new(bar_index, high + atr * 0.3, "SELL", style=label.style_label_down,
         color=color.new(color.yellow, 0), textcolor=color.black, size=size.small)

// ══ 4-COLOR CANDLES (our own convention -- not sourced, matching the
//    visual style requested: yellow = test-failure, teal = confirmed
//    double/triple break, else standard blue/red by close vs open) ═══
candleColor = testFailBear or testFailBull ? color.yellow :
     (dblBottomBreak or dblTopBreak) ? color.teal :
     close > open ? color.blue : color.red
barcolor(showCandles ? candleColor : na)

// ══ MULTI-TIMEFRAME RSI (matches the screenshot's bottom-right panel) ═
rsi1  = request.security(syminfo.tickerid, "1",   ta.rsi(close, rsiLen), lookahead=barmerge.lookahead_on)
rsi5  = request.security(syminfo.tickerid, "5",   ta.rsi(close, rsiLen), lookahead=barmerge.lookahead_on)
rsi15 = request.security(syminfo.tickerid, "15",  ta.rsi(close, rsiLen), lookahead=barmerge.lookahead_on)
rsi60 = request.security(syminfo.tickerid, "60",  ta.rsi(close, rsiLen), lookahead=barmerge.lookahead_on)
rsi240= request.security(syminfo.tickerid, "240", ta.rsi(close, rsiLen), lookahead=barmerge.lookahead_on)
rsiD  = request.security(syminfo.tickerid, "D",   ta.rsi(close, rsiLen), lookahead=barmerge.lookahead_on)

f_rsiColor(_v) => _v >= 70 ? color.new(color.red, 20) : _v <= 30 ? color.new(color.green, 20) : color.new(color.gray, 40)

// ══ STATUS TABLE ═════════════════════════════════════════════════════
if showTable and barstate.islast
    var table dash = table.new(position.bottom_right, 6, 3, border_width = 1)
    table.cell(dash, 0, 0, "1m",  bgcolor=color.new(color.purple, 60), text_color=color.white)
    table.cell(dash, 1, 0, "5m",  bgcolor=color.new(color.purple, 60), text_color=color.white)
    table.cell(dash, 2, 0, "15m", bgcolor=color.new(color.purple, 60), text_color=color.white)
    table.cell(dash, 3, 0, "1H",  bgcolor=color.new(color.purple, 60), text_color=color.white)
    table.cell(dash, 4, 0, "4H",  bgcolor=color.new(color.purple, 60), text_color=color.white)
    table.cell(dash, 5, 0, "1D",  bgcolor=color.new(color.purple, 60), text_color=color.white)
    table.cell(dash, 0, 1, str.tostring(rsi1,  "#.#"),  bgcolor=f_rsiColor(rsi1))
    table.cell(dash, 1, 1, str.tostring(rsi5,  "#.#"),  bgcolor=f_rsiColor(rsi5))
    table.cell(dash, 2, 1, str.tostring(rsi15, "#.#"),  bgcolor=f_rsiColor(rsi15))
    table.cell(dash, 3, 1, str.tostring(rsi60, "#.#"),  bgcolor=f_rsiColor(rsi60))
    table.cell(dash, 4, 1, str.tostring(rsi240,"#.#"),  bgcolor=f_rsiColor(rsi240))
    table.cell(dash, 5, 1, str.tostring(rsiD,  "#.#"),  bgcolor=f_rsiColor(rsiD))
    table.merge_cells(dash, 0, 2, 5, 2)
    table.cell(dash, 0, 2, "50% RSI confluence: " + (rsiConfluenceBull ? "bull" : rsiConfluenceBear ? "bear" : "n/a"),
         text_color=rsiConfluenceBull ? color.green : rsiConfluenceBear ? color.red : color.gray)

// ══ TRADE SIMULATOR RESULTS TABLE ═══════════════════════════════════
if simEnabled and showSimTable and barstate.islast
    var table simTable = table.new(position.top_left, 2, 8, border_width = 1)
    table.cell(simTable, 0, 0, "Trade Simulator", bgcolor = color.new(color.purple, 60), text_color = color.white)
    table.cell(simTable, 1, 0, "", bgcolor = color.new(color.purple, 60))
    table.cell(simTable, 0, 1, "SL mode")
    table.cell(simTable, 1, 1, slModeInput)
    table.cell(simTable, 0, 2, "TP mode")
    table.cell(simTable, 1, 2, tpModeInput == "Risk:Reward Ratio" ? "RR " + str.tostring(rrRatio, "#.#") + ":1" : tpModeInput)
    table.cell(simTable, 0, 3, "Open trade")
    table.cell(simTable, 1, 3, inTrade ? (tDir == 1 ? "LONG @ " + str.tostring(tEntry, format.mintick) : "SHORT @ " + str.tostring(tEntry, format.mintick)) : "flat",
         text_color = inTrade ? (tDir == 1 ? color.aqua : color.yellow) : color.gray)
    table.cell(simTable, 0, 4, "Total trades")
    table.cell(simTable, 1, 4, str.tostring(totalTrades))
    table.cell(simTable, 0, 5, "Win rate")
    table.cell(simTable, 1, 5, na(simWinRate) ? "n/a" : str.tostring(simWinRate, "#.#") + "% (" + str.tostring(simWins) + "W/" + str.tostring(simLosses) + "L)",
         text_color = na(simWinRate) ? color.gray : simWinRate >= 50 ? color.green : color.red)
    table.cell(simTable, 0, 6, "Avg R / trade")
    table.cell(simTable, 1, 6, na(simAvgR) ? "n/a" : str.tostring(simAvgR, "#.##"),
         text_color = na(simAvgR) ? color.gray : simAvgR >= 0 ? color.green : color.red)
    table.cell(simTable, 0, 7, "Total R / PF-analog")
    table.cell(simTable, 1, 7, str.tostring(sumR, "#.##") + " / " + (na(simPF) ? "n/a" : str.tostring(simPF, "#.##")),
         text_color = sumR >= 0 ? color.green : color.red)

// ══ PLOTS ════════════════════════════════════════════════════════════
plot(showZones and not na(level50) ? level50 : na, "50% Level", color=color.new(color.yellow, 40), linewidth=2)

