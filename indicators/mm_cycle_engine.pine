// ============================================================
// MM CYCLE ENGINE [Real-Time] — Steve / MMM4x market-maker model
// Source: trader_playbooks/steve_mm_cycle.md (INDEPENDENT voice #8)
//
// Mechanics kept (mythology discarded):
//   - ET time grid: 17:00 reset, Asia accumulation range, gap-time
//     shadows 03:00-03:30 / 09:00-09:30, London 03:30, NY 09:30
//   - Stop-hunt zones: fixed-depth tiers beyond the Asia range
//     (FX 25/50 pips -> price-unit inputs, gold default $2.5/$5)
//   - BRINKS windows: 03:30-03:45 & 09:30-09:45 ET — hammer/spike
//     forming (or retesting) the day extreme = reversal signal
//   - TRIPLE TAP: 3 tests of day H/L without a body break = fade
//   - Level counter: distance from daily anchor in ADR/3 units,
//     level 3 = reversal watch
//   - HOD/LOD lock: extreme unbroken 30-90 min = safe to trade away
//   - v2 (same lineage, student mentoring call): EMA 5/13/50/200/800
//     level-classification stack, peak-to-peak FULL-ADR box stack
//     (distinct from the ADR/3 level counter), TDI shark-fin proxy,
//     railroad-track candle tagging, ID50 EMA200 rotation reentry,
//     standard daily pivots (source's own M-numbering undocumented)
//
// EDGE STATUS: zero verified stats from source ("90%" = marketing).
// Observation + confluence testing only (H20-H24, v2 additions
// unnumbered pending backtest). All signals on bar close, non-
// repainting. Built for 15m (his TF); works intraday.
// ============================================================
//@version=6
indicator("MM Cycle Engine [Real-Time]", overlay=true, max_boxes_count=60, max_labels_count=500)

// ── Inputs ───────────────────────────────────────────────────
string asiaSess = input.session("1700-0300", "Asia Accumulation Range (ET)", group="① Time Grid")
bool   showGrid = input.bool(true, "Shade Gap Times + Brinks Windows", group="① Time Grid")
float  z1       = input.float(2.5, "Stop-Hunt Zone Tier 1 (price units)", minval=0.0, step=0.5, group="② Stop-Hunt Zones", tooltip="FX: 25 pips. Gold default $2.5.")
float  z2       = input.float(5.0, "Stop-Hunt Zone Tier 2 (price units)", minval=0.0, step=0.5, group="② Stop-Hunt Zones", tooltip="FX: 50 pips. Gold default $5. Hunts should exhaust inside tier 2.")
bool   showZone = input.bool(true, "Draw Stop-Hunt Zone Boxes", group="② Stop-Hunt Zones")
float  wickFr   = input.float(0.5, "Brinks Hammer: min wick fraction", minval=0.3, maxval=0.8, step=0.05, group="③ Brinks")
float  tolAtr   = input.float(0.25, "Extreme Retest Tolerance (x ATR)", step=0.05, group="③ Brinks")
int    lockBars = input.int(6, "H/L Lock After N Bars Unbroken", minval=2, group="④ Lock / Taps", tooltip="6 bars on 15m = 90 min (his 30-90 min rule).")
int    tapGap   = input.int(3, "Min Bars Between Taps", minval=1, group="④ Lock / Taps")
int    adrLen   = input.int(5, "ADR Length (days)", minval=1, group="⑤ Levels")
int    cooldown = input.int(8, "Signal Cooldown (bars)", minval=1, group="⑥ Engine")
bool   showEma  = input.bool(true, "Show EMA Stack (5/13/50/200/800)", group="⑦ v2: EMA Stack")
bool   showTdi  = input.bool(true, "Show TDI Shark-Fin Confluence", group="⑧ v2: TDI")
int    tdiRsi   = input.int(13, "TDI RSI Length", minval=5, group="⑧ v2: TDI")
int    tdiBand  = input.int(34, "TDI Volatility Band Length", minval=10, group="⑧ v2: TDI")
float  tdiMult  = input.float(1.6185, "TDI Band Multiplier", step=0.01, group="⑧ v2: TDI")
bool   showRR   = input.bool(true, "Tag Railroad-Track Candles", group="⑨ v2: Railroad Tracks")
float  rrTolFr  = input.float(0.35, "Railroad Track Range-Match Tolerance", minval=0.1, maxval=0.8, step=0.05, group="⑨ v2: Railroad Tracks")
bool   showPiv  = input.bool(true, "Show Daily Pivots (PP/R1-3/S1-3)", group="⑩ v2: Pivots")

float atrv = ta.atr(14)
float tol  = atrv * tolAtr

// ── Time grid (ET) ───────────────────────────────────────────
bool inAsia    = not na(time(timeframe.period, asiaSess, "America/New_York"))
bool gapLdn    = not na(time(timeframe.period, "0300-0330", "America/New_York"))
bool gapNy     = not na(time(timeframe.period, "0900-0930", "America/New_York"))
bool brinks1   = not na(time(timeframe.period, "0330-0345", "America/New_York"))
bool brinks2   = not na(time(timeframe.period, "0930-0945", "America/New_York"))
bool deadGap   = not na(time(timeframe.period, "1700-2000", "America/New_York"))
bgcolor(showGrid and (gapLdn or gapNy) ? color.new(color.gray, 88) : na, title="Gap time (shift change)")
bgcolor(showGrid and (brinks1 or brinks2) ? color.new(color.orange, 82) : na, title="Brinks window")
bgcolor(showGrid and deadGap ? color.new(color.gray, 96) : na, title="Dead gap")

// ── Daily anchor: 17:00 ET reset ─────────────────────────────
bool newDay = not deadGap[1] and deadGap  // first bar at/after 17:00 ET
var float dayHi = na
var float dayLo = na
var float dayAnchor = na
var int   hiBrokenBar = 0
var int   loBrokenBar = 0
if newDay
    dayHi := high
    dayLo := low
    dayAnchor := open
    hiBrokenBar := bar_index
    loBrokenBar := bar_index
else
    if high > nz(dayHi, high)
        dayHi := high
        hiBrokenBar := bar_index
    if low < nz(dayLo, low)
        dayLo := low
        loBrokenBar := bar_index
plot(dayHi, "Day High (17:00 reset)", color.new(color.red,  55), 1, plot.style_linebr)
plot(dayLo, "Day Low (17:00 reset)",  color.new(color.lime, 55), 1, plot.style_linebr)

bool hiLocked = not na(dayHi) and bar_index - hiBrokenBar >= lockBars
bool loLocked = not na(dayLo) and bar_index - loBrokenBar >= lockBars

// ── Asia range + stop-hunt zone tiers ────────────────────────
var float aHi = na
var float aLo = na
if inAsia and not inAsia[1]
    aHi := high
    aLo := low
if inAsia
    aHi := math.max(nz(aHi, high), high)
    aLo := math.min(nz(aLo, low), low)
if showZone and not inAsia and inAsia[1] and not na(aHi)
    box.new(bar_index, aHi, bar_index + 60, aLo, border_color=color.new(color.blue, 60), bgcolor=color.new(color.blue, 95))
    box.new(bar_index, aHi + z1, bar_index + 60, aHi, border_color=color.new(color.red, 70), bgcolor=color.new(color.red, 94))
    box.new(bar_index, aHi + z2, bar_index + 60, aHi + z1, border_color=color.new(color.red, 60), bgcolor=color.new(color.red, 90))
    box.new(bar_index, aLo, bar_index + 60, aLo - z1, border_color=color.new(color.green, 70), bgcolor=color.new(color.green, 94))
    box.new(bar_index, aLo - z1, bar_index + 60, aLo - z2, border_color=color.new(color.green, 60), bgcolor=color.new(color.green, 90))

// ── ADR + level counter (thirds) ─────────────────────────────
float adr = request.security(syminfo.tickerid, "D", ta.sma(high - low, adrLen)[1], lookahead=barmerge.lookahead_on)
float lvlUnit = adr / 3
float travel  = not na(dayAnchor) and not na(lvlUnit) and lvlUnit > 0 ? (close - dayAnchor) / lvlUnit : na
int   lvl     = na(travel) ? 0 : math.min(3, math.floor(math.abs(travel)))
int   lvlDir  = na(travel) ? 0 : travel > 0 ? 1 : -1

// ── Signal state ─────────────────────────────────────────────
var int lastSig = -9999
bool cd = bar_index - lastSig > cooldown

// ── BRINKS trades (H20) ──────────────────────────────────────
// Hammer geometry on a closed bar inside a Brinks window that forms
// or retests the day extreme without a body close beyond it.
float rng    = high - low
float loWick = math.min(close, open) - low
float upWick = high - math.max(close, open)
bool hammerUp = rng > 0 and loWick >= rng * wickFr and close > open
bool hammerDn = rng > 0 and upWick >= rng * wickFr and close < open
bool inBrinks = brinks1 or brinks2

bool brinksBull = cd and inBrinks and hammerUp and low <= dayLo + tol and close > dayLo
bool brinksBear = cd and inBrinks and hammerDn and high >= dayHi - tol and close < dayHi
if brinksBull
    label.new(bar_index, low, "BRINKS ▲", style=label.style_label_up, color=color.new(#FF6D00, 0), textcolor=color.white, size=size.normal,
         tooltip="Brinks window hammer at/near the day low (second-leg W). Stop below the day low. Two-hour rule: no profit in 2h = scratch.")
if brinksBear
    label.new(bar_index, high, "BRINKS ▼", style=label.style_label_down, color=color.new(#FF6D00, 0), textcolor=color.white, size=size.normal,
         tooltip="Brinks window hammer at/near the day high (second-leg M). Stop above the day high. Two-hour rule applies.")

// ── TRIPLE TAP (H22): 3 tests of day H/L, no body break ──────
var int hiTaps = 0
var int loTaps = 0
var int lastHiTap = -9999
var int lastLoTap = -9999
if bar_index == hiBrokenBar
    hiTaps := 0
if bar_index == loBrokenBar
    loTaps := 0
bool hiTapNow = not na(dayHi) and bar_index > hiBrokenBar and high >= dayHi - tol and math.max(close, open) < dayHi and bar_index - lastHiTap >= tapGap
bool loTapNow = not na(dayLo) and bar_index > loBrokenBar and low <= dayLo + tol and math.min(close, open) > dayLo and bar_index - lastLoTap >= tapGap
if hiTapNow
    hiTaps += 1
    lastHiTap := bar_index
if loTapNow
    loTaps += 1
    lastLoTap := bar_index

bool tripleBear = cd and hiTapNow and hiTaps >= 2  // extreme itself + 2 return taps = 3 hits
bool tripleBull = cd and loTapNow and loTaps >= 2
if tripleBear
    label.new(bar_index, high, "3-TAP ▼", style=label.style_label_down, color=color.new(#D50000, 10), textcolor=color.white, size=size.small,
         tooltip="Third visit to the day high without a body break. 'When they come back a third time and don't break it, the correction is imminent.'")
if tripleBull
    label.new(bar_index, low, "3-TAP ▲", style=label.style_label_up, color=color.new(#00C853, 10), textcolor=color.white, size=size.small,
         tooltip="Third visit to the day low without a body break. Reversal watch — long against the herd.")

if brinksBull or brinksBear or tripleBull or tripleBear
    lastSig := bar_index

// ── v2: EMA stack + level-cross classification ────────────────
float ema5   = ta.ema(close, 5)
float ema13  = ta.ema(close, 13)
float ema50  = ta.ema(close, 50)
float ema200 = ta.ema(close, 200)
float ema800 = ta.ema(close, 800)
plot(showEma ? ema13  : na, "EMA 13",  color.new(color.yellow, 40), 1)
plot(showEma ? ema50  : na, "EMA 50 (trend)",  color.new(color.orange, 20), 2)
plot(showEma ? ema200 : na, "EMA 200 (moving S/R)", color.new(color.aqua, 20), 2)
plot(showEma ? ema800 : na, "EMA 800 (moving S/R)", color.new(color.purple, 20), 3)

var int mmLevel = 0   // 0 = none, 1 = 13/50 crossed, 2 = 50/200 crossed
var int mmBias  = 0   // 1 = bullish stack, -1 = bearish stack
bool cross13_50  = ta.cross(ema13, ema50)
bool cross50_200 = ta.cross(ema50, ema200)
if cross13_50
    mmLevel := 1
    mmBias := ema13 > ema50 ? 1 : -1
if cross50_200
    mmLevel := 2
    mmBias := ema50 > ema200 ? 1 : -1
bool emaBunched = math.max(ema13, math.max(ema50, ema200)) - math.min(ema13, math.min(ema50, ema200)) < atrv * 0.5

// ── v2: peak-to-peak ADR box stack (FULL adr units, distinct from
//    the ADR/3 level counter above -- do not conflate the two) ───
var float peakAnchor = na
var int   peakDir    = 0   // 1 = high-peak (expect drop), -1 = low-peak (expect rise)
if hiLocked and not hiLocked[1]
    peakAnchor := dayHi
    peakDir := 1
if loLocked and not loLocked[1]
    peakAnchor := dayLo
    peakDir := -1
float adrBoxTravel = not na(peakAnchor) and not na(adr) and adr > 0 ? math.abs(close - peakAnchor) / adr : na
int   adrBoxN = na(adrBoxTravel) ? 0 : math.floor(adrBoxTravel)
bool  adrExtended = adrBoxN >= 3

// ── v2: TDI shark-fin confluence (Dean Malone formula proxy) ──
float rsi = ta.rsi(close, tdiRsi)
float tdiSignal = ta.sma(rsi, 2)   // "trade signal line"
float tdiBase   = ta.sma(rsi, 7)   // "market baseline"
float bbMid = ta.sma(rsi, tdiBand)
float bbDev = ta.stdev(rsi, tdiBand) * tdiMult
float tdiUp = bbMid + bbDev
float tdiDn = bbMid - bbDev
bool sharkFinUp = ta.crossunder(tdiSignal, tdiDn) and rsi[1] <= tdiDn[1]  // spiked to/through lower band
bool sharkFinDn = ta.crossover(tdiSignal, tdiUp) and rsi[1] >= tdiUp[1]   // spiked to/through upper band
// shark fin CONFIRMS when the signal line reverses back toward the
// baseline within a few bars of the extreme touch
bool sharkConfirmUp = sharkFinUp[1] and tdiSignal > tdiSignal[1] and tdiSignal < tdiBase
bool sharkConfirmDn = sharkFinDn[1] and tdiSignal < tdiSignal[1] and tdiSignal > tdiBase
if showTdi and sharkConfirmUp
    label.new(bar_index, low, "TDI SHARK ▲", style=label.style_label_up, color=color.new(#7B1FA2, 20), textcolor=color.white, size=size.small,
         tooltip="TDI signal line spiked through the lower volatility band and is reversing toward the market baseline. Source's highest-conviction confluence, especially on H4.")
if showTdi and sharkConfirmDn
    label.new(bar_index, high, "TDI SHARK ▼", style=label.style_label_down, color=color.new(#7B1FA2, 20), textcolor=color.white, size=size.small,
         tooltip="TDI signal line spiked through the upper volatility band and is reversing toward the market baseline.")

// ── v2: railroad-track candle tag ─────────────────────────────
bool rrOppColor = (close - open) * (close[1] - open[1]) < 0
bool rrSimRange = math.abs(rng - rng[1]) <= rrTolFr * math.max(rng, rng[1])
bool rrAtZone = showZone and not na(aHi) and (math.abs(close - aHi) <= z2 or math.abs(close - aLo) <= z2)
bool rrAtEma  = showEma and (math.abs(close - ema200) <= atrv * tolAtr or math.abs(close - ema800) <= atrv * tolAtr)
bool railroadUp = rng > 0 and rng[1] > 0 and rrOppColor and rrSimRange and close > open and (rrAtZone or rrAtEma)
bool railroadDn = rng > 0 and rng[1] > 0 and rrOppColor and rrSimRange and close < open and (rrAtZone or rrAtEma)
if railroadUp
    label.new(bar_index, low, "RR ▲", style=label.style_label_up, color=color.new(color.teal, 30), textcolor=color.white, size=size.tiny,
         tooltip="Railroad-track pair (two opposite-color, similar-range candles) at a stop-hunt zone or moving EMA S/R. Reversal signal, no TDI needed per source.")
if railroadDn
    label.new(bar_index, high, "RR ▼", style=label.style_label_down, color=color.new(color.maroon, 30), textcolor=color.white, size=size.tiny,
         tooltip="Railroad-track pair at a stop-hunt zone or moving EMA S/R -- bearish.")

// ── v2: ID50 reentry (rotation back to EMA200 in bias direction) ─
bool touchedEma200 = math.abs(close - ema200) <= atrv * tolAtr or (low <= ema200 and high >= ema200)
bool id50Long  = cd and mmBias == 1  and touchedEma200 and close > ema200
bool id50Short = cd and mmBias == -1 and touchedEma200 and close < ema200
if id50Long
    label.new(bar_index, low, "ID50 ▲", style=label.style_label_up, color=color.new(color.blue, 20), textcolor=color.white, size=size.small,
         tooltip="Rotation back to EMA200 with bullish EMA-stack bias intact -- source's favored low-drawdown reentry.")
if id50Short
    label.new(bar_index, high, "ID50 ▼", style=label.style_label_down, color=color.new(color.blue, 20), textcolor=color.white, size=size.small,
         tooltip="Rotation back to EMA200 with bearish EMA-stack bias intact -- favored low-drawdown reentry.")
if id50Long or id50Short
    lastSig := bar_index

// ── v2: daily classic pivots (PP/R1-3/S1-3) ───────────────────
// Source's own M0-M5 numbering is undocumented/ambiguous in the
// transcript; standard floor-trader pivots substituted, see playbook.
[pDh, pDl, pDc] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], lookahead=barmerge.lookahead_on)
float pp = (pDh + pDl + pDc) / 3
float r1 = 2 * pp - pDl
float s1 = 2 * pp - pDh
float r2 = pp + (pDh - pDl)
float s2 = pp - (pDh - pDl)
float r3 = pDh + 2 * (pp - pDl)
float s3 = pDl - 2 * (pDh - pp)
plot(showPiv ? pp : na, "Pivot PP", color.new(color.white, 20), 1, plot.style_linebr)
plot(showPiv ? r1 : na, "Pivot R1", color.new(color.red, 50), 1, plot.style_linebr)
plot(showPiv ? s1 : na, "Pivot S1", color.new(color.lime, 50), 1, plot.style_linebr)
plot(showPiv ? r2 : na, "Pivot R2", color.new(color.red, 65), 1, plot.style_linebr)
plot(showPiv ? s2 : na, "Pivot S2", color.new(color.lime, 65), 1, plot.style_linebr)
plot(showPiv ? r3 : na, "Pivot R3", color.new(color.red, 80), 1, plot.style_linebr)
plot(showPiv ? s3 : na, "Pivot S3", color.new(color.lime, 80), 1, plot.style_linebr)

// ── Status table ─────────────────────────────────────────────
var table tb = table.new(position.bottom_right, 2, 7, bgcolor=color.new(color.black, 30), border_width=1, border_color=color.new(color.gray, 70))
if barstate.islast
    table.cell(tb, 0, 0, "MM CYCLE", text_color=color.orange, text_size=size.small)
    table.cell(tb, 1, 0, lvl == 0 ? "Level 0 (inside)" : "Level " + str.tostring(lvl) + (lvlDir == 1 ? " UP" : " DOWN") + (lvl >= 3 ? " — REVERSAL WATCH" : ""), text_color=lvl >= 3 ? color.red : color.white, text_size=size.tiny)
    table.cell(tb, 0, 1, "ADR/3 unit", text_color=color.silver, text_size=size.tiny)
    table.cell(tb, 1, 1, na(lvlUnit) ? "—" : str.tostring(lvlUnit, format.mintick), text_color=color.white, text_size=size.tiny)
    table.cell(tb, 0, 2, "Day High", text_color=color.silver, text_size=size.tiny)
    table.cell(tb, 1, 2, hiLocked ? "LOCKED (fade ok)" : "live", text_color=hiLocked ? color.orange : color.gray, text_size=size.tiny)
    table.cell(tb, 0, 3, "Day Low", text_color=color.silver, text_size=size.tiny)
    table.cell(tb, 1, 3, loLocked ? "LOCKED (fade ok)" : "live", text_color=loLocked ? color.orange : color.gray, text_size=size.tiny)
    table.cell(tb, 0, 4, "Peak ADR box", text_color=color.silver, text_size=size.tiny)
    table.cell(tb, 1, 4, na(peakAnchor) ? "no peak yet" : str.tostring(adrBoxN) + "x ADR" + (adrExtended ? " EXTENDED" : ""), text_color=adrExtended ? color.red : color.white, text_size=size.tiny)
    table.cell(tb, 0, 5, "EMA level/bias", text_color=color.silver, text_size=size.tiny)
    table.cell(tb, 1, 5, "L" + str.tostring(mmLevel) + " " + (mmBias == 1 ? "bull" : mmBias == -1 ? "bear" : "—") + (emaBunched ? " (bunched)" : ""), text_color=emaBunched ? color.gray : (mmBias == 1 ? color.lime : color.red), text_size=size.tiny)
    table.cell(tb, 0, 6, "TDI", text_color=color.silver, text_size=size.tiny)
    table.cell(tb, 1, 6, str.tostring(rsi, "#.#"), text_color=color.white, text_size=size.tiny)

// ── Alerts ───────────────────────────────────────────────────
alertcondition(brinksBull, "Brinks Long",  "MM Cycle: BRINKS ▲ hammer at day low in Brinks window — {{ticker}} {{interval}}")
alertcondition(brinksBear, "Brinks Short", "MM Cycle: BRINKS ▼ hammer at day high in Brinks window — {{ticker}} {{interval}}")
alertcondition(tripleBull, "Triple Tap Long",  "MM Cycle: 3-TAP ▲ day low held 3x — {{ticker}} {{interval}}")
alertcondition(tripleBear, "Triple Tap Short", "MM Cycle: 3-TAP ▼ day high held 3x — {{ticker}} {{interval}}")
alertcondition(lvl >= 3 and lvl[1] < 3, "Level 3 Reached", "MM Cycle: 3rd ADR-third traveled — reversal watch — {{ticker}} {{interval}}")
alertcondition(adrBoxN >= 3 and adrBoxN[1] < 3, "3x ADR Box Reached", "MM Cycle: peak-to-peak 3x ADR traveled — reversal watch — {{ticker}} {{interval}}")
alertcondition(sharkConfirmUp, "TDI Shark Fin Long",  "MM Cycle: TDI SHARK ▲ — {{ticker}} {{interval}}")
alertcondition(sharkConfirmDn, "TDI Shark Fin Short", "MM Cycle: TDI SHARK ▼ — {{ticker}} {{interval}}")
alertcondition(railroadUp, "Railroad Track Long",  "MM Cycle: RR ▲ — {{ticker}} {{interval}}")
alertcondition(railroadDn, "Railroad Track Short", "MM Cycle: RR ▼ — {{ticker}} {{interval}}")
alertcondition(id50Long,  "ID50 Reentry Long",  "MM Cycle: ID50 ▲ rotation reentry — {{ticker}} {{interval}}")
alertcondition(id50Short, "ID50 Reentry Short", "MM Cycle: ID50 ▼ rotation reentry — {{ticker}} {{interval}}")
