// ============================================================
// QUARTERLY THEORY ENGINE [Real-Time]
// Source: trader_playbooks/quarterly_theory.md
// (Trader Daye / ICT lineage — INDEPENDENT source #4)
//
// Codeable skeleton of the theory (mysticism discarded):
//   - Daily quarters (ET): Q1 Asia 18-00, Q2 London 00-06,
//     Q3 NY AM 06-12, Q4 NY PM 12-18. Q2/Q3 opens = expansion.
//   - True Opens: Daily 00:00 ET, Weekly Tue 00:00, NY AM 07:30.
//     Price above/below = premium/discount frame.
//   - JUDAS: manipulation-window sweep of prior day's high/low
//     that closes back inside, backed by SMT divergence.
//   - SMT: correlated symbol (default silver for gold) fails to
//     confirm our sweep -> the sweep was manipulation.
//   - v4: 90-min sub-quarter markers per session; AMDX/XAMD phase
//     heuristic (range-based proxy for the source's judgment call).
//
// EDGE STATUS: theory, zero stats in source. For observation and
// confluence testing only. All signals bar-close, non-repainting.
// ============================================================
//@version=6
indicator("Quarterly Theory Engine [Real-Time]", overlay=true, max_labels_count=500, max_lines_count=100)

// ── Inputs ───────────────────────────────────────────────────
string refSym   = input.symbol("OANDA:XAGUSD", "SMT Reference Symbol (silver for gold)", group="① SMT")
bool   refInv   = input.bool(false, "Reference is Inverse (e.g. DXY)", group="① SMT")
int    smtLen   = input.int(30, "SMT Sweep Lookback (bars)", minval=10, group="① SMT")
int    smtWin   = input.int(10, "SMT Valid Window (bars)", minval=1, group="① SMT")
bool   showQ    = input.bool(true, "Shade Daily Quarters", group="② Time Structure")
bool   showTO   = input.bool(true, "Show True Opens", group="② Time Structure")
string manip1   = input.session("0000-0600", "Manipulation Window 1 (London/Q2, ET)", group="③ Judas")
string manip2   = input.session("0730-0900", "Manipulation Window 2 (NY AM open, ET)", group="③ Judas")
int    cooldown = input.int(10, "Signal Cooldown (bars)", minval=1, group="③ Judas")
bool   showAlt  = input.bool(true, "Show Q-Alternation Forecast", group="④ QT v2")
int    ssmtWin  = input.int(12, "SSMT Window After Q Open (bars)", minval=1, group="④ QT v2")
bool   show90   = input.bool(true, "Mark 90-Minute Sub-Quarter Opens", group="⑤ QT v4")
bool   showAmd  = input.bool(true, "Label AMDX / XAMD Phase per Daily Quarter", group="⑤ QT v4")

// ── Daily quarters (ET) ──────────────────────────────────────
bool q1 = not na(time(timeframe.period, "1800-0000", "America/New_York"))
bool q2 = not na(time(timeframe.period, "0000-0600", "America/New_York"))
bool q3 = not na(time(timeframe.period, "0600-1200", "America/New_York"))
bool q4 = not na(time(timeframe.period, "1200-1800", "America/New_York"))
bgcolor(showQ and q1 ? color.new(color.gray,   96) : na, title="Q1 Asia")
bgcolor(showQ and q2 ? color.new(color.blue,   96) : na, title="Q2 London")
bgcolor(showQ and q3 ? color.new(color.teal,   96) : na, title="Q3 NY AM")
bgcolor(showQ and q4 ? color.new(color.purple, 97) : na, title="Q4 NY PM")

// ── Quarter boundary + Q-alternation forecast [QT v2] ────────
// Rule: consolidating Q -> expect expansion next; expanding Q ->
// expect consolidation next. Range measured vs average Q range.
bool newQ = (q1 and not q1[1]) or (q2 and not q2[1]) or (q3 and not q3[1]) or (q4 and not q4[1])
var float qHi = na
var float qLo = na
var float avgQR = na
var int   qStartBar = na
if newQ
    float prevQR = not na(qHi) ? qHi - qLo : na
    if not na(prevQR)
        avgQR := na(avgQR) ? prevQR : avgQR * 0.8 + prevQR * 0.2
        if showAlt and not na(avgQR)
            bool wasExpansion = prevQR > avgQR * 1.2
            bool wasConsol    = prevQR < avgQR * 0.8
            if wasConsol
                label.new(bar_index, high, "Q→ EXPECT EXPANSION", style=label.style_label_left, color=color.new(color.teal, 30), textcolor=color.white, size=size.tiny)
            else if wasExpansion
                label.new(bar_index, high, "Q→ EXPECT CONSOLIDATION", style=label.style_label_left, color=color.new(color.gray, 30), textcolor=color.white, size=size.tiny)
        // AMDX vs XAMD profile heuristic [QT v4] — proxy only, not the
        // source's own rule (source determines this by judgment: does
        // the closed Q look like fresh accumulation, or a directional
        // continuation/reversal of the prior cycle?). Tight range vs
        // the running average = AMDX-leaning (next Q = Manipulate);
        // wide directional range = XAMD-leaning (this Q was X).
        if showAmd and not na(avgQR)
            string prof = prevQR < avgQR * 0.7 ? "AMDX-leaning (next Q=Manipulate)" : prevQR > avgQR * 1.3 ? "XAMD-leaning (this Q was X)" : ""
            if prof != ""
                label.new(bar_index, low, prof, style=label.style_label_left, color=color.new(color.navy, 40), textcolor=color.white, size=size.tiny,
                     tooltip="Heuristic range-based proxy for the source's judgment call, not a stated rule. AMDX: Q1=Accumulate, Q2=Manipulate, Q3=Distribute, Q4=X. XAMD: Q1=X, Q2=Accumulate (uses Q2 true open), Q3=Manipulate, Q4=Distribute.")
    qHi := high
    qLo := low
    qStartBar := bar_index
else
    qHi := math.max(nz(qHi, high), high)
    qLo := math.min(nz(qLo, low), low)

// ── 90-minute sub-quarter opens [QT v4] ──────────────────────
// Q2 of each session's own 90-min cycle is that session's true open
// (already plotted below); this just marks all four sub-quarter
// boundaries per session for visual reference.
mk90(sess) =>
    w = not na(time(timeframe.period, sess, "America/New_York"))
    w and not w[1]
bool asia90  = mk90("1800-1930") or mk90("1930-2100") or mk90("2100-2230") or mk90("2230-0000")
bool ldn90   = mk90("0000-0130") or mk90("0130-0300") or mk90("0300-0430") or mk90("0430-0600")
bool nyam90  = mk90("0600-0730") or mk90("0730-0900") or mk90("0900-1030") or mk90("1030-1200")
bool pm90    = mk90("1200-1330") or mk90("1330-1500") or mk90("1500-1630") or mk90("1630-1800")
plotchar(show90 and (asia90 or ldn90 or nyam90 or pm90) ? high : na, "90-min Sub-Q Open", "·", location.abovebar, color.new(color.gray, 40), size=size.tiny)

// ── True Opens ───────────────────────────────────────────────
// v3 correction (primary source): True Weekly Open = MONDAY 18:00 ET
var float trueDailyOpen  = na
var float trueWeeklyOpen = na
var float trueAsiaOpen   = na
var float trueLdnOpen    = na
var float trueNyamOpen   = na
var float truePmOpen     = na
bool newDailyTO = q2 and not q2[1]
if newDailyTO
    trueDailyOpen := open
bool q1Start = q1 and not q1[1]
if q1Start and dayofweek(time, "America/New_York") == dayofweek.monday
    trueWeeklyOpen := open
mkTO(sess) =>
    w = not na(time(timeframe.period, sess, "America/New_York"))
    w and not w[1]
if mkTO("1930-1935")
    trueAsiaOpen := open
if mkTO("0130-0135")
    trueLdnOpen := open
if mkTO("0730-0735")
    trueNyamOpen := open
if mkTO("1330-1335")
    truePmOpen := open

plot(showTO ? trueDailyOpen  : na, "True Daily Open (00:00 ET)",   color.new(color.orange, 20), 1, plot.style_linebr)
plot(showTO ? trueWeeklyOpen : na, "True Weekly Open (Mon 18:00)", color.new(color.fuchsia, 35), 2, plot.style_linebr)
plot(showTO ? trueAsiaOpen   : na, "True Asia Open (19:30)",       color.new(color.gray, 55), 1, plot.style_linebr)
plot(showTO ? trueLdnOpen    : na, "True London Open (01:30)",     color.new(color.blue, 45), 1, plot.style_linebr)
plot(showTO ? trueNyamOpen   : na, "True NY AM Open (07:30)",      color.new(color.aqua, 35), 1, plot.style_linebr)
plot(showTO ? truePmOpen     : na, "True PM Open (13:30)",         color.new(color.purple, 45), 1, plot.style_linebr)

// ── Prior day levels (liquidity pools) ───────────────────────
float pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
float pdl = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_on)
plot(pdh, "Prev Day High", color.new(color.red,  60), 1, plot.style_linebr)
plot(pdl, "Prev Day Low",  color.new(color.lime, 60), 1, plot.style_linebr)

// ── SMT divergence vs reference symbol ───────────────────────
[rHigh, rLow] = request.security(refSym, timeframe.period, [high, low])
float rH = refInv ? -rLow  : rHigh
float rL = refInv ? -rHigh : rLow

bool mySweepLo  = low  < ta.lowest(low, smtLen)[1]
bool mySweepHi  = high > ta.highest(high, smtLen)[1]
bool refSweepLo = rL   < ta.lowest(rL, smtLen)[1]
bool refSweepHi = rH   > ta.highest(rH, smtLen)[1]

var int bullSmtBar = -9999
var int bearSmtBar = -9999
if mySweepLo and not refSweepLo
    bullSmtBar := bar_index
if mySweepHi and not refSweepHi
    bearSmtBar := bar_index
bool bullSmt = bar_index - bullSmtBar <= smtWin
bool bearSmt = bar_index - bearSmtBar <= smtWin

// SSMT: SMT within the window after a quarter open = sequential
// SMT (claimed higher probability — engages the time factor)
bool inSsmtWin = not na(qStartBar) and bar_index - qStartBar <= ssmtWin
if mySweepLo and not refSweepLo and (bar_index - bullSmtBar[1] > smtWin)
    label.new(bar_index, low, inSsmtWin ? "SSMT ▲" : "SMT ▲", style=label.style_label_up, color=color.new(#7B1FA2, inSsmtWin ? 0 : 40), textcolor=color.white, size=inSsmtWin ? size.small : size.tiny,
         tooltip="We swept the low; reference did not confirm. " + (inSsmtWin ? "SEQUENTIAL (after Q open) — higher grade. PSP entry = this candle close." : "Sweep = likely manipulation."))
if mySweepHi and not refSweepHi and (bar_index - bearSmtBar[1] > smtWin)
    label.new(bar_index, high, inSsmtWin ? "SSMT ▼" : "SMT ▼", style=label.style_label_down, color=color.new(#7B1FA2, inSsmtWin ? 0 : 40), textcolor=color.white, size=inSsmtWin ? size.small : size.tiny,
         tooltip="We swept the high; reference did not confirm. " + (inSsmtWin ? "SEQUENTIAL (after Q open) — higher grade. PSP entry = this candle close." : "Sweep = likely manipulation."))

// ── JUDAS signals (manipulation-window sweep + reclaim + SMT) ─
bool inManip = not na(time(timeframe.period, manip1, "America/New_York")) or not na(time(timeframe.period, manip2, "America/New_York"))
var int lastSig = -9999
bool cd = bar_index - lastSig > cooldown

bool judasBull = cd and inManip and low  < pdl and close > pdl and bullSmt
bool judasBear = cd and inManip and high > pdh and close < pdh and bearSmt
if judasBull or judasBear
    lastSig := bar_index

if judasBull
    label.new(bar_index, low, "JUDAS ▲", style=label.style_label_up, color=color.new(#00C853, 0), textcolor=color.white, size=size.normal,
         tooltip="Manipulation-window sweep of prev day low, closed back above, SMT confirms non-participation. Stop below the sweep low.")
if judasBear
    label.new(bar_index, high, "JUDAS ▼", style=label.style_label_down, color=color.new(#D50000, 0), textcolor=color.white, size=size.normal,
         tooltip="Manipulation-window sweep of prev day high, closed back below, SMT confirms. Stop above the sweep high.")

// ── Premium/discount frame vs True Daily Open ────────────────
bool aboveTO = not na(trueDailyOpen) and close > trueDailyOpen
barcolor(judasBull ? color.lime : judasBear ? color.red : na)

// ── Alerts ───────────────────────────────────────────────────
alertcondition(judasBull, "JUDAS Bull", "Quarterly: JUDAS ▲ sweep+reclaim+SMT — {{ticker}} {{interval}}")
alertcondition(judasBear, "JUDAS Bear", "Quarterly: JUDAS ▼ sweep+reclaim+SMT — {{ticker}} {{interval}}")
alertcondition(mySweepLo and not refSweepLo, "Bullish SMT", "Quarterly: bullish SMT divergence — {{ticker}} {{interval}}")
alertcondition(mySweepHi and not refSweepHi, "Bearish SMT", "Quarterly: bearish SMT divergence — {{ticker}} {{interval}}")
alertcondition(newQ, "New Quarter Open", "Quarterly: new Q open (true open) — {{ticker}} {{interval}}")
