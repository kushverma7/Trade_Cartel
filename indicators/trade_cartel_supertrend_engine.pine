//@version=6
indicator("Trade Cartel - SuperTrend Engine", shorttitle="TC-SuperTrend", overlay=true, max_labels_count=300)

// ============================================================
// Classic SuperTrend (ATR-based trailing stop/reversal line) --
// structurally different from every other engine built this session:
// no walls, no RSI, no confluence stack, no separate TP/SL. The
// trailing band itself IS both the stop and the reversal signal --
// always-in, flip-based (long above the line, short below it).
//
// Standard formula (Olivier Seban's original construction, the same
// one used across virtually every SuperTrend implementation):
//   basis = (high+low)/2
//   upperBand = basis + factor * ATR
//   lowerBand = basis - factor * ATR
//   finalUpper[t] = close[t-1] > finalUpper[t-1] ? min(upperBand, finalUpper[t-1]) : upperBand
//   finalLower[t] = close[t-1] < finalLower[t-1] ? max(lowerBand, finalLower[t-1]) : lowerBand
//   trend flips DOWN when close crosses under finalUpper, UP when
//   close crosses over finalLower. Non-repainting -- all math on
//   confirmed bars only, no lookahead.
//
// Not tied to any of this project's 19 knowledge-base voices --
// this is a standalone, independently well-known algorithm, included
// per the user's explicit visual reference (trailing line + flip
// Buy/Sell labels, no additional confluence layer).
//
// UNTESTED on this specific instrument/timeframe -- widely validated
// as a method in general, but per the 2026-07-20 standing rule,
// nothing in this repo gets "proven" language without a real backtest
// here. Ships with a live flip-to-flip hit-tracker so that test can
// start immediately.
// ============================================================

int   atrPeriod = input.int(10, "ATR Period", minval=1, group="① SuperTrend")
float factor     = input.float(3.0, "ATR Multiplier", step=0.1, group="① SuperTrend")
bool  showLabels = input.bool(true, "Show Buy/Sell Labels", group="② Display")
bool  showTable  = input.bool(true, "Show Results Table", group="② Display")

// ═════════════════════════════════════════════════════════════
// SUPERTREND CORE
// ═════════════════════════════════════════════════════════════
atr = ta.atr(atrPeriod)
basis = hl2

float upperBand = basis + factor * atr
float lowerBand = basis - factor * atr

var float finalUpper = na
var float finalLower = na
var int   trendDir   = 1

// BUG CAUGHT BEFORE SHIPPING: these two conditions were originally
// inverted relative to the standard formula (finalUpper trails DOWN
// -- takes the min -- while price stays BELOW it, i.e. close[1] <
// finalUpper[1], not >; finalLower trails UP -- takes the max --
// while price stays ABOVE it, close[1] > finalLower[1], not <).
finalUpper := close[1] < nz(finalUpper[1], upperBand) ? math.min(upperBand, nz(finalUpper[1], upperBand)) : upperBand
finalLower := close[1] > nz(finalLower[1], lowerBand) ? math.max(lowerBand, nz(finalLower[1], lowerBand)) : lowerBand

if trendDir == -1 and close > finalUpper[1]
    trendDir := 1
else if trendDir == 1 and close < finalLower[1]
    trendDir := -1

float superTrendLine = trendDir == 1 ? finalLower : finalUpper

bool flipToLong  = trendDir == 1  and trendDir[1] == -1
bool flipToShort = trendDir == -1 and trendDir[1] == 1

// ═════════════════════════════════════════════════════════════
// FLIP-TO-FLIP HIT TRACKER -- a "trade" runs from one flip to the
// next opposite flip (always-in, matches the visual: no separate
// TP/SL, the flip itself is both exit and re-entry). Win = the leg's
// R-multiple (move captured / ATR at entry) is positive and >= 1.
// ═════════════════════════════════════════════════════════════
var float legEntryPrice = na
var float legEntryAtr   = na
var int   legDir        = 0
var int   wins   = 0
var int   losses = 0
var float sumR   = 0.0

if flipToLong or flipToShort
    if not na(legEntryPrice)
        float exitPrice = close
        float moveR = legDir == 1 ? (exitPrice - legEntryPrice) / legEntryAtr : (legEntryPrice - exitPrice) / legEntryAtr
        sumR += moveR
        if moveR > 0
            wins += 1
        else
            losses += 1
    legEntryPrice := close
    legEntryAtr   := atr
    legDir := flipToLong ? 1 : -1

int totalLegs = wins + losses
float winRate = totalLegs > 0 ? wins / totalLegs * 100.0 : na
float avgR    = totalLegs > 0 ? sumR / totalLegs : na

// ═════════════════════════════════════════════════════════════
// PLOTS -- trailing line color-coded by trend, matching the
// reference: green below price in an uptrend, red above price in a
// downtrend, stepped (not smoothed)
// ═════════════════════════════════════════════════════════════
plot(superTrendLine, "SuperTrend", color=trendDir == 1 ? color.lime : color.red, linewidth=2, style=plot.style_linebr)

if showLabels and flipToLong
    label.new(bar_index, low, "Buy", style=label.style_label_up, color=color.new(#00C853, 0), textcolor=color.white, size=size.small)
if showLabels and flipToShort
    label.new(bar_index, high, "Sell", style=label.style_label_down, color=color.new(#D50000, 0), textcolor=color.white, size=size.small)

// ═════════════════════════════════════════════════════════════
// RESULTS TABLE
// ═════════════════════════════════════════════════════════════
var table dash = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 30), border_width=1, border_color=color.new(color.gray, 70))
if showTable and barstate.islast
    table.cell(dash, 0, 0, "SUPERTREND", text_color=color.orange, text_size=size.small)
    table.cell(dash, 1, 0, "", text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 1, "Trend", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 1, trendDir == 1 ? "UP" : "DOWN", text_color=trendDir == 1 ? color.lime : color.red, text_size=size.tiny)
    table.cell(dash, 0, 2, "Completed legs", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 2, str.tostring(totalLegs), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 0, 3, "Win rate", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 3, na(winRate) ? "n/a" : str.tostring(winRate, "#.#") + "% (" + str.tostring(wins) + "W/" + str.tostring(losses) + "L)", text_color=na(winRate) ? color.gray : winRate >= 50 ? color.lime : color.red, text_size=size.tiny)
    table.cell(dash, 0, 4, "Avg R / leg", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 4, na(avgR) ? "n/a" : str.tostring(avgR, "#.##"), text_color=na(avgR) ? color.gray : avgR >= 0 ? color.lime : color.red, text_size=size.tiny)

// ═════════════════════════════════════════════════════════════
// ALERTS
// ═════════════════════════════════════════════════════════════
alertcondition(flipToLong,  "SuperTrend Buy",  "SuperTrend Engine -- flip to UP/Buy -- {{ticker}} {{interval}}")
alertcondition(flipToShort, "SuperTrend Sell", "SuperTrend Engine -- flip to DOWN/Sell -- {{ticker}} {{interval}}")
