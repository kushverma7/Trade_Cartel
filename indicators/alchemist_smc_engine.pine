// ============================================================
// ALCHEMIST SMC ENGINE [Real-Time]
// Source: trader_playbooks/alchemist_smc_concepts.md ("White Seraph"
// PDF — INDEPENDENT voice #12 for the SMC market-structure layer;
// the QT portions of the same PDF are logged as corroboration of the
// existing Quarterly Theory school, not double-counted here)
//
// Three mechanics, all genuinely new to the repo:
//   - IDM (inducement): a pullback swing that gets swept before the
//     next structure point confirms -> gates BOS/CHOCH confirmation
//   - SBR/RBS: broken support/resistance flips role; tag the retest
//     of that flipped level, distinct from zone-freshness tracking
//   - QML (Quasimodo): 5-point swing failure -- HH, HL, break to a
//     new LL, retracement that FAILS to reclaim the original HH,
//     then reversal (mirror for bullish)
//
// v2 (2026-07-20, re-review of the source PDF's page IMAGES -- the
// original pass read text/captions only and flagged Fibo Circle, Fibo
// Storyline and OCL as "too garbled to codify"; the diagrams turned
// out to give concrete numeric ratios the text/captions alone did
// not). Two of the three reclassified from "not built" to built:
//   - Fibo Storyline: a custom (non-standard) Fibonacci retracement
//     ratio set is visible on the source's own tool-settings page --
//     0, .109, .127, .145, .214, .232, .25, .618, .636, .654, .786,
//     .804, .822, 1 -- with a dense "KEY" cluster at .618-.822 and a
//     shallower continuation-pullback cluster at .109-.25. Entry =
//     price retraces into the KEY band on the dominant swing leg and
//     closes back through it. "Adding wood" (scale-in) = after that
//     first entry, a SECOND retracement zone tap on the NEXT swing leg
//     as the trend continues -- source describes shifting to a lower
//     timeframe for this; implemented here as the same mechanic
//     re-applied to the next same-timeframe leg instead, for
//     simplicity (flagged in-code, not a literal implementation).
//   - Fibo Circle: an internal (smaller) retracement swing that forms
//     just after the dominant leg -- its two extremes ("LOW CONSO" /
//     "HIGH CONSO") anchor a Fibonacci EXTENSION using the source's
//     own stated ratios 1.893 and 2.0. The projected level is a
//     retest-entry point of interest in the direction of the
//     dominant trend, not a target.
// OCL remains NOT built -- the diagram clarifies the geometry (an
// HTF candle-body level, connected by a diagonal inducement trendline
// to an LTF order block) but not the anchor-candle SELECTION rule,
// so implementing it would still mean guessing a mechanic the source
// never states. See playbook section 9 for the full writeup.
// Both new sections are a lower-confidence tier than sections 1-4 --
// the source material itself remains a poor machine translation, just
// less garbled than first assessed. Test standalone before trusting.
//
// All signals bar-close, non-repainting (pivots confirm after `pw`
// bars; structure/role-flip/QML/fib checks only use already-closed data).
// ============================================================
//@version=6
indicator("Alchemist SMC Engine [Real-Time]", overlay=true, max_labels_count=500, max_lines_count=100)

// ── Inputs ───────────────────────────────────────────────────
int   pw        = input.int(3, "Pivot Width (bars)", minval=2, maxval=8, group="① Structure")
int   cooldown  = input.int(5, "Signal Cooldown (bars)", minval=1, group="② Engine")
bool  showIdm   = input.bool(true, "Show IDM-Gated BOS/CHOCH", group="① Structure")
bool  showSbr   = input.bool(true, "Show SBR/RBS Role-Flip Retests", group="③ SBR/RBS")
int   maxLevels = input.int(15, "Max Tracked Flipped Levels", minval=5, maxval=40, group="③ SBR/RBS")
bool  showQml   = input.bool(true, "Show Quasimodo (QML) Pattern", group="④ Quasimodo")
bool  showStory = input.bool(false, "Show Fibo Storyline KEY-Zone Entries [v2]", group="⑤ Fibo Storyline/Circle (v2, lower confidence)")
float keyLo     = input.float(0.618, "KEY Zone Low Ratio", group="⑤ Fibo Storyline/Circle (v2, lower confidence)")
float keyHi     = input.float(0.822, "KEY Zone High Ratio", group="⑤ Fibo Storyline/Circle (v2, lower confidence)")
bool  showCircle = input.bool(false, "Show Fibo Circle KEY Extension Levels [v2]", group="⑤ Fibo Storyline/Circle (v2, lower confidence)")
int   circleRetestWin = input.int(15, "Fibo Circle Retest Window (bars)", minval=3, group="⑤ Fibo Storyline/Circle (v2, lower confidence)")

float atrv = ta.atr(14)
var int lastSig = -9999
bool cd = bar_index - lastSig > cooldown

// ── Pivot tracking (shared swing skeleton) ────────────────────
float ph = ta.pivothigh(high, pw, pw)
float pl = ta.pivotlow(low, pw, pw)

// ── IDM-gated BOS/CHOCH ────────────────────────────────────────
// Uptrend: track the last confirmed higher-low (structure point) and
// the most recent minor pullback low between it and current price
// (the IDM candidate). BOS confirms only once that IDM low is swept
// AND price then closes above the prior swing high.
var float upStructHigh = na   // last confirmed swing high (target to break for BOS)
var float upIdmLow     = na   // candidate inducement low since upStructHigh formed
var bool  upIdmSwept   = false
var float dnStructLow  = na
var float dnIdmHigh    = na
var bool  dnIdmSwept   = false

if not na(ph)
    // a fresh swing high resets the up-structure target and IDM tracker
    upStructHigh := ph
    upIdmLow := na
    upIdmSwept := false
if not na(pl)
    if not na(upStructHigh)
        if na(upIdmLow) or pl < upIdmLow
            upIdmLow := pl
            upIdmSwept := false
    dnStructLow := pl
    dnIdmHigh := na
    dnIdmSwept := false
if not na(ph)
    if not na(dnStructLow)
        if na(dnIdmHigh) or ph > dnIdmHigh
            dnIdmHigh := ph
            dnIdmSwept := false

// sweeping the IDM extreme intrabar (wick or close) arms the gate
if not na(upIdmLow) and low < upIdmLow
    upIdmSwept := true
if not na(dnIdmHigh) and high > dnIdmHigh
    dnIdmSwept := true

bool bosUp = cd and not na(upStructHigh) and upIdmSwept and close > upStructHigh and close[1] <= upStructHigh
bool bosDn = cd and not na(dnStructLow)  and dnIdmSwept and close < dnStructLow  and close[1] >= dnStructLow

// unconfirmed break (structure broken WITHOUT a swept IDM) -- weaker, tagged separately
bool weakBreakUp = cd and not na(upStructHigh) and not upIdmSwept and close > upStructHigh and close[1] <= upStructHigh
bool weakBreakDn = cd and not na(dnStructLow)  and not dnIdmSwept and close < dnStructLow  and close[1] >= dnStructLow

if showIdm and bosUp
    label.new(bar_index, low, "BOS ▲ (IDM✓)", style=label.style_label_up, color=color.new(#00C853, 0), textcolor=color.white, size=size.normal,
         tooltip="Confirmed BOS: the inducement pullback low was swept before price broke the prior swing high. Higher-conviction than an unconfirmed break.")
if showIdm and bosDn
    label.new(bar_index, high, "BOS ▼ (IDM✓)", style=label.style_label_down, color=color.new(#D50000, 0), textcolor=color.white, size=size.normal,
         tooltip="Confirmed BOS: the inducement pullback high was swept before price broke the prior swing low.")
if showIdm and weakBreakUp
    label.new(bar_index, low, "BOS ▲ (no IDM)", style=label.style_label_up, color=color.new(color.gray, 40), textcolor=color.white, size=size.tiny,
         tooltip="Structure broke WITHOUT a swept inducement first -- unconfirmed per this source, treat as lower conviction.")
if showIdm and weakBreakDn
    label.new(bar_index, high, "BOS ▼ (no IDM)", style=label.style_label_down, color=color.new(color.gray, 40), textcolor=color.white, size=size.tiny,
         tooltip="Structure broke WITHOUT a swept inducement first -- unconfirmed per this source.")
if bosUp or bosDn
    lastSig := bar_index

// ── SBR / RBS role-flip tracker ────────────────────────────────
var float[] flipLevel = array.new_float()
var int[]   flipRole  = array.new_int()   // 1 = was resistance, now support (RBS); -1 = was support, now resistance (SBR)
var bool[]  flipDone  = array.new_bool()  // consumed after first retest tag

pushFlip(lvl, role) =>
    array.push(flipLevel, lvl)
    array.push(flipRole, role)
    array.push(flipDone, false)
    if array.size(flipLevel) > maxLevels
        array.shift(flipLevel)
        array.shift(flipRole)
        array.shift(flipDone)

// a confirmed BOS up breaks dnStructLow's opposing resistance (upStructHigh) -- RBS candidate
if bosUp
    pushFlip(upStructHigh, 1)
if bosDn
    pushFlip(dnStructLow, -1)

bool sbrTouch = false
bool rbsTouch = false
if array.size(flipLevel) > 0
    for i = array.size(flipLevel) - 1 to 0
        float lvl = array.get(flipLevel, i)
        int   role = array.get(flipRole, i)
        bool  done = array.get(flipDone, i)
        if not done
            if role == 1 and low <= lvl and close > lvl and cd
                rbsTouch := true
                array.set(flipDone, i, true)
                lastSig := bar_index
                if showSbr
                    label.new(bar_index, low, "RBS retest ▲", style=label.style_label_up, color=color.new(color.teal, 10), textcolor=color.white, size=size.small,
                         tooltip="Old resistance retested as new support (Resistance Becomes Support). Stop below this level.")
            else if role == -1 and high >= lvl and close < lvl and cd
                sbrTouch := true
                array.set(flipDone, i, true)
                lastSig := bar_index
                if showSbr
                    label.new(bar_index, high, "SBR retest ▼", style=label.style_label_down, color=color.new(color.maroon, 10), textcolor=color.white, size=size.small,
                         tooltip="Old support retested as new resistance (Support Becomes Resistance). Stop above this level.")

// ── QUASIMODO (QML) pattern ────────────────────────────────────
// Bearish QML: HH after an HL confirms an uptrend leg; a break below
// that HL makes a fresh LL (structure break); the ensuing retracement
// FAILS to reclaim the original HH before reversing = QML short.
var float qHH    = na
var float qHL    = na
var int   qStage = 0   // 0=idle, 1=have HL, 2=have HH after HL, 3=broke to new LL, watching for failed retrace

if not na(pl)
    if qStage == 0 or (not na(qHL) and pl > qHL)
        qHL := pl
        qStage := 1
if not na(ph) and qStage == 1
    qHH := ph
    qStage := 2
bool brokeHL = qStage == 2 and not na(qHL) and close < qHL and close[1] >= qHL
if brokeHL
    qStage := 3
// after stage 3, a subsequent pivot high forming BELOW qHH (failed
// reclaim), followed by a close breaking back below the post-break
// low, confirms QML
if qStage == 3 and not na(ph) and ph < qHH
    if showQml and cd and close < low[pw] and close[1] >= low[pw]
        label.new(bar_index, high, "QML ▼", style=label.style_label_down, color=color.new(#7B1FA2, 0), textcolor=color.white, size=size.normal,
             tooltip="Quasimodo bearish: HH -> HL -> break to fresh LL -> retracement failed to reclaim the original HH -> reversal down.")
        lastSig := bar_index
        qStage := 0

// bullish mirror
var float qLL2    = na
var float qLH2    = na
var int   qStage3 = 0

if not na(ph)
    if qStage3 == 0 or (not na(qLH2) and ph < qLH2)
        qLH2 := ph
        qStage3 := 1
if not na(pl) and qStage3 == 1
    qLL2 := pl
    qStage3 := 2
bool brokeLH = qStage3 == 2 and not na(qLH2) and close > qLH2 and close[1] <= qLH2
if brokeLH
    qStage3 := 3
if qStage3 == 3 and not na(pl) and pl > qLL2
    if showQml and cd and close > high[pw] and close[1] <= high[pw]
        label.new(bar_index, low, "QML ▲", style=label.style_label_up, color=color.new(#7B1FA2, 0), textcolor=color.white, size=size.normal,
             tooltip="Quasimodo bullish: LL -> LH -> break to fresh HH -> retracement failed to reclaim the original LL -> reversal up.")
        lastSig := bar_index
        qStage3 := 0

// ── FIBO STORYLINE (v2) ──────────────────────────────────────
// Track the most recent completed swing leg from the shared ph/pl
// pivot series (older opposite pivot -> newer pivot = the dominant
// leg). Apply the source's own custom retracement ratio set to that
// leg; a retrace into the KEY band (default .618-.822) that closes
// back through the band's outer edge is ORDER 1. A second leg's own
// KEY-band tap after ORDER 1 is ORDER 2 (same-timeframe re-application,
// see header note -- source's literal LTF-shift is not implemented).
var float legA = na   // older pivot of the dominant leg
var float legB = na   // newer pivot (leg endpoint)
var bool  legUp = true
var int   legBBar = na

// leg tracker: any new pivot (either side) becomes the new leg
// endpoint; the previous endpoint becomes the new leg's origin
var float prevPivot = na
var bool  prevWasHigh = false
if not na(ph)
    if not na(prevPivot) and not prevWasHigh
        legA := prevPivot
        legB := ph
        legUp := ph > prevPivot
        legBBar := bar_index - pw
    prevPivot := ph
    prevWasHigh := true
if not na(pl)
    if not na(prevPivot) and prevWasHigh
        legA := prevPivot
        legB := pl
        legUp := pl > prevPivot
        legBBar := bar_index - pw
    prevPivot := pl
    prevWasHigh := false

float legLo = not na(legA) and not na(legB) ? math.min(legA, legB) : na
float legHi = not na(legA) and not na(legB) ? math.max(legA, legB) : na
float legRange = not na(legLo) and not na(legHi) ? legHi - legLo : na

// KEY band: retraced FROM the leg's endpoint back toward its origin
float keyBandLo = legUp and not na(legRange) ? legHi - legRange * keyHi : (not legUp and not na(legRange) ? legLo + legRange * keyLo : na)
float keyBandHi = legUp and not na(legRange) ? legHi - legRange * keyLo : (not legUp and not na(legRange) ? legLo + legRange * keyHi : na)

var bool order1Done = false
var int  order1Bar  = -9999
bool inKeyBand = not na(keyBandLo) and not na(keyBandHi) and low <= keyBandHi and high >= keyBandLo
bool storyOrder1Long  = showStory and cd and legUp  and inKeyBand and close > keyBandHi and close[1] <= keyBandHi
bool storyOrder1Short = showStory and cd and not legUp and inKeyBand and close < keyBandLo and close[1] >= keyBandLo

if storyOrder1Long or storyOrder1Short
    order1Done := true
    order1Bar := bar_index
    lastSig := bar_index
    label.new(bar_index, storyOrder1Long ? low : high, storyOrder1Long ? "Storyline ORDER1 ▲" : "Storyline ORDER1 ▼", style=storyOrder1Long ? label.style_label_up : label.style_label_down, color=color.new(#FF6D00, 10), textcolor=color.white, size=size.small,
         tooltip="Retrace into the KEY zone (" + str.tostring(keyLo) + "-" + str.tostring(keyHi) + ") of the dominant swing leg, closed back through -- source's custom Fib ratio set, lower-confidence section (translation-derived).")

// ORDER 2: after ORDER1, the NEXT completed leg's own KEY-band tap
var bool waitingOrder2 = false
if order1Done and bar_index == order1Bar
    waitingOrder2 := true
bool freshLeg = not na(legBBar) and legBBar > order1Bar
bool storyOrder2 = showStory and waitingOrder2 and freshLeg and inKeyBand and cd and ((legUp and close > keyBandHi and close[1] <= keyBandHi) or (not legUp and close < keyBandLo and close[1] >= keyBandLo))
if storyOrder2
    waitingOrder2 := false
    lastSig := bar_index
    label.new(bar_index, legUp ? low : high, "Storyline ORDER2 (add)", style=legUp ? label.style_label_up : label.style_label_down, color=color.new(#FF6D00, 40), textcolor=color.white, size=size.tiny,
         tooltip="Second KEY-zone tap on a fresh leg after ORDER1 -- source's 'adding wood' scale-in, applied same-timeframe rather than the source's literal LTF-shift.")

// ── FIBO CIRCLE (v2) ─────────────────────────────────────────
// The pivot immediately AFTER the dominant leg's endpoint is the start
// of the internal retracement (LOW/HIGH CONSO); the pivot after that
// closes it. Extension ratios (1.893, 2.0) are the source's own stated
// values, not fitted.
var float consoA = na
var float consoB = na
var bool  consoUp = true
if not na(legBBar) and bar_index - pw == legBBar
    consoA := legB
    consoB := na   // a fresh dominant leg resets the internal-retracement search
if not na(consoA) and na(consoB) and (not na(ph) or not na(pl))
    float newPiv = not na(ph) ? ph : pl
    if newPiv != consoA
        consoB := newPiv
        consoUp := newPiv > consoA

float consoLo = not na(consoA) and not na(consoB) ? math.min(consoA, consoB) : na
float consoHi = not na(consoA) and not na(consoB) ? math.max(consoA, consoB) : na
float consoRange = not na(consoLo) and not na(consoHi) ? consoHi - consoLo : na

float circleKey1 = showCircle and not na(consoRange) ? (consoUp ? consoLo + consoRange * 1.893 : consoHi - consoRange * 1.893) : na
float circleKey2 = showCircle and not na(consoRange) ? (consoUp ? consoLo + consoRange * 2.0   : consoHi - consoRange * 2.0)   : na

var bool  circleArmed = false
var int   circleArmedBar = -9999
bool circleFirstTouch = showCircle and not na(circleKey1) and not circleArmed and ((consoUp and ta.crossover(close, circleKey1)) or (not consoUp and ta.crossunder(close, circleKey1)))
if circleFirstTouch
    circleArmed := true
    circleArmedBar := bar_index
    line.new(bar_index, circleKey1, bar_index + circleRetestWin, circleKey1, color=color.new(#00B8D4, 30), style=line.style_dashed)
    if not na(circleKey2)
        line.new(bar_index, circleKey2, bar_index + circleRetestWin, circleKey2, color=color.new(#00B8D4, 60), style=line.style_dotted)

bool circleRetest = showCircle and circleArmed and bar_index - circleArmedBar <= circleRetestWin and bar_index - circleArmedBar >= 1 and ((consoUp and low <= circleKey1 and close > circleKey1) or (not consoUp and high >= circleKey1 and close < circleKey1))
if circleRetest
    circleArmed := false
    lastSig := bar_index
    label.new(bar_index, consoUp ? low : high, "Fibo Circle KEY retest", style=consoUp ? label.style_label_up : label.style_label_down, color=color.new(#00B8D4, 10), textcolor=color.white, size=size.small,
         tooltip="Price reached the 1.893x extension of the internal (post-leg) retracement and retested it -- source's Fibo Circle KEY level, lower-confidence section (translation-derived).")

// ── Alerts ───────────────────────────────────────────────────
alertcondition(bosUp, "IDM-Confirmed BOS Long",  "Alchemist: BOS ▲ IDM-confirmed — {{ticker}} {{interval}}")
alertcondition(bosDn, "IDM-Confirmed BOS Short", "Alchemist: BOS ▼ IDM-confirmed — {{ticker}} {{interval}}")
alertcondition(rbsTouch, "RBS Retest", "Alchemist: RBS retest (resistance->support) — {{ticker}} {{interval}}")
alertcondition(sbrTouch, "SBR Retest", "Alchemist: SBR retest (support->resistance) — {{ticker}} {{interval}}")
alertcondition(storyOrder1Long or storyOrder1Short, "Fibo Storyline ORDER1", "Alchemist: Fibo Storyline KEY-zone entry — {{ticker}} {{interval}}")
alertcondition(storyOrder2, "Fibo Storyline ORDER2", "Alchemist: Fibo Storyline scale-in (adding wood) — {{ticker}} {{interval}}")
alertcondition(circleRetest, "Fibo Circle KEY Retest", "Alchemist: Fibo Circle KEY extension retest — {{ticker}} {{interval}}")
