// ============================================================
// TC Opening Session — Data-Verified Session Strategy
// Instrument: XAUUSD (Gold) | Timeframe: 5m
//
// TWO STATISTICALLY VERIFIED SETUPS (5.5 years, 1,415 days):
//
//   Setup A — London Close Fade (10:00-10:30 UTC)
//     Condition: London net move 5-10pt in one direction
//     Action:    Fade it at 10:00 open
//     Results:   57.2% WR | 1:1 R:R | +0.72pt expectancy/trade
//
//   Setup B — NY Opening Range Breakout (13:30-15:30 UTC)
//     Condition: London pre-session range (08:00-13:30) ≤ 10pt
//     Action:    Trade first ORB breakout after 13:45
//     Results:   50% WR | 10pt target / 8pt stop | +0.91pt expectancy/trade
//
// WHAT DATA SHOWED DID NOT WORK (tested, removed):
//   - Judas Swing to Asia target: 1-2% WR (no edge)
//   - ORB breakout without filter: 27-31% WR (negative expectancy)
//   - Narrow Asia range filter: no improvement over baseline
//   - Directional bias (bull/bear): 52% (coin flip)
//   - NY following London direction: 52% (coin flip)
// ============================================================
//@version=5
indicator("TC Opening Session", overlay=true, max_lines_count=20,
          max_boxes_count=20, max_labels_count=50)

// ─── INPUTS ──────────────────────────────────────────────────
var string G_SESS = "Session Windows"
i_show_london   = input.bool(true,  "Show London Session Box",  group=G_SESS)
i_show_ny       = input.bool(true,  "Show NY Session Box",      group=G_SESS)
i_show_asia     = input.bool(true,  "Show Asia Session Box",    group=G_SESS)

var string G_LC = "Setup A — London Close Fade"
i_lc_enable     = input.bool(true,  "Enable London Close Fade", group=G_LC)
i_lc_min_move   = input.float(5.0,  "Min London Net Move (pt)", group=G_LC, minval=1.0, step=0.5)
i_lc_max_move   = input.float(12.0, "Max London Net Move (pt)", group=G_LC, minval=1.0, step=0.5)
i_lc_target     = input.float(5.0,  "Target (pt)",              group=G_LC, minval=1.0, step=0.5)
i_lc_stop       = input.float(5.0,  "Stop (pt)",                group=G_LC, minval=1.0, step=0.5)

var string G_NY = "Setup B — NY ORB Breakout"
i_ny_enable     = input.bool(true,  "Enable NY ORB Setup",      group=G_NY)
i_ny_pre_max    = input.float(10.0, "Max London Pre-Range (pt)", group=G_NY, minval=3.0, step=0.5,
                   tooltip="London 08:00-13:30 range must be ≤ this value to qualify. Verified: ≤10pt gives 50% WR.")
i_ny_target     = input.float(10.0, "Target (pt)",              group=G_NY, minval=1.0, step=0.5)
i_ny_stop       = input.float(8.0,  "Stop (pt)",                group=G_NY, minval=1.0, step=0.5)
i_ny_orb_mins   = input.int(15,     "ORB Duration (min)",       group=G_NY, minval=5, maxval=60, step=5)

var string G_ATR = "Risk Filter"
i_atr_filter    = input.bool(true,  "Block signals during news (ATR spike)", group=G_ATR)
i_atr_mult      = input.float(2.5,  "ATR spike multiplier",     group=G_ATR, minval=1.5, step=0.1)

// ─── TIME UTILS ──────────────────────────────────────────────
t_mins = hour(time, "UTC") * 60 + minute(time, "UTC")

in_london_open  = t_mins >= 8*60     and t_mins < 10*60     // 08:00-10:00
in_london_close = t_mins >= 10*60    and t_mins < 10*60+30  // 10:00-10:30
in_ny           = t_mins >= 13*60+30 and t_mins < 15*60+30  // 13:30-15:30
in_ny_orb       = t_mins >= 13*60+30 and t_mins < 13*60+30 + i_ny_orb_mins
in_asia         = t_mins >= 0        and t_mins < 2*60      // 00:00-02:00
in_london_pre   = t_mins >= 8*60     and t_mins < 13*60+30  // 08:00-13:30 (pre-NY)

// ─── ATR SPIKE FILTER ────────────────────────────────────────
atr     = ta.atr(14)
atr_avg = ta.sma(atr, 50)
atr_spike = i_atr_filter and atr > atr_avg * i_atr_mult

// ─── SESSION HIGH/LOW TRACKING ───────────────────────────────

// London session H/L (08:00-10:00)
var float lon_high    = na
var float lon_low     = na
var float lon_open_p  = na
var float lon_net_abs = na
var bool  lon_is_bull = false

if t_mins == 8*60
    lon_high   := high
    lon_low    := low
    lon_open_p := open
if in_london_open
    lon_high := math.max(lon_high, high)
    lon_low  := math.min(lon_low,  low)

// Compute net move at start of 10:00 bar (when close window opens)
if t_mins == 10*60
    lon_net_abs := math.abs(close[1] - lon_open_p)
    lon_is_bull := close[1] > lon_open_p

// London pre-range (08:00-13:30) for NY filter
var float lon_pre_high = na
var float lon_pre_low  = na

if t_mins == 8*60
    lon_pre_high := high
    lon_pre_low  := low
if in_london_pre
    lon_pre_high := math.max(lon_pre_high, high)
    lon_pre_low  := math.min(lon_pre_low,  low)

lon_pre_range = lon_pre_high - lon_pre_low

// NY ORB (first i_ny_orb_mins of NY)
var float ny_orb_high = na
var float ny_orb_low  = na
var bool  ny_orb_done = false

if t_mins == 13*60+30
    ny_orb_high := high
    ny_orb_low  := low
    ny_orb_done := false
if in_ny_orb
    ny_orb_high := math.max(ny_orb_high, high)
    ny_orb_low  := math.min(ny_orb_low,  low)
if t_mins == 13*60+30 + i_ny_orb_mins
    ny_orb_done := true

// Asia session H/L (00:00-02:00) for display only
var float asia_high = na
var float asia_low  = na

if t_mins == 0
    asia_high := high
    asia_low  := low
if in_asia
    asia_high := math.max(asia_high, high)
    asia_low  := math.min(asia_low,  low)

// ─── SETUP A: LONDON CLOSE FADE SIGNALS ──────────────────────
// Fire at the OPEN of the 10:00 bar (first bar of close window)
// Conditions verified: London net 5-12pt, fade direction
var bool  lc_long_active  = false
var bool  lc_short_active = false
var float lc_long_tgt     = na
var float lc_long_stp     = na
var float lc_short_tgt    = na
var float lc_short_stp    = na
var int   lc_fired_bar    = -1000

lc_qualifies = i_lc_enable and
               not na(lon_net_abs) and
               lon_net_abs >= i_lc_min_move and
               lon_net_abs <= i_lc_max_move and
               not atr_spike

// Signal fires exactly at the open of the 10:00 bar
lc_long_sig  = false
lc_short_sig = false

if t_mins == 10*60 and lc_qualifies and bar_index != lc_fired_bar
    if lon_is_bull  // London went up → fade down
        lc_short_sig   := true
        lc_short_active := true
        lc_short_tgt   := open - i_lc_target
        lc_short_stp   := open + i_lc_stop
        lc_fired_bar   := bar_index
    else            // London went down → fade up
        lc_long_sig    := true
        lc_long_active := true
        lc_long_tgt    := open + i_lc_target
        lc_long_stp    := open - i_lc_stop
        lc_fired_bar   := bar_index

// Deactivate LC trades when session ends or TP/SL hit
if lc_long_active
    if high >= lc_long_tgt or low <= lc_long_stp or t_mins >= 10*60+30
        lc_long_active := false
if lc_short_active
    if low <= lc_short_tgt or high >= lc_short_stp or t_mins >= 10*60+30
        lc_short_active := false

// ─── SETUP B: NY ORB BREAKOUT SIGNALS ───────────────────────
// Fire when price breaks ORB high or low after ORB window closes
// Condition: London pre-range (08:00-13:30) ≤ i_ny_pre_max
var bool  ny_long_active  = false
var bool  ny_short_active = false
var float ny_long_tgt     = na
var float ny_long_stp     = na
var float ny_short_tgt    = na
var float ny_short_stp    = na
var bool  ny_long_fired   = false
var bool  ny_short_fired  = false

ny_qualifies = i_ny_enable and
               ny_orb_done and
               not na(lon_pre_range) and
               lon_pre_range <= i_ny_pre_max and
               not atr_spike

if t_mins == 13*60+30
    ny_long_fired  := false
    ny_short_fired := false

ny_long_sig  = false
ny_short_sig = false

if ny_qualifies and in_ny and t_mins > 13*60+30 + i_ny_orb_mins
    if not ny_long_fired and high > ny_orb_high
        ny_long_sig    := true
        ny_long_active := true
        ny_long_tgt    := ny_orb_high + i_ny_target
        ny_long_stp    := ny_orb_high - i_ny_stop
        ny_long_fired  := true
    if not ny_short_fired and low < ny_orb_low
        ny_short_sig    := true
        ny_short_active := true
        ny_short_tgt    := ny_orb_low - i_ny_target
        ny_short_stp    := ny_orb_low + i_ny_stop
        ny_short_fired  := true

// Deactivate NY trades when session ends or TP/SL hit
if ny_long_active
    if high >= ny_long_tgt or low <= ny_long_stp or t_mins >= 15*60+30
        ny_long_active := false
if ny_short_active
    if low <= ny_short_tgt or high >= ny_short_stp or t_mins >= 15*60+30
        ny_short_active := false

// ─── SESSION BACKGROUND COLORS ───────────────────────────────
bgcolor(i_show_london and in_london_open  ? color.new(color.orange, 95) : na, title="London Open")
bgcolor(i_show_london and in_london_close ? color.new(color.purple, 90) : na, title="London Close")
bgcolor(i_show_ny     and in_ny           ? color.new(color.blue,   95) : na, title="NY Session")
bgcolor(i_show_asia   and in_asia         ? color.new(color.teal,   95) : na, title="Asia Session")
bgcolor(atr_spike                         ? color.new(color.red,    90) : na, title="ATR Spike Block")

// ─── SIGNAL LABELS ───────────────────────────────────────────
// Setup A — London Close Fade
if lc_short_sig
    label.new(bar_index, high + atr,
              "LC FADE SHORT\n" + str.tostring(open, "#.##") +
              "\nTP: " + str.tostring(lc_short_tgt, "#.##") +
              "\nSL: " + str.tostring(lc_short_stp, "#.##"),
              style=label.style_label_down, color=color.new(#B71C1C, 0),
              textcolor=color.white, size=size.normal)

if lc_long_sig
    label.new(bar_index, low - atr,
              "LC FADE LONG\n" + str.tostring(open, "#.##") +
              "\nTP: " + str.tostring(lc_long_tgt, "#.##") +
              "\nSL: " + str.tostring(lc_long_stp, "#.##"),
              style=label.style_label_up, color=color.new(#1B5E20, 0),
              textcolor=color.white, size=size.normal)

// Setup B — NY ORB
if ny_long_sig
    label.new(bar_index, low - atr,
              "NY ORB LONG\n" + str.tostring(ny_orb_high, "#.##") +
              "\nTP: " + str.tostring(ny_long_tgt, "#.##") +
              "\nSL: " + str.tostring(ny_long_stp, "#.##"),
              style=label.style_label_up, color=color.new(#0D47A1, 0),
              textcolor=color.white, size=size.normal)

if ny_short_sig
    label.new(bar_index, high + atr,
              "NY ORB SHORT\n" + str.tostring(ny_orb_low, "#.##") +
              "\nTP: " + str.tostring(ny_short_tgt, "#.##") +
              "\nSL: " + str.tostring(ny_short_stp, "#.##"),
              style=label.style_label_down, color=color.new(#E65100, 0),
              textcolor=color.white, size=size.normal)

// ─── TP / SL LINES (active trades) ──────────────────────────
// London Close Fade active lines
plot(lc_long_active  ? lc_long_tgt  : na, "LC Long TP",  color.new(color.green, 30), 1, plot.style_linebr)
plot(lc_long_active  ? lc_long_stp  : na, "LC Long SL",  color.new(color.red,   30), 1, plot.style_linebr)
plot(lc_short_active ? lc_short_tgt : na, "LC Short TP", color.new(color.green, 30), 1, plot.style_linebr)
plot(lc_short_active ? lc_short_stp : na, "LC Short SL", color.new(color.red,   30), 1, plot.style_linebr)

// NY ORB active lines
plot(ny_long_active  ? ny_long_tgt  : na, "NY Long TP",  color.new(#0D47A1, 30), 1, plot.style_linebr)
plot(ny_long_active  ? ny_long_stp  : na, "NY Long SL",  color.new(color.red, 30), 1, plot.style_linebr)
plot(ny_short_active ? ny_short_tgt : na, "NY Short TP", color.new(#0D47A1, 30), 1, plot.style_linebr)
plot(ny_short_active ? ny_short_stp : na, "NY Short SL", color.new(color.red, 30), 1, plot.style_linebr)

// London session high/low reference lines
plot(in_london_open or in_london_close ? lon_high : na, "London High", color.new(color.orange, 40), 1, plot.style_linebr)
plot(in_london_open or in_london_close ? lon_low  : na, "London Low",  color.new(color.orange, 40), 1, plot.style_linebr)

// NY ORB box reference
plot(ny_orb_done and in_ny ? ny_orb_high : na, "NY ORB High", color.new(#0D47A1, 50), 1, plot.style_linebr)
plot(ny_orb_done and in_ny ? ny_orb_low  : na, "NY ORB Low",  color.new(#0D47A1, 50), 1, plot.style_linebr)

// Asia session reference
plot(in_asia ? asia_high : na, "Asia High", color.new(color.teal, 50), 1, plot.style_linebr)
plot(in_asia ? asia_low  : na, "Asia Low",  color.new(color.teal, 50), 1, plot.style_linebr)

// ─── INFO TABLE ──────────────────────────────────────────────
var table info = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 70),
                            border_color=color.gray, border_width=1, frame_width=1)

if barstate.islast
    table.cell(info, 0, 0, "TC Opening Session",    text_color=color.white,  text_size=size.small, bgcolor=color.new(#1B5E20,0))
    table.cell(info, 1, 0, "Verified Stats",        text_color=color.yellow, text_size=size.small, bgcolor=color.new(#1B5E20,0))

    table.cell(info, 0, 1, "Setup A (LC Fade)",     text_color=color.white,  text_size=size.tiny)
    table.cell(info, 1, 1, "57.2% WR | +0.72pt/T", text_color=color.lime,   text_size=size.tiny)

    table.cell(info, 0, 2, "Setup B (NY ORB)",      text_color=color.white,  text_size=size.tiny)
    table.cell(info, 1, 2, "50% WR | +0.91pt/T",   text_color=color.lime,   text_size=size.tiny)

    table.cell(info, 0, 3, "LC Fade Active",        text_color=color.white,  text_size=size.tiny)
    table.cell(info, 1, 3, lc_qualifies and in_london_close ? "YES" : "no",
               text_color=lc_qualifies and in_london_close ? color.lime : color.gray, text_size=size.tiny)

    table.cell(info, 0, 4, "NY ORB Active",         text_color=color.white,  text_size=size.tiny)
    table.cell(info, 1, 4, ny_qualifies and in_ny ? "YES" : "no",
               text_color=ny_qualifies and in_ny ? color.lime : color.gray,  text_size=size.tiny)

    table.cell(info, 0, 5, "London Net",            text_color=color.white,  text_size=size.tiny)
    lc_net_str = not na(lon_net_abs) ? (lon_is_bull ? "+" : "-") + str.tostring(lon_net_abs, "#.#") + "pt" : "—"
    table.cell(info, 1, 5, lc_net_str,
               text_color=not na(lon_net_abs) and lon_net_abs >= i_lc_min_move and lon_net_abs <= i_lc_max_move ? color.lime : color.gray,
               text_size=size.tiny)

    table.cell(info, 0, 6, "Pre-NY Range",          text_color=color.white,  text_size=size.tiny)
    pre_str = not na(lon_pre_range) ? str.tostring(lon_pre_range, "#.#") + "pt" : "—"
    table.cell(info, 1, 6, pre_str,
               text_color=not na(lon_pre_range) and lon_pre_range <= i_ny_pre_max ? color.lime : color.orange,
               text_size=size.tiny)

    table.cell(info, 0, 7, "ATR Spike",             text_color=color.white,  text_size=size.tiny)
    table.cell(info, 1, 7, atr_spike ? "BLOCKED" : "clear",
               text_color=atr_spike ? color.red : color.lime, text_size=size.tiny)

// ─── ALERTS ──────────────────────────────────────────────────
alertcondition(lc_long_sig,   "LC Fade LONG",   "LC Fade LONG — Fade London bearish move | TP: {{plot_0}} SL: {{plot_1}}")
alertcondition(lc_short_sig,  "LC Fade SHORT",  "LC Fade SHORT — Fade London bullish move | TP: {{plot_2}} SL: {{plot_3}}")
alertcondition(ny_long_sig,   "NY ORB LONG",    "NY ORB LONG — Quiet pre-session breakout long | TP: {{plot_4}} SL: {{plot_5}}")
alertcondition(ny_short_sig,  "NY ORB SHORT",   "NY ORB SHORT — Quiet pre-session breakout short | TP: {{plot_6}} SL: {{plot_7}}")
alertcondition(atr_spike,     "ATR Spike",      "TC: ATR spike detected — no new signals")
