// Trendline logic © LuxAlgo — adapted and integrated into Dialectic Engine v4
// Pattern filter © Trade Cartel Research — P1+P2 session bias backtested 2021-2026
//@version=6
indicator("Dialectic Engine v4 — P1+P2 Filtered", shorttitle="DE v4 P1P2", overlay=true)

// ─── INPUTS ─────────────────────────────────────────────────
st_len     = input.int(97,    "ST ATR Period",           group="① Supertrend")
st_mult    = input.float(3.1, "ST Multiplier",           group="① Supertrend", step=0.1)
at_period  = input.int(14,    "AT Period",               group="② AlphaTrend")
at_coeff   = input.float(1.0, "AT Coefficient",          group="② AlphaTrend", step=0.1)
no_vol     = input.bool(false, "No Volume (use RSI)",    group="② AlphaTrend")
ema_bbsr   = input.int(200,   "BBSR EMA Period",         group="③ BBSR")
ema_fast   = input.int(9,     "EMA Fast",                group="④ EMA Stack")
ema_mid    = input.int(21,    "EMA Mid",                 group="④ EMA Stack")
ema_slow   = input.int(50,    "EMA Slow",                group="④ EMA Stack")
rsi_len    = input.int(14,    "RSI Length",              group="⑤ RSI")
rsi_ob     = input.int(60,    "RSI Overbought",          group="⑤ RSI", minval=55, maxval=80)
rsi_os     = input.int(40,    "RSI Oversold",            group="⑤ RSI", minval=20, maxval=45)
macd_f     = input.int(8,     "MACD Fast",               group="⑥ MACD")
macd_s     = input.int(17,    "MACD Slow",               group="⑥ MACD")
macd_sig   = input.int(9,     "MACD Signal",             group="⑥ MACD")
liq_lb     = input.int(20,    "Sweep Lookback",          group="⑦ Sweep", minval=5, maxval=50)
sweep_age  = input.int(5,     "Max Sweep Age (bars)",    group="⑦ Sweep", minval=1, maxval=20)
vol_ma_len = input.int(20,    "Volume MA Length",        group="⑧ Volume")
vol_thresh = input.float(1.1, "Volume Surge Mult",       group="⑧ Volume", step=0.1)
use_vol    = input.bool(false, "Require Volume Surge",   group="⑧ Volume")
min_conf   = input.int(3,     "Min Confluences (Trend)", group="⑨ Engine", minval=1, maxval=5)
use_trend  = input.bool(true, "Enable Trend Engine",     group="⑨ Engine")
use_rev    = input.bool(true, "Enable Reversal Engine",  group="⑨ Engine")
cooldown   = input.int(5,     "Signal Cooldown (bars)",  group="⑨ Engine", minval=1, maxval=30)
c_bull = input.color(color.new(#00FFBB, 0), "Bull",      group="⑪ Colours")
c_bear = input.color(color.new(#FF3D57, 0), "Bear",      group="⑪ Colours")
c_rev  = input.color(color.new(#FFD700, 0), "Reversal",  group="⑪ Colours")

// ─── TRENDLINE BREAK INPUTS ─────────────────────────────────
use_tl_filter = input.bool(true,    "🔀 Require Trendline Break Confirmation", group="⑫ Trendline Filter (LuxAlgo)")
tl_length     = input.int(14,       "Swing Detection Lookback",                group="⑫ Trendline Filter (LuxAlgo)")
tl_mult       = input.float(1.0,    "Slope Multiplier",                        group="⑫ Trendline Filter (LuxAlgo)", step=0.1)
tl_calcMethod = input.string("Atr", "Slope Calculation Method",                group="⑫ Trendline Filter (LuxAlgo)", options=["Atr","Stdev","Linreg"])
tl_backpaint  = input.bool(true,    "Backpaint Trendlines",                    group="⑫ Trendline Filter (LuxAlgo)")
tl_showExt    = input.bool(true,    "Show Extended Trendlines",                group="⑫ Trendline Filter (LuxAlgo)")
tl_upCss      = input.color(color.teal, "Up Trendline Color",                  group="⑫ Trendline Filter (LuxAlgo)")
tl_dnCss      = input.color(color.red,  "Down Trendline Color",                group="⑫ Trendline Filter (LuxAlgo)")

// ─── P1+P2 SESSION FILTER ───────────────────────────────────
// Backtested results (AU200 AUD 5m, 2021-2026, SL=15pts, 1pt commission):
//   P1: TREND BUY  LONG  00-02 UTC  Tue/Wed/Fri → N=126  WR=40.5%  PF=1.60  Net=+971pts
//   P2: TREND SELL SHORT 05-07 UTC  Any day     → N=39   WR=43.6%  PF=1.95  Net=+719pts
//   Combined                                    → N=165  WR=41.2%  PF=2.34  Net=+2020pts
use_p1p2      = input.bool(true,  "Enable P1+P2 Session Filter",  group="⑬ P1+P2 Filter (Backtested)")
show_p1p2_bg  = input.bool(true,  "Highlight Active Windows",     group="⑬ P1+P2 Filter (Backtested)")
sl_pts        = input.float(15.0, "Stop Loss (pts, 0=off)",       group="⑬ P1+P2 Filter (Backtested)", step=1.0)

// ─── VAR DECLARATIONS ────────────────────────────────────────
var float AT   = na
var int   pos  = 0
var int   bsb  = 9999
var int   bss  = 9999
var int   bss2 = 0
var label box  = na
var float entry_price = na

// ─── SUPERTREND ──────────────────────────────────────────────
[st_line, st_dir] = ta.supertrend(st_mult, st_len)
st_bull = st_dir == -1
st_bear = st_dir ==  1

// ─── ALPHATREND ──────────────────────────────────────────────
at_atr   = ta.sma(ta.tr, at_period)
upT      = low  - at_atr * at_coeff
downT    = high + at_atr * at_coeff
mom_bull = no_vol ? ta.rsi(close, at_period) >= 50 : ta.mfi(hlc3, at_period) >= 50
AT := mom_bull ? (upT < nz(AT[1]) ? nz(AT[1]) : upT) : (downT > nz(AT[1]) ? nz(AT[1]) : downT)
at_bull      = AT > AT[2]
at_bear      = AT < AT[2]
at_flip_bull = AT > AT[2] and AT[1] <= AT[3]
at_flip_bear = AT < AT[2] and AT[1] >= AT[3]
at_cont_bull = at_bull and AT[2] > AT[4]
at_cont_bear = at_bear and AT[2] < AT[4]

// ─── BBSR EMA 200 ────────────────────────────────────────────
bbsr       = ta.ema(close, ema_bbsr)
above_bbsr = close > bbsr
below_bbsr = close < bbsr

// ─── EMA STACK ───────────────────────────────────────────────
ef = ta.ema(close, ema_fast)
em = ta.ema(close, ema_mid)
es = ta.ema(close, ema_slow)
bull_stack    = ef > em and em > es
bear_stack    = ef < em and em < es
ema50_rising  = es > es[3]
ema50_falling = es < es[3]
ema9_up       = ef > ef[1] and ef[1] > ef[2]
ema9_down     = ef < ef[1] and ef[1] < ef[2]

// ─── RSI ─────────────────────────────────────────────────────
rsi           = ta.rsi(close, rsi_len)
rsi_bull_zone = rsi > 45 and rsi < 70
rsi_bear_zone = rsi < 55 and rsi > 30
rsi_rev_bull  = rsi < rsi_os and rsi > rsi[1]
rsi_rev_bear  = rsi > rsi_ob and rsi < rsi[1]

// ─── MACD ────────────────────────────────────────────────────
[ml, sl2, mh] = ta.macd(close, macd_f, macd_s, macd_sig)
macd_bull = ml > sl2
macd_bear = ml < sl2

// ─── LIQUIDITY SWEEP ─────────────────────────────────────────
recent_high = ta.highest(high[1], liq_lb)
recent_low  = ta.lowest(low[1],   liq_lb)
sw_bull     = low  < recent_low  and close > recent_low
sw_bear     = high > recent_high and close < recent_high
bsb := sw_bull ? 0 : bsb + 1
bss := sw_bear ? 0 : bss + 1
recent_sw_bull = bsb <= sweep_age
recent_sw_bear = bss <= sweep_age

// ─── VOLUME ──────────────────────────────────────────────────
vol_ma    = ta.sma(volume, vol_ma_len)
vol_surge = volume > vol_ma * vol_thresh
vol_ok    = not use_vol or vol_surge

// ─── COOLDOWN ────────────────────────────────────────────────
bss2   := bss2 + 1
cooled  = bss2 > cooldown

// ─── P1+P2 SESSION LOGIC ─────────────────────────────────────
// UTC hour extracted from bar time
bar_hour = hour(time, "UTC")
bar_dow  = dayofweek(time)  // 1=Sun 2=Mon 3=Tue 4=Wed 5=Thu 6=Fri 7=Sat

// P1: TREND BUY window — 00:00-02:59 UTC, Tue/Wed/Fri
p1_hour = bar_hour >= 0 and bar_hour <= 2
p1_day  = bar_dow == dayofweek.tuesday or bar_dow == dayofweek.wednesday or bar_dow == dayofweek.friday
p1_window = p1_hour and p1_day

// P2: TREND SELL window — 05:00-07:59 UTC, any day
p2_window = bar_hour >= 5 and bar_hour <= 7

// session gate per signal direction
p1p2_buy_ok  = not use_p1p2 or p1_window
p1p2_sell_ok = not use_p1p2 or p2_window

// ─── TRENDLINE BREAK LOGIC ───────────────────────────────────
var float tl_upper    = 0.
var float tl_lower    = 0.
var float tl_slope_ph = 0.
var float tl_slope_pl = 0.

tl_offset = tl_backpaint ? tl_length : 0
tl_n      = bar_index

tl_ph = ta.pivothigh(tl_length, tl_length)
tl_pl = ta.pivotlow(tl_length,  tl_length)

tl_slope = switch tl_calcMethod
    "Atr"    => ta.atr(tl_length) / tl_length * tl_mult
    "Stdev"  => ta.stdev(close, tl_length) / tl_length * tl_mult
    "Linreg" => math.abs(ta.sma(close * tl_n, tl_length) - ta.sma(close, tl_length) * ta.sma(tl_n, tl_length)) / ta.variance(tl_n, tl_length) / 2 * tl_mult

tl_slope_ph := not na(tl_ph) ? tl_slope      : tl_slope_ph
tl_slope_pl := not na(tl_pl) ? tl_slope      : tl_slope_pl
tl_upper    := not na(tl_ph) ? tl_ph         : tl_upper - tl_slope_ph
tl_lower    := not na(tl_pl) ? tl_pl         : tl_lower + tl_slope_pl

var int tl_upos = 0
var int tl_dnos = 0
tl_upos := not na(tl_ph) ? 0 : close > tl_upper - tl_slope_ph * tl_length ? 1 : tl_upos
tl_dnos := not na(tl_pl) ? 0 : close < tl_lower + tl_slope_pl * tl_length ? 1 : tl_dnos

tl_bull_break  = tl_upos > tl_upos[1]
tl_bear_break  = tl_dnos > tl_dnos[1]
tl_bull_active = tl_upos == 1
tl_bear_active = tl_dnos == 1
tl_buy_ok      = not use_tl_filter or tl_bull_active
tl_sell_ok     = not use_tl_filter or tl_bear_active

// ─── TREND ENGINE ────────────────────────────────────────────
t_sell_score    = (st_bear ? 1 : 0) + (at_cont_bear ? 1 : 0) + (below_bbsr ? 1 : 0) + (rsi_bear_zone ? 1 : 0) + (macd_bear ? 1 : 0)
t_buy_score     = (st_bull ? 1 : 0) + (at_cont_bull ? 1 : 0) + (above_bbsr ? 1 : 0) + (rsi_bull_zone ? 1 : 0) + (macd_bull ? 1 : 0)
trend_sell_gate = st_bear and below_bbsr and ema50_falling
trend_buy_gate  = st_bull and above_bbsr and ema50_rising
t_sell_raw      = use_trend and trend_sell_gate and t_sell_score >= min_conf and vol_ok and cooled
t_buy_raw       = use_trend and trend_buy_gate  and t_buy_score  >= min_conf and vol_ok and cooled

// ─── REVERSAL ENGINE ─────────────────────────────────────────
rev_sell_raw = use_rev and recent_sw_bear and at_flip_bear and rsi_rev_bear and ema9_down and cooled
rev_buy_raw  = use_rev and recent_sw_bull and at_flip_bull and rsi_rev_bull and ema9_up   and cooled

// ─── FLIP LOGIC WITH P1+P2 GATE ──────────────────────────────
int cur_pos = nz(pos, 0)

any_sell    = (t_sell_raw or rev_sell_raw) and cur_pos != -1 and tl_sell_ok and p1p2_sell_ok
any_buy     = (t_buy_raw  or rev_buy_raw)  and cur_pos !=  1 and tl_buy_ok  and p1p2_buy_ok
is_rev_sell = rev_sell_raw and not t_sell_raw
is_rev_buy  = rev_buy_raw  and not t_buy_raw
exit_long   = any_sell and cur_pos ==  1
exit_short  = any_buy  and cur_pos == -1

// ─── STOP LOSS LOGIC ─────────────────────────────────────────
use_sl    = sl_pts > 0
sl_long   = use_sl and cur_pos ==  1 and not na(entry_price) and low  <= entry_price - sl_pts
sl_short  = use_sl and cur_pos == -1 and not na(entry_price) and high >= entry_price + sl_pts
sl_hit    = sl_long or sl_short

if sl_hit and not any_buy and not any_sell
    pos         := 0
    entry_price := na
    bss2        := 0

if any_sell
    pos         := -1
    bss2        := 0
    entry_price := close

if any_buy
    pos         := 1
    bss2        := 0
    entry_price := close

// ─── SESSION BACKGROUND ──────────────────────────────────────
bgcolor(show_p1p2_bg and p1_window ? color.new(#00FFBB, 94) : na, title="P1 Window (BUY)")
bgcolor(show_p1p2_bg and p2_window ? color.new(#FF3D57, 94) : na, title="P2 Window (SELL)")

// ─── TRENDLINE PLOTS ─────────────────────────────────────────
var line uptl = line.new(na, na, na, na, color=tl_upCss, style=line.style_dashed, extend=extend.right)
var line dntl = line.new(na, na, na, na, color=tl_dnCss, style=line.style_dashed, extend=extend.right)

if not na(tl_ph) and tl_showExt and use_tl_filter
    uptl.set_xy1(tl_n - tl_offset, tl_backpaint ? tl_ph : tl_upper - tl_slope_ph * tl_length)
    uptl.set_xy2(tl_n - tl_offset + 1, tl_backpaint ? tl_ph - tl_slope : tl_upper - tl_slope_ph * (tl_length + 1))

if not na(tl_pl) and tl_showExt and use_tl_filter
    dntl.set_xy1(tl_n - tl_offset, tl_backpaint ? tl_pl : tl_lower + tl_slope_pl * tl_length)
    dntl.set_xy2(tl_n - tl_offset + 1, tl_backpaint ? tl_pl + tl_slope : tl_lower + tl_slope_pl * (tl_length + 1))

plot(use_tl_filter ? (tl_backpaint ? tl_upper : tl_upper - tl_slope_ph * tl_length) : na, "TL Upper", color=not na(tl_ph) ? na : tl_upCss, offset=-tl_offset)
plot(use_tl_filter ? (tl_backpaint ? tl_lower : tl_lower + tl_slope_pl * tl_length) : na, "TL Lower", color=not na(tl_pl) ? na : tl_dnCss, offset=-tl_offset)

// ─── DE PLOTS ────────────────────────────────────────────────
plot(st_line, "SuperTrend", color=st_bull ? color.new(c_bull, 20) : color.new(c_bear, 20), linewidth=2)
k1 = plot(AT,    "AT",    color=color.new(#0022FC, 0), linewidth=2)
k2 = plot(AT[2], "AT[2]", color=color.new(#FC0400, 0), linewidth=2)
fill(k1, k2, color=at_bull ? color.new(#00E60F, 80) : color.new(#80000B, 80))
plot(bbsr, "BBSR EMA", color=color.new(#4FC3F7, 40), linewidth=2)
plot(ef,   "EMA 9",    color=color.new(color.yellow, 60), linewidth=1)
plot(em,   "EMA 21",   color=color.new(color.orange, 60), linewidth=1)
plot(es,   "EMA 50",   color=color.new(color.red,    60), linewidth=1)

// SL lines
plot(use_sl and cur_pos ==  1 and not na(entry_price) ? entry_price - sl_pts : na,
     "SL Long",  color=color.new(#FF3D57, 0), linewidth=1, style=plot.style_linebr)
plot(use_sl and cur_pos == -1 and not na(entry_price) ? entry_price + sl_pts : na,
     "SL Short", color=color.new(#FF3D57, 0), linewidth=1, style=plot.style_linebr)

plotshape(sw_bull, title="Sweep Low",  style=shape.triangleup,   location=location.belowbar, color=color.new(c_bull, 40), size=size.tiny)
plotshape(sw_bear, title="Sweep High", style=shape.triangledown, location=location.abovebar, color=color.new(c_bear, 40), size=size.tiny)

plotshape(any_buy  and not is_rev_buy,  title="BUY Trend",     style=shape.labelup,   location=location.belowbar, color=c_bull, textcolor=color.black, text="BUY",    size=size.normal)
plotshape(any_buy  and is_rev_buy,      title="BUY Reversal",  style=shape.labelup,   location=location.belowbar, color=c_rev,  textcolor=color.black, text="R.BUY",  size=size.normal)
plotshape(any_sell and not is_rev_sell, title="SELL Trend",    style=shape.labeldown, location=location.abovebar, color=c_bear, textcolor=color.white, text="SELL",   size=size.normal)
plotshape(any_sell and is_rev_sell,     title="SELL Reversal", style=shape.labeldown, location=location.abovebar, color=c_rev,  textcolor=color.white, text="R.SELL", size=size.normal)

plotshape(sl_hit,     title="SL Hit",     style=shape.xcross, location=location.absolute,
          color=color.new(#FF3D57, 0), size=size.small,
          yloc= cur_pos==1 ? yloc.belowbar : yloc.abovebar)
plotshape(exit_long,  title="Exit Long",  style=shape.xcross, location=location.abovebar, color=color.new(c_bear, 20), size=size.small)
plotshape(exit_short, title="Exit Short", style=shape.xcross, location=location.belowbar, color=color.new(c_bull, 20), size=size.small)

barcolor(cur_pos == 1 ? color.new(c_bull, 65) : cur_pos == -1 ? color.new(c_bear, 65) : na)

// ─── STATUS BOX ──────────────────────────────────────────────
label.delete(box[1])

pos_txt  = cur_pos == 1 ? "▲ LONG" : cur_pos == -1 ? "▼ SHORT" : "— FLAT"
sig_txt  = any_buy and is_rev_buy ? "R.BUY" : any_buy ? "BUY" : any_sell and is_rev_sell ? "R.SELL" : any_sell ? "SELL" : sl_hit ? "SL HIT" : "—"
sess_txt = p1_window ? "P1 BUY ✓" : p2_window ? "P2 SELL ✓" : "OUT"
sl_txt   = use_sl and not na(entry_price) ? str.tostring(math.round(entry_price - sl_pts * cur_pos, 1)) : "—"

var color bg = na
if any_buy and is_rev_buy
    bg := c_rev
else if any_buy
    bg := c_bull
else if any_sell and is_rev_sell
    bg := c_rev
else if any_sell
    bg := c_bear
else if sl_hit
    bg := color.new(#FF3D57, 40)
else if cur_pos == 1
    bg := color.new(c_bull, 70)
else if cur_pos == -1
    bg := color.new(c_bear, 70)
else
    bg := color.new(#0A0A14, 10)

info = pos_txt + "  " + sig_txt + "\n" +
     "ST:" + (st_bull ? "▲" : "▼") + " AT:" + (at_bull ? "▲" : "▼") + " BB:" + (above_bbsr ? "▲" : "▼") + "\n" +
     "E50:" + (ema50_rising ? "▲" : ema50_falling ? "▼" : "~") + " MACD:" + (macd_bull ? "▲" : "▼") + "\n" +
     "RSI:" + str.tostring(math.round(rsi, 0)) + "\n" +
     "SESS:" + sess_txt + "\n" +
     "SL @ " + sl_txt + "\n" +
     "B:" + str.tostring(t_buy_score) + " S:" + str.tostring(t_sell_score)

box := label.new(bar_index, high, text=info, style=label.style_label_lower_left,
                 color=bg, textcolor=color.white, size=size.small, textalign=text.align_left)

// ─── ALERTS ──────────────────────────────────────────────────
alertcondition(any_buy  and p1_window, "P1 BUY Signal",  "P1 TREND BUY fired. {{ticker}} {{interval}} — 00-02 UTC window")
alertcondition(any_sell and p2_window, "P2 SELL Signal", "P2 TREND SELL fired. {{ticker}} {{interval}} — 05-07 UTC window")
alertcondition(sl_hit,                 "SL Hit",          "Stop Loss hit. {{ticker}} {{interval}}")
alertcondition(any_buy or any_sell,    "Any Signal",      "DE v4 P1P2 signal. {{ticker}} {{interval}}")
