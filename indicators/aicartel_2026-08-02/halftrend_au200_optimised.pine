// AUTO-GENERATED by au200_optimizer.py
// Instrument : OANDA:AU200AUD  |  Timeframe: 5m
// Best params: amplitude=3, channelDeviation=1, emaFast=5, emaSlow=50, confirmWindow=5
// pct_confirmed=73.65%  total_signals=2476
//   buys=1303 (74.41%)  sells=1173 (72.81%)
//@version=6
indicator("HalfTrend AU200 Optimised [Kush]", shorttitle="HT·AU200", overlay=true,
     max_bars_back=500, max_labels_count=500)

// ── Inputs ────────────────────────────────────────────────────────────────────
htAmp   = input.int(3,   "HT Amplitude",          minval=1, maxval=10,  group="HalfTrend")
htDev   = input.float(1.0,"HT Channel Deviation",  minval=0.5, maxval=10.0, step=0.5, group="HalfTrend")
emaFast = input.int(5,    "EMA Fast",               minval=3, maxval=50,  group="EMAs")
emaSlow = input.int(50,   "EMA Slow",               minval=10, maxval=300, group="EMAs")
confWin = input.int(5,    "Confirm Window (bars)",  minval=1, maxval=10,  group="Confirmation")

// ── Daily reference ────────────────────────────────────────────────────────────
dOpen  = request.security("OANDA:AU200AUD", "D", open,     lookahead=barmerge.lookahead_off)
dPrevC = request.security("OANDA:AU200AUD", "D", close[1], lookahead=barmerge.lookahead_off)

// ── EMAs ───────────────────────────────────────────────────────────────────────
ef_line = ta.ema(close, emaFast)
es_line = ta.ema(close, emaSlow)

// ── HalfTrend ──────────────────────────────────────────────────────────────────
atr2   = ta.atr(100) / 2
dev_v  = htDev * atr2
highma = ta.sma(ta.highest(high, htAmp), htAmp)
lowma  = ta.sma(ta.lowest(low,  htAmp), htAmp)

var int   trend        = 0
var int   nextTrend    = 0
var float maxLowPrice  = low
var float minHighPrice = high
var float htUp         = 0.0
var float htDown       = 0.0

if nextTrend == 1
    maxLowPrice := math.max(low, maxLowPrice)
    if highma < maxLowPrice and close < nz(low[1], low)
        trend        := 1
        nextTrend    := 0
        htDown       := maxLowPrice
        minHighPrice := high
else
    minHighPrice := math.min(high, minHighPrice)
    if lowma > minHighPrice and close > nz(high[1], high)
        trend       := 0
        nextTrend   := 1
        htUp        := minHighPrice
        maxLowPrice := low

if trend == 0
    if nz(trend[1]) != 0
        htUp := nz(htDown[1], htDown)
    if htUp < nz(htUp[1], htUp)
        htUp := nz(htUp[1], htUp)
else
    if nz(trend[1]) != 1
        htDown := nz(htUp[1], htUp)
    if htDown > nz(htDown[1], htDown)
        htDown := nz(htDown[1], htDown)

htLine   = trend == 0 ? htUp : htDown
htBull   = trend == 0
htFlipBuy  = htBull  and not htBull[1]
htFlipSell = not htBull and  htBull[1]

// ── Pending signal state (all 4 filters checked at flip bar) ──────────────────
var int   pendBuyBar   = na
var float pendBuyClose = na
var float pendBuyY     = na

var int   pendSelBar   = na
var float pendSelClose = na
var float pendSelY     = na

if htFlipBuy
    if close > ef_line and close > es_line and close > dOpen and close > dPrevC
        pendBuyBar   := bar_index
        pendBuyClose := close
        pendBuyY     := low

if htFlipSell
    if close < ef_line and close < es_line and close < dOpen and close < dPrevC
        pendSelBar   := bar_index
        pendSelClose := close
        pendSelY     := high

// ── Confirmation check ────────────────────────────────────────────────────────
buyFired  = false
sellFired = false

if not na(pendBuyBar)
    elapsed = bar_index - pendBuyBar
    if elapsed > 0 and elapsed <= confWin
        if close > pendBuyClose
            buyFired := true
    if elapsed > confWin
        pendBuyBar := na

if not na(pendSelBar)
    elapsed = bar_index - pendSelBar
    if elapsed > 0 and elapsed <= confWin
        if close < pendSelClose
            sellFired := true
    if elapsed > confWin
        pendSelBar := na

// Draw label on flip candle (non-repainting — drawn only after confirmation)
if buyFired
    label.new(pendBuyBar, pendBuyY, "BUY ▲",
              xloc=xloc.bar_index, yloc=yloc.price,
              style=label.style_label_up,
              color=color.new(#1565C0, 0), textcolor=color.white, size=size.small)
    pendBuyBar := na

if sellFired
    label.new(pendSelBar, pendSelY, "SELL ▼",
              xloc=xloc.bar_index, yloc=yloc.price,
              style=label.style_label_down,
              color=color.new(#B71C1C, 0), textcolor=color.white, size=size.small)
    pendSelBar := na

// ── Candle highlight ───────────────────────────────────────────────────────────
barcolor(buyFired  ? color.new(#1565C0, 60) :
         sellFired ? color.new(#B71C1C, 60) : na)

// ── Plots ──────────────────────────────────────────────────────────────────────
plot(htLine, "HalfTrend",
     color=htBull ? color.new(#1565C0, 0) : color.new(#B71C1C, 0), linewidth=2)
plot(ef_line, "EMA " + str.tostring(emaFast),
     color=color.new(color.aqua,   40), linewidth=1)
plot(es_line, "EMA " + str.tostring(emaSlow),
     color=color.new(color.orange, 40), linewidth=1)
plot(dOpen,  "Daily Open",
     color=color.new(color.yellow, 30), linewidth=1, style=plot.style_stepline)
plot(dPrevC, "Prev Day Close",
     color=color.new(color.gray,   40), linewidth=1, style=plot.style_stepline)

// ── Alerts ─────────────────────────────────────────────────────────────────────
alertcondition(buyFired,  "AU200 HT BUY",  "HalfTrend BUY confirmed — AU200AUD 5m")
alertcondition(sellFired, "AU200 HT SELL", "HalfTrend SELL confirmed — AU200AUD 5m")
